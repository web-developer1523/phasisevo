{% comment %} --- BUTTON 1 LOGIC (Standard & First Button) --- {% endcomment %}
{%- if btn_label != blank -%}
  <a
    {% if btn_id != blank %}
      href="#{{ btn_id }}"
    {%- elsif btn_link != blank -%}
      href="{{ btn_link }}"
    {% else %}
      href="javascript:void(0)"
    {% endif %}

    class="button button--{{ btn_style | default: 'primary' }} {{ add_classes }} {% if button_dot %}dot_active{% endif %} btn-p"
    aria-label="{{ btn_label | escape }}"
  >
    <span>{{ btn_label | escape }}</span>
  </a>
{%- endif -%}

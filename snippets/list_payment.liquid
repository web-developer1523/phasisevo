{% comment %} {% assign enabled_payment_types = shop.enabled_payment_types %}
{%- if enabled_payment_types.size > 0 -%}
    <div class='product_payment' {{ block.shopify_attributes }}>
        <span class="payment_title">Pay With:</span>
        <ul class='list list-payment' role='list'>
            {%- for type in shop.enabled_payment_types -%}
                <li class='list-payment__item'>
                    {{
                        type
                        | payment_type_svg_tag:
                            class: 'icon icon--full-color'
                    }}
                </li>
            {%- endfor -%}
        </ul>
    </div>
{%- endif -%} {% endcomment %}


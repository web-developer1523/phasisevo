<div class="trust-bar {{ section.settings.custom_css_Class }}">
  {% for block in section.blocks %}
    {% if block.type == 'trust_item' %}
      
      <div class="tb">

        {% if block.settings.icon_svg != blank %}
          <span class="tb-icon">
            {{ block.settings.icon_svg }}
          </span>
            {% elsif block.settings.icon_image != blank %}
    <span class="tb-icon">
      <img 
        src="{{ block.settings.icon_image | image_url: width: 40 }}" 
        alt="icon" 
        width="20" 
        height="20"
        loading="lazy"
      >
    </span>
        {% endif %}

        <span class="tb-text">
          {{ block.settings.text }}
        </span>

      </div>

    {% endif %}
  {% endfor %}
</div>

{% comment %} <style>
.trust-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0f1115;
  border-top: 1px solid rgba(255,255,255,0.08);
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.tb {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 14px 28px;
  color: #cfd6df;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  position: relative;
}

/* vertical divider lines */
.tb:not(:last-child)::after {
  content: "";
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1px;
  background: rgba(255,255,255,0.08);
}

.tb-icon svg {
  width: 14px;
  height: 14px;
  stroke: #ff4d2d; /* orange/red accent */
}

/* MOBILE FIX */
@media (max-width: 768px) {
  .trust-bar {
    flex-wrap: wrap;
  }

  .tb {
    width: 50%;
    justify-content: center;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .tb::after {
    display: none;
  }
}
</style> {% endcomment %}


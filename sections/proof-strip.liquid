<section class="proof-strip {{ section.settings.custom_css_class }}">
  <div class="proof-strip-inner">

    <!-- SCORE -->
    <div class="proof-score">
      <div class="score-big">
        {{ section.settings.score }}
      </div>

      <div class="score-stars">
        {{ section.settings.stars }}
      </div>

      <div class="score-label">
        {{ section.settings.review_label }}
      </div>
    </div>

    <!-- REVIEWS -->
    <div class="proof-reviews">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}

          <div class="pr-card">

            <div class="stars">
              {{ block.settings.stars }}
            </div>

            <blockquote>
              {{ block.settings.quote }}
            </blockquote>

            <div class="pr-name">
              {{ block.settings.name }}
            </div>

            <div class="pr-meta">
              {{ block.settings.meta }}
            </div>

            {% if block.settings.show_verified %}
              <div class="pr-verified">
                {{ block.settings.verified_text }}
              </div>
            {% endif %}

          </div>

        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% comment %} <style>
.proof-strip {
  padding: 60px 0;
  background: #0f1115;
}

.proof-strip-inner {
  display: flex;
  gap: 40px;
  align-items: flex-start;
}

.proof-score {
  min-width: 160px;
}

.score-big {
  font-size: 42px;
  font-weight: 700;
}

.score-stars {
  margin: 6px 0;
  color: #ff4d2d;
}

.score-label {
  font-size: 12px;
  color: #aaa;
}

.proof-reviews {
  display: flex;
  gap: 20px;
  flex: 1;
}

.pr-card {
  background: #15181d;
  padding: 20px;
  border-radius: 8px;
  max-width: 300px;
}

.pr-card .stars {
  color: #ff4d2d;
  margin-bottom: 10px;
}

.pr-card blockquote {
  font-size: 13px;
  line-height: 1.5;
  margin-bottom: 12px;
}

.pr-name {
  font-weight: 600;
}

.pr-meta {
  font-size: 11px;
  color: #aaa;
}

.pr-verified {
  font-size: 10px;
  color: #00c853;
  margin-top: 6px;
}

/* MOBILE */
@media (max-width: 768px) {
  .proof-strip-inner {
    flex-direction: column;
  }

  .proof-reviews {
    flex-direction: column;
  }

  .pr-card {
    max-width: 100%;
  }
}
</style> {% endcomment %}

{% schema %}
{
  "name": "Proof Strip",
  "settings": [
    {
      "type": "text",
      "id": "custom_css_class",
      "label": "Custom Class Css"
    },
    {
      "type": "text",
      "id": "score",
      "label": "Score",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "stars",
      "label": "Stars",
      "default": "★★★★★"
    },
    {
      "type": "text",
      "id": "review_label",
      "label": "Review Label",
      "default": "8 verified reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "stars",
          "label": "Stars",
          "default": "★★★★★"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Text",
          "default": "This is the only thing that actually works."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "John D."
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta",
          "default": "Max Relief · Verified Buyer"
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "label": "Show Verified Badge",
          "default": true
        },
        {
          "type": "text",
          "id": "verified_text",
          "label": "Verified Text",
          "default": "Verified purchase"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Proof Strip",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
<section class="manifesto-sec section {{ section.settings.custom_css_class }}">
  <div class="manifesto-inner">

    <div class="manifesto-eyebrow-row">
      <span>{{ section.settings.eyebrow }}</span>
    </div>

    <h2>
      {{ section.settings.heading_line1 }}<br>
      <em>{{ section.settings.heading_em }}</em>
    </h2>

    <div class="manifesto-body mt-4">

      {% comment %} {% for block in section.blocks %}
        {% if block.type == 'paragraph' %}
          <p class="mb-p">
            {{ block.settings.text }}
          </p>
        {% endif %}
      {% endfor %}

      <div class="pull-quote">
        <div class="pq-text">
          {{ section.settings.pull_quote }}
        </div>
      </div> {% endcomment %}
      {% for block in section.blocks %}
  {% if block.type == 'paragraph' %}
    <p class="mb-p">{{ block.settings.text }}</p>

    {% if forloop.index == 1 and section.settings.pull_quote != blank %}
      <div class="pull-quote">
        <div class="pq-text">{{ section.settings.pull_quote }}</div>
      </div>
    {% endif %}

  {% endif %}
{% endfor %}
    </div>

  </div>
</section>
<style>
  /* ── MANIFESTO ───────────────────────────────────── */
.manifesto-sec{background:var(--page-bg);border-top:1px solid var(--border)}
.manifesto-inner{max-width:760px}
.manifesto-eyebrow-row{display:flex;align-items:center;gap:10px;margin-bottom:20px}
.manifesto-eyebrow-row::before{content:'';width:20px;height:2px;background:#DC2626;flex-shrink:0}
.manifesto-eyebrow-row span{font-family:var(--f-mark);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:#DC2626}
.manifesto-sec h2{margin-bottom:20px}
.manifesto-body{display:flex;flex-direction:column;gap:16px}
.manifesto-body p{font-size:16px;font-weight:300;color:#d0d0d0;line-height:1.8}
.manifesto-body p strong{color:var(--off-white);font-weight:600}
.manifesto-body p em{color:#DC2626;font-style:normal;font-weight:600}
.manifesto-body p em strong {
    color: inherit;
}

/* Pull quote */
.pull-quote{border-left:4px solid #DC2626;padding:16px 20px;background:rgba(232,72,42,.04);border-radius:4px;margin:8px 0}
.pq-text{font-family:var(--f-dis);font-size:clamp(15px,2.5vw,20px);font-weight:700;line-height:1.35;letter-spacing:-0.01em}
.pq-text em{color:#DC2626;font-style:normal}







.manifesto-sec h2 {
    font-family: var(--f-dis);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-top: 0;
}

@media (min-width: 768px) {
  .manifesto-sec h2{
      font-size: 36px;
  }
}

@media (min-width: 1024px) {
    .manifesto-sec h2 {
        font-size: 44px;
    }
}

.section {
    padding: 48px var(--pad);
}

@media (min-width: 768px) {
    .section {
        padding: 64px var(--pad-md);
    }
}

@media (min-width: 1024px) {
    .section {
        padding: 80px var(--pad-lg);
    }
}

</style>
{% schema %}
{
  "name": "Manifesto Section",
  "settings": [
     {
      "type": "text",
      "id": "custom_css_class",
      "label": "Custom CSS Class"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "The PHASIS Manifesto"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "We Refuse to Make"
    },
    {
      "type": "text",
      "id": "heading_em",
      "label": "Heading Emphasis",
      "default": "Products That Underperform."
    },
    {
      "type": "textarea",
      "id": "pull_quote",
      "label": "Pull Quote",
      "default": "PHASIS starts with the <em>science</em> — the peer-reviewed research, the mechanism, the dose that actually produced results. Then we build backwards to a product that delivers it."
    }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Paragraph Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manifesto Section",
     "blocks": [
  {
    "type": "paragraph",
    "settings": {
      "text": "<p>Most supplement brands start with a margin target and work backwards to the formula. They find the cheapest version of an ingredient that lets them print a claim on the label. They dress it up in aggressive branding. They spend more on the ad than the product inside the bottle.</p>"
    }
  },
  {
    "type": "paragraph",
    "settings": {
      "text": "<p>That's why Max Relief has <strong>pharmaceutical-grade Lidocaine HCl</strong> — not just menthol. That's why Electro+ has <strong>50+ trace minerals with zero sugar</strong> — not a powder packet with 34g of sugar and three electrolytes. That's why Perform+ delivers <strong>250mg of verified ecdysterone</strong> per capsule — 25% above the dose used in the WADA-funded study that made researchers recommend banning it.</p>"
    }
  },
  {
    "type": "paragraph",
    "settings": {
      "text": "<p>We don't make products for everyone. We make them for people who train hard, think critically about what goes in their body, and are <em>done being sold things that don't actually work.</em></p>"
    }
  }
]
    }
  ]
}
{% endschema %}
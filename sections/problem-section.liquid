<section class="problem-sec section {{ section.settings.custom_css_class }}">

  <div class="ps-eyebrow-row">
    <span>{{ section.settings.eyebrow }}</span>
  </div>

  <h2>
    {{ section.settings.heading_line1 }}<br>
    <em>{{ section.settings.heading_em }}</em>
  </h2>

  <p class="ps-intro mt-4">
    {{ section.settings.intro }}
  </p>

  <div class="problems-list">
    {% for block in section.blocks %}
      <div class="prob-item">
        <div class="pi-icon">{{ block.settings.icon }}</div>
        <div>
          <h3 class="pi-title">{{ block.settings.title }}</h3>
          <div class="pi-desc">{{ block.settings.desc }}</div>
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="resolution">
    <span class="res-label">{{ section.settings.res_label }}</span>
    <div class="res-text">
      {{ section.settings.res_text }}
    </div>
  </div>

</section>
<style>
  /* ── THE PROBLEM WE SOLVE ────────────────────────── */

.problem-sec{background:var(--surface);border-top:1px solid var(--border)}
.ps-eyebrow-row{display:flex;align-items:center;gap:10px;margin-bottom:16px}
.ps-eyebrow-row::before{content:'';width:20px;height:2px;background:var(--coral);flex-shrink:0}
.ps-eyebrow-row span{font-family:var(--f-mark);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--coral)}
.problem-sec h2{margin-bottom:14px}
.problem-sec h2 em{color:var(--coral);font-style:normal}
.problem-sec p{font-size:15px;font-weight:300;color:#d0d0d0;line-height:1.75;margin-bottom:24px; margin-top:14px}
.problem-sec p strong{color:var(--off-white);font-weight:600}

.problems-list{display:flex;flex-direction:column;gap:10px;margin-bottom:24px}
.prob-item{display:flex;align-items:flex-start;gap:14px;padding:16px;background:var(--page-bg);border:1px solid var(--border);border-radius:6px}
.pi-icon{font-size:22px;flex-shrink:0;margin-top:1px}
.pi-title{font-family:var(--f-dis);font-size:16px;font-weight:700;margin-bottom:4px}
.pi-desc{font-size:15px;color:var(--muted);line-height:1.55}

.resolution{background:rgba(232,72,42,.06);border:1px solid rgba(232,72,42,.2);border-radius:8px;padding:20px 16px}
.res-label{font-family:var(--f-body);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--coral);margin-bottom:12px;display:block}
.res-text{font-family:var(--f-dis);font-size:clamp(14px,2.5vw,18px);font-weight:700;line-height:1.35;letter-spacing:-0.01em}
.res-text em{color:var(--coral);font-style:normal}
.res-text p {
    font: inherit;
    color: inherit;
    margin:0;
}
.res-text em strong {
    color: inherit;
}
.problem-sec p.ps-intro.mt-4 {
    display: none;
}

.problem-sec h2 {
    font-family: var(--f-dis);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.02em;
    line-height: 1.05;
}

@media (min-width: 768px) {
    .problem-sec h2 {
        font-size: 36px;
    }
}

@media (min-width: 1024px) {
    .problem-sec h2 {
        font-size: 44px;
    }
}
</style>
{% schema %}
{
  "name": "Problem Section",
  "settings": [
   {
      "type": "text",
      "id": "custom_css_class",
      "label": "Custom CSS Class"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why PHASIS Exists"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "The Industry Has"
    },
    {
      "type": "text",
      "id": "heading_em",
      "label": "Heading Emphasis",
      "default": "Four Serious Problems."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro Text",
      "default": "<p>The supplement industry is worth over $150 billion globally. Most of it is <strong>underdosed, mislabeled, or built around ingredients that have no clinical support.</strong> We built PHASIS to be the exception to each of these.</p>"
    },
    {
      "type": "text",
      "id": "res_label",
      "label": "Resolution Label",
      "default": "The PHASIS Response"
    },
    {
      "type": "richtext",
      "id": "res_text",
      "label": "Resolution Text",
      "default": "<p>Every product we make is <em>third-party tested, clinically informed, transparently labeled, and fairly priced.</em> That's the baseline. Not a differentiator — the minimum standard.</p>"
    }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji or text)",
          "default": "⚗️"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Underdosing"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Independent testing found many supplements contain far less than claimed on the label."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problem Section",
      "blocks": [
        {
          "type": "problem",
          "settings": {
            "icon": "⚗️",
            "title": "Underdosing",
            "desc": "Independent testing found many ecdysterone supplements contain less than 0.1% of the dose claimed on the label. This isn't rare — it's the norm across most supplement categories."
          }
        },
        {
          "type": "problem",
          "settings": {
            "icon": "🧪",
            "title": "No Third-Party Testing",
            "desc": "Most brands test nothing. They trust their supplier's certificate and print whatever the COA says on the label. We test every batch independently — with results available to every customer."
          }
        },
        {
          "type": "problem",
          "settings": {
            "icon": "📊",
            "title": "Junk Science",
            "desc": "Ingredients go viral on social media. Brands rush to put them in products before the research is established. We only formulate around peer-reviewed, human clinical research — not trends."
          }
        },
        {
          "type": "problem",
          "settings": {
            "icon": "💰",
            "title": "Price Gouging",
            "desc": "Brands overcharge for basic formulations. Quality doesn't have to mean expensive — it means honest."
          }
        }
      ]
    }
  ]
}
{% endschema %}
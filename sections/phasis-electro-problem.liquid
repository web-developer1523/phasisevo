        { "type": "approach_point", "settings": { "text": "<b>Liquid dropper.</b> No powder. No mess. No packets. 3 seconds." } },
        { "type": "approach_point", "settings": { "text": "<b>From $0.38 per serving</b> - up to 75% less than powder brands" } },
        { "type": "approach_point", "settings": { "text": "<b>Zero sugar</b> - not reduced, not substituted. Eliminated." } },
        { "type": "approach_point", "settings": { "text": "<b>50+ trace minerals</b> drawn from Utah's ancient mineral deposits - not synthetic" } },
        { "type": "approach_point", "settings": { "text": "<b>Unflavored</b> - works in anything without changing the taste" } }
      ]
    }
  ]
}
{% endschema %}

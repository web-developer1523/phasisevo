    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "You're Hydrated.<br><em>But Still Depleted.</em>" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Modern water treatment strips trace minerals. Sports drinks add them back - buried under 34g of sugar. There's a better way." },
    { "type": "text", "id": "problem_label", "label": "Problem column label", "default": "The Problem" },
    { "type": "text", "id": "problem_title", "label": "Problem column title", "default": "What most products get wrong" },
    { "type": "text", "id": "approach_label", "label": "Approach column label", "default": "The Electro+ Approach" },
    { "type": "text", "id": "approach_title", "label": "Approach column title", "default": "Minerals first. Everything else removed." },
    { "type": "text", "id": "depletion_label", "label": "Depletion label", "default": "The Depletion Problem" },
    { "type": "textarea", "id": "depletion_stat", "label": "Depletion stat (HTML allowed)", "default": "In a 60-minute training session, your body loses <em>sodium, potassium, magnesium,</em> and up to <em>48 trace minerals</em> through sweat." },
    { "type": "textarea", "id": "depletion_sub", "label": "Depletion sub text", "default": "Water replaces fluid volume. It doesn't replace mineral density. That gap is what causes cramping, fatigue, poor sleep, and slow recovery." }
  ],
  "blocks": [
    {
      "type": "problem_point",
      "name": "Problem point",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "Powder packets - messy, single-use, committed to one drink" }
      ]
    },
    {
      "type": "approach_point",
      "name": "Approach point",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text (HTML allowed)", "default": "<b>Liquid dropper.</b> No powder. No mess. No packets. 3 seconds." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Phasis Electro Problem",

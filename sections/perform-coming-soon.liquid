      "default": "NOTIFY ME"
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "Show Dot Before Button Text",
      "default": true
    },
    {
      "type": "text",
      "id": "note",
      "label": "Bottom Note",
      "default": "No spam. First access + exclusive pricing for subscribers."
    },
    {
      "type": "text",
      "id": "status_text",
      "label": "Status Text",
      "default": "Launching Soon"
    },
    {
      "type": "text",
      "id": "product_name",
      "label": "Product Name",
      "default": "Perform+"
    },
    {
      "type": "text",
      "id": "product_sub",
      "label": "Product Subtitle",
      "default": "β-Ecdysterone · Muscle & Endurance Formula"
    },
    {
      "type": "text",
      "id": "launch_label",
      "label": "Launch Label",
      "default": "Est. Launch"
    },
    {
      "type": "text",
      "id": "launch_value",
      "label": "Launch Value",
      "default": "Spring 2026"
    },
    {
      "type": "text",
      "id": "perk_label",
      "label": "Perk Label",
      "default": "Waitlist Perk"
    },
    {
      "type": "text",
      "id": "perk_value",
      "label": "Perk Value",
      "default": "Early Access Pricing"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Feature Pill",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perform Coming Soon",
      "blocks": [
        { "type": "pill" },
        { "type": "pill" },
        { "type": "pill" },
        { "type": "pill" },
        { "type": "pill" },
        { "type": "pill" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
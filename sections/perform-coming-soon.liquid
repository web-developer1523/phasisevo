<section class="perf-sec {{ section.settings.custom_css_class }}">
  <div class="perf-inner">
    <div class="perf-l">
      <div class="perf-eyebrow">
        <span>{{ section.settings.eyebrow }}</span>
      </div>
      <h2 class="perf-h">
        {{ section.settings.heading_line1 -}}
        <br>
        {{ section.settings.heading_line2 -}}
        <br>
        <em>{{ section.settings.heading_highlight }}</em>
      </h2>
      <div class="perf-p">
        {{
          section.settings.description
          | replace: 'β-Ecdysterone', "<span class='highlight'>β-Ecdysterone</span>"
          | raw
        }}
      </div>

      <div class="perf-pills">
        {% for block in section.blocks %}
          {% if block.type == 'pill' %}
            <div class="pp">{{ block.settings.text }}</div>
          {% endif %}
        {% endfor %}
      </div>

      <span class="perf-form-label">{{ section.settings.form_label }}</span>

      <!-- SHOPIFY NEWSLETTER FORM -->
      {% form 'customer' %}
        <div class="perf-form">
          <input
            class="perf-input"
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder }}"
            required
          >

          <input type="hidden" name="contact[tags]" value="newsletter">

          <button class="btn btn-a" type="submit">
            {% if section.settings.show_dot %}• {% endif -%}
            {{ section.settings.button_text }}
          </button>
        </div>

        {% if form.posted_successfully? %}
          <p class="perf-note">Thanks! You're on the list.</p>
        {% endif %}

        {% if form.errors %}
          <p class="perf-note">{{ form.errors | default_errors }}</p>
        {% endif %}
      {% endform %}

      <p class="perf-note">{{ section.settings.note }}</p>
    </div>

    <div>
      <div class="perf-card">
        <div class="perf-status">
          <div class="perf-dot"></div>
          <span class="perf-status-txt">{{ section.settings.status_text }}</span>
        </div>
        <div class="perf-pname">
          {% assign product = section.settings.selected_product %}
          {% if product %}
            {{ product.title }}
          {% else -%}
            {{- section.settings.product_name -}}
          {%- endif %}
        </div>
        <div class="perf-psub">{{ section.settings.product_sub }}</div>

        <div class="perf-stats">
          {% for block in section.blocks %}
            {% if block.type == 'stat' %}
              <div class="pstat">
                <div class="pstat-v">{{ block.settings.value }}</div>
                <div class="pstat-l">{{ block.settings.label }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="perf-div"></div>

        <div class="perf-launch">
          <div>
            <div class="pl-lbl">{{ section.settings.launch_label }}</div>
            <div class="pl-val">{{ section.settings.launch_value }}</div>
          </div>
          <div style="text-align:right">
            <div class="pl-lbl">{{ section.settings.perk_label }}</div>
            <div class="pl-val amber">{{ section.settings.perk_value }}</div>
          </div>
        </div>
        {%comment%}<div class="countdown">
          <div class="cdc"><span class="cdc-n" id="cd-d">--</span><span class="cdc-l">Days</span></div>
          <div class="cdc"><span class="cdc-n" id="cd-h">--</span><span class="cdc-l">Hours</span></div>
          <div class="cdc"><span class="cdc-n" id="cd-m">--</span><span class="cdc-l">Mins</span></div>
          <div class="cdc"><span class="cdc-n" id="cd-s">--</span><span class="cdc-l">Secs</span></div>
        </div> {%endcomment%}
          <div class="countdown cst-variant-btn">
             {% assign product = section.settings.selected_product %}
          {% for block in section.blocks %}
            {% if block.type == 'variant_btn' %}
                 {% assign matched_variant = nil %}
                  {% for v in product.variants %}
        {% if v.title == block.settings.label %}
          {% assign matched_variant = v %}
        {% endif %}
      {% endfor %}
              <div class="cdc pv-btn {% if block.settings.highlight %}active{% endif %}"   data-variant-id="{{ matched_variant.id }}" data-value="{{ block.settings.value }}">
                <span class="cdc-n">
                  {{ block.settings.value }}
                </span>
                <span class="cdc-l">
                  {{ block.settings.price }}
                </span>
                <label class="cdc-l pill variant">
                  {{ block.settings.label }}
                </label>
              </div>
            {% endif %}
          {% endfor %}
      </div>
            {% assign product = section.settings.selected_product %}
    <form method="post" action="/cart/add" class="perf-cta-form">
      <input type="hidden" name="id" value="{{ product.variants.first.id }}">
      <button type="submit" class="btn btn-a perf-cta-btn">
        ADD TO CART
      </button>
    </form>
      <div class="product-benefits">
          <p><span class="pstat-v">✔</span>Free Shipping over $75</p>
          <p><span class="pstat-v">✔ </span>30-Day Money Back Guarantee</p>
          <p><span class="pstat-v">✔ </span>Ships in 2–3 Business Days</p>             
      </div>
    </div>
    </div>
  </div>
 <script>
  window.__PERF_VARIANTS__ = {{ product.variants | json }};
</script>
</section>
<script>
document.addEventListener('DOMContentLoaded', function () {

  const section = document.querySelector('.perf-sec');
  const buttons = document.querySelectorAll('.perf-sec .pv-btn');
  const hiddenInput = document.querySelector('.perf-sec .perf-cta-form input[name="id"]');
  const form = document.querySelector('.perf-sec .perf-cta-form');
  const btn = document.querySelector('.perf-sec .perf-cta-btn');
  if (!buttons.length || !hiddenInput) return;
  
  //variant data
    const productVariants = window.__PERF_VARIANTS__ || [];

  //ACTIVE BUTTON 
  let activeBtn =
    document.querySelector('.perf-sec .pv-btn.active') ||
    buttons[0];

  setActive(activeBtn);

  //  CLICK HANDLER
  buttons.forEach(btn => {
    btn.addEventListener('click', function () {
      setActive(this);
    });
  });

function setActive(btnEl) {
  buttons.forEach(b => b.classList.remove('active'));
  btnEl.classList.add('active');

  const variantId = btnEl.dataset.variantId;

  if (variantId) {
    hiddenInput.value = variantId;
  }
}
  // add to cart

   form.addEventListener('submit', function (e) {
  e.preventDefault();

  const variantId = hiddenInput.value;

  if (!variantId) {
    console.log("No variant selected");
    return;
  }

  btn.disabled = true;


  fetch('/cart/add.js', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    },
    body: JSON.stringify({
      id: Number(variantId),
      quantity: 1
    })
  })
  .then(async res => {
    const data = await res.json();
    if (!res.ok) throw data;
    return data;
  })
  .then(() => updateCartCount())
  .catch(err => console.log("Cart Error:", err))
  .finally(() => {
    {% comment %} btn.innerText = "PRE-ORDER NOW"; {% endcomment %}
    btn.disabled = false;
  });
});

  //  CART COUNTER UPDATE
  function updateCartCount() {
    fetch('/cart.js')
      .then(res => res.json())
      .then(cart => {

        const count = cart.item_count;

        document.querySelectorAll('.cart-count-bubble span[aria-hidden="true"]')
          .forEach(el => el.textContent = count);

        document.querySelectorAll('.cart-count-bubble .visually-hidden')
          .forEach(el => {
            el.textContent = count + (count === 1 ? ' item' : ' items');
          });

      });
  }


});
</script>

    {% comment %} <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet"> {% endcomment %}
    <style>
    {% comment %} @font-face{font-family:"Conthrax";src:url("Conthrax-BoldItalic.otf") format("opentype");font-weight:700;font-style:italic}
    @font-face{font-family:"Conthrax";src:url("Conthrax-SemiBold.otf") format("opentype");font-weight:600;font-style:normal}
    @font-face{font-family:"Conthrax";src:url("Conthrax-Italic.otf") format("opentype");font-weight:400;font-style:italic} {% endcomment %}
    
    /* ═══════════════════════════════════════════════
       MOBILE FIRST — Base at 390px, scale up
       ═══════════════════════════════════════════════ */
    :root {
      --teal:#00BFA8; --teal-h:#00d4bb; --teal-dim:rgba(0,191,168,.1);
      --coral:#E8482A;
      --page-bg:#080808;
      --surface:#18191C; --surface2:#1e1f23; --surface3:#252629;
      --border:#2a2b2f; --border2:#383a3e;
      --off-white:#F4F3F0; --muted:#68717A; --muted-l:#9aa0a8;
      --pad:16px; --pad-md:32px; --pad-lg:80px;
      --f-dis:'Sora',sans-serif;
      --f-mark:'Conthrax',sans-serif; --f-body:'DM Sans',sans-serif;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
    body{background:var(--page-bg);color:var(--off-white);font-family:var(--f-body);font-size:15px;line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    a{text-decoration:none;color:inherit}
    ul{list-style:none}
    
    /* ── TYPOGRAPHY ─────────────────────────────────── */
    .eyebrow{display:inline-block;font-family:var(--f-mark);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--teal);margin-bottom:16px}
    h1{font-family:var(--f-dis);font-weight:800;font-size:40px;letter-spacing:-0.025em;line-height:.92}
    h2{font-family:var(--f-dis);font-weight:700;font-size:28px;letter-spacing:-0.02em;line-height:1.05}
    h1 em,h2 em{color:var(--teal);font-style:normal}
    @media(min-width:768px){h1{font-size:54px}h2{font-size:36px}}
    @media(min-width:1024px){h1{font-size:68px}h2{font-size:44px}}
    
    /* ── BUTTONS ─────────────────────────────────────── */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--f-dis);font-size:14px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:15px 24px;min-height:52px;border-radius:6px;border:none;cursor:pointer;transition:all .18s;white-space:nowrap;width:100%}
    .btn::before{content:'●';font-size:7px;flex-shrink:0}
    .btn-t{background:var(--teal);color:#000;box-shadow:0 4px 20px rgba(0,191,168,.2)}
    .btn-t:hover{background:var(--teal-h)}
    .btn-t:active{transform:scale(.98)}
    .btn-s{background:transparent;color:var(--off-white);border:1px solid var(--border2)}
    .btn-s:hover{border-color:#666;background:rgba(255,255,255,.04)}
    .btn-p{background:var(--coral);color:#fff}
    .btn-p:hover{background:#f05236}
    @media(min-width:768px){.btn{width:auto}.btn-full{width:100%}}
    
    .globe-line{height:3px;background:linear-gradient(90deg,#FF5577,#FF9999,#FF9140,#FFE899,#8AC88A,#8AF2D3,#1CA8D8,#5271FF,#8C52FF)}
    
    /* ── ANNOUNCE ────────────────────────────────────── */
    .ann{background:var(--teal);padding:8px var(--pad);display:flex;align-items:center;justify-content:center;gap:0}
    .ann-i{display:flex;align-items:center;gap:6px;font-family:var(--f-dis);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#000;white-space:nowrap}
    .ann-i svg{width:11px;height:11px;flex-shrink:0}
    .ann-sep{display:none}
    .ann-i:not(:first-child){display:none}
    @media(min-width:768px){
      .ann{padding:9px var(--pad-md);gap:32px}
      .ann-sep{display:block;color:rgba(0,0,0,.3)}
      .ann-i:not(:first-child){display:flex}
    }
    @media(min-width:1024px){.ann{padding:9px var(--pad-lg);gap:48px}}
    
    /* ── NAVBAR ──────────────────────────────────────── */
    .nav{position:sticky;top:0;z-index:200;background:rgba(8,8,8,.97);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding: 0;height:56px}
    /* Nav inner wrapper — constrains content width on wide screens */
    .nav-inner {
      display: flex; align-items: center; justify-content: space-between;
      width: 100%; max-width: 1280px; margin: 0 auto;
      padding: 0 var(--pad);
    }
    @media(min-width: 768px) { .nav-inner { padding: 0 32px; } }
    @media(min-width: 1024px) { .nav-inner { padding: 0 48px; } }
    
    .nav-brand{display:flex;align-items:center;gap:10px}
    .logo-mk{width:32px;height:32px;border-radius:6px;background:var(--surface);display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0}
    .nav-wm{font-family:var(--f-mark);font-size:13px;font-weight:700;font-style:italic;letter-spacing:.04em;text-transform:uppercase}
    .nav-links{display:none}
    .nav-r{display:flex;align-items:center;gap:10px}
    .ic-btn{background:none;border:none;color:var(--muted-l);cursor:pointer;padding:8px;display:flex;align-items:center;min-height:44px;min-width:44px;justify-content:center}
    .ic-btn svg{width:18px;height:18px}
    .cart-btn{display:flex;align-items:center;gap:6px;background:var(--surface);border:1px solid var(--border2);border-radius:5px;color:var(--off-white);font-family:var(--f-dis);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:8px 12px;min-height:44px;cursor:pointer}
    .cart-n{background:var(--coral);color:#fff;font-size:10px;font-weight:700;width:17px;height:17px;border-radius:50%;display:flex;align-items:center;justify-content:center}
    .nav-cta-btn{display:none}
    @media(min-width:768px){
      .nav{padding:0 var(--pad-md)}
      .nav-links{display:flex;gap:20px;list-style:none}
      .nav-links a{font-family:var(--f-dis);font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-l);transition:color .15s}
      .nav-links a:hover{color:var(--off-white)}
      .nav-cta-btn{display:flex;align-items:center;gap:6px;background:var(--teal);color:#000;font-family:var(--f-dis);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:8px 14px;border-radius:5px;border:none;cursor:pointer;min-height:44px}
      .nav-cta-btn::before{content:'●';font-size:6px}
    }
    @media(min-width:1024px){.nav{padding:0 var(--pad-lg);height:60px}.nav-links{gap:24px}}
    
    /* ── SECTION PADDING ─────────────────────────────── */
    .section{padding:48px var(--pad)}
    @media(min-width:768px){.section{padding:64px var(--pad-md)}}
    @media(min-width:1024px){.section{padding:80px var(--pad-lg)}}
    
    /* ── HERO ─────────────────────────────────────────── */
    .hero{display:flex;flex-direction:column}
    .hero-content{padding:32px var(--pad) 24px;display:flex;flex-direction:column}
    .hero-eyebrow-row{display:flex;align-items:center;gap:10px;margin-bottom:16px}
    .hero-eyebrow-row::before{content:'';width:20px;height:2px;background:var(--teal);flex-shrink:0}
    .hero-eyebrow-row span{font-family:var(--f-mark);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--teal)}
    .hero h1{margin-bottom:16px}
    .hero-hook{font-size:16px;font-weight:300;color:var(--muted-l);line-height:1.65;border-left:3px solid rgba(0,191,168,.3);padding-left:14px;margin-bottom:20px}
    .hero-hook strong{color:var(--off-white);font-weight:600}
    
    /* Differentiator pills — scroll on mobile */
    .diff-pills{display:flex;gap:8px;margin-bottom:20px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:4px}
    .diff-pills::-webkit-scrollbar{display:none}
    .dp{display:flex;align-items:center;gap:5px;background:var(--teal-dim);border:1px solid rgba(0,191,168,.22);color:var(--teal);font-family:var(--f-dis);font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:5px 10px;border-radius:20px;white-space:nowrap;flex-shrink:0}
    .dp::before{content:'✓';margin-right:1px}
    .dp.no{background:rgba(255,255,255,.04);border-color:var(--border2);color:var(--muted-l)}
    .dp.no::before{content:'✗';color:#c04040}
    
    .trust-row{display:flex;align-items:center;gap:16px;margin-bottom:20px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
    .trust-row::-webkit-scrollbar{display:none}
    .stars{color:var(--teal);font-size:14px;letter-spacing:1px;flex-shrink:0}
    .trust-pill{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);flex-shrink:0}
    .trust-pill b{color:var(--off-white);font-weight:500}
    .trust-sep{color:var(--border2);flex-shrink:0}
    
    .hero-cta{display:flex;flex-direction:column;gap:12px;margin-bottom:16px}
    .hero-cta .btn-t{font-size:15px;padding:17px 24px}
    .cta-micro{display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap}
    .cta-micro-item{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--muted)}
    .cta-micro-item::before{content:'✓';color:var(--teal);font-weight:700;font-size:10px;font-family:var(--f-dis)}
    
    /* Max Relief cross-nudge */
    .stack-nudge{display:flex;align-items:center;gap:12px;background:rgba(232,72,42,.05);border:1px solid rgba(232,72,42,.18);border-radius:6px;padding:12px 14px;cursor:pointer;transition:all .15s}
    .sn-icon{font-size:18px;flex-shrink:0}
    .sn-label{font-family:var(--f-dis);font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--coral);margin-bottom:2px}
    .sn-desc{font-size:11px;color:var(--muted-l)}
    .sn-arrow{color:var(--coral);margin-left:auto;flex-shrink:0}
    
    /* Hero visual */
    .hero-visual{height:260px;background:linear-gradient(160deg,#080e0c,var(--surface));position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
    .hero-visual::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 65% 60% at 50% 35%,rgba(0,191,168,.09) 0%,transparent 65%)}
    .hero-bg-word{position:absolute;bottom:-15px;right:-8px;font-family:var(--f-dis);font-size:120px;font-weight:800;color:rgba(0,191,168,.03);letter-spacing:-0.05em;line-height:1;pointer-events:none;user-select:none}
    .hero-emo{font-size:100px;filter:drop-shadow(0 20px 50px rgba(0,191,168,.2));animation:fl 5s ease-in-out infinite;position:relative;z-index:1}
    @keyframes fl{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
    
    /* Stats overlay */
    .hero-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0 var(--pad) 0;padding:16px 0 0}
    .hstat{background:rgba(8,8,8,.92);border:1px solid rgba(0,191,168,.15);border-radius:8px;padding:14px 12px}
    .hstat-val{font-family:var(--f-dis);font-size:20px;font-weight:800;color:var(--teal);line-height:1;margin-bottom:4px}
    .hstat-lbl{font-size:11px;color:var(--muted-l);line-height:1.4}
    
    .hero-rev{background:rgba(8,8,8,.95);border:1px solid var(--border);border-radius:8px;padding:14px 16px;margin:12px var(--pad) 0}
    .hero-rev .stars{font-size:12px;margin-bottom:8px}
    .hero-rev blockquote{font-size:13px;font-style:italic;color:var(--muted-l);line-height:1.6;margin-bottom:10px}
    .hero-rev cite{font-family:var(--f-dis);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-style:normal}
    .hero-rev cite span{display:block;font-size:10px;font-weight:400;color:var(--muted);text-transform:none;margin-top:2px}
    
    @media(min-width:768px){
      .hero{flex-direction:row;min-height:calc(100vh - 93px)}
      .hero-content{flex:1;padding:64px var(--pad-md);justify-content:center}
      .hero-visual{flex:1;height:auto}
      .hero-stats{position:absolute;top:24px;left:16px;right:16px;padding:0;margin:0}
      .hero-rev{position:absolute;bottom:24px;left:16px;right:16px;margin:0}
    }
    @media(min-width:1024px){
      .hero-content{padding:80px var(--pad-lg) 80px calc(var(--pad-lg) - 20px);max-width:52%}
    }
    
    /* ── TRUST BAR ───────────────────────────────────── */
    .trust-bar{background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
    .trust-bar::-webkit-scrollbar{display:none}
    .tb{display:flex;align-items:center;gap:6px;font-family:var(--f-dis);font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted-l);padding:12px 20px;border-right:1px solid var(--border);flex-shrink:0;white-space:nowrap}
    .tb:last-child{border-right:none}
    .tb svg{color:var(--teal);width:12px;height:12px;flex-shrink:0}
    
    /* ── PROBLEM — the water myth ────────────────────── */
    .problem-sec{background:var(--page-bg);border-top:1px solid var(--border)}
    .problem-center{text-align:center;margin-bottom:28px}
    .problem-center h2{margin-bottom:12px}
    .problem-sub{font-size:16px;font-weight:300;color:var(--muted-l);line-height:1.7}
    .mt-4{margin-top:16px}
    
    /* Myth grid — 1 col mobile, 2 col desktop */
    .myth-grid{display:grid;grid-template-columns:1fr;gap:12px;margin-bottom:24px}
    @media(min-width:768px){.myth-grid{grid-template-columns:1fr 1fr}}
    
    .myth-card{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:20px 16px}
    .myth-card.myth{border-top:3px solid #c04040}
    .myth-card.truth{border-top:3px solid var(--teal)}
    .mc-label{display:flex;align-items:center;gap:6px;font-family:var(--f-dis);font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;margin-bottom:14px}
    .mc-label.bad{color:#c04040}
    .mc-label.bad::before{content:'✗';font-size:14px}
    .mc-label.good{color:var(--teal)}
    .mc-label.good::before{content:'✓';font-size:14px}
    .mc-title{font-family:var(--f-dis);font-size:16px;font-weight:700;margin-bottom:14px;line-height:1.2}
    .mc-points{display:flex;flex-direction:column;gap:10px}
    .mc-point{display:flex;align-items:flex-start;gap:10px;font-size:13px;color:var(--muted-l);line-height:1.55;padding:10px 12px;background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:4px}
    .mc-point.bad::before{content:'·';color:#c04040;font-size:18px;line-height:1;flex-shrink:0;margin-top:-2px}
    .mc-point.good::before{content:'→';color:var(--teal);font-size:12px;font-weight:700;flex-shrink:0;margin-top:2px}
    .mc-point b{color:var(--off-white);font-weight:600}
    
    .depletion-block{background:rgba(0,191,168,.05);border:1px solid rgba(0,191,168,.2);border-radius:8px;padding:24px 20px;text-align:center}
    .db-label{font-family:var(--f-body);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--teal);margin-bottom:12px;display:block}
    .db-stat{font-family:var(--f-dis);font-size:clamp(18px,4vw,28px);font-weight:800;line-height:1.2;letter-spacing:-0.02em;margin-bottom:12px}
    .db-stat em{color:var(--teal);font-style:normal}
    .db-sub{font-size:14px;font-weight:300;color:var(--muted-l);line-height:1.7;max-width:520px;margin:0 auto}
    
    /* ── WHAT IS IT ──────────────────────────────────── */
    .what-sec{background:var(--surface);border-top:1px solid var(--border)}
    .what-eyebrow-row{display:flex;align-items:center;gap:10px;margin-bottom:16px}
    .what-eyebrow-row::before{content:'';width:20px;height:2px;background:var(--teal);flex-shrink:0}
    .what-eyebrow-row span{font-family:var(--f-mark);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--teal)}
    .what-sec h2{margin-bottom:16px}
    .what-p{font-size:14px;font-weight:300;color:var(--muted-l);line-height:1.75;margin-bottom:20px}
    .what-p strong{color:var(--off-white);font-weight:600}
    
    /* How to use steps */
    .how-steps{display:flex;flex-direction:column;gap:10px;margin-bottom:28px}
    .hs{display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:6px;padding:14px 16px}
    .hs-num{font-family:var(--f-dis);font-size:20px;font-weight:800;color:var(--teal);line-height:1;width:28px;flex-shrink:0;opacity:.8}
    .hs-title{font-family:var(--f-dis);font-size:13px;font-weight:700;margin-bottom:2px}
    .hs-desc{font-size:12px;color:var(--muted)}
    
    /* Mineral card */
    .mineral-card{background:var(--page-bg);border:1px solid rgba(0,191,168,.2);border-radius:10px;padding:20px 16px;margin-top:28px;position:relative;overflow:hidden}
    .mineral-card::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 50% at 50% 0%,rgba(0,191,168,.06) 0%,transparent 65%);pointer-events:none}
    .mc-header{margin-bottom:16px}
    .mc-header-label{font-family:var(--f-body);font-size:9px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--teal);margin-bottom:6px;display:block}
    .mc-header-title{font-family:var(--f-dis);font-size:17px;font-weight:700}
    .minerals-list{display:flex;flex-direction:column;gap:12px;margin-bottom:16px}
    .ml-item{display:flex;align-items:center;gap:12px}
    .ml-icon{font-size:16px;width:28px;text-align:center;flex-shrink:0}
    .ml-name{font-family:var(--f-dis);font-size:12px;font-weight:700;margin-bottom:2px}
    .ml-role{font-size:11px;color:var(--muted)}
    .ml-bar-wrap{flex:1;display:flex;align-items:center}
    .ml-bar-track{flex:1;height:3px;background:var(--surface3);border-radius:2px;overflow:hidden}
    .ml-bar-fill{height:100%;background:var(--teal);border-radius:2px}
    .mc-footer{border-top:1px solid var(--border);padding-top:14px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;text-align:center}
    .mcf-val{font-family:var(--f-dis);font-size:17px;font-weight:700;color:var(--teal);display:block;margin-bottom:2px}
    .mcf-lbl{font-size:10px;color:var(--muted)}
    
    @media(min-width:1024px){
      .what-inner{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}
      .mineral-card{margin-top:0}
    }
    
    /* ── VS COMPETITION ──────────────────────────────── */
    .vs-sec{background:var(--page-bg);border-top:1px solid var(--border)}
    .vs-top{text-align:center;margin-bottom:28px}
    .vs-top h2{margin-bottom:12px}
    .vs-sub{font-size:15px;font-weight:300;color:var(--muted-l);line-height:1.7}
    
    .vs-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:0 calc(-1 * var(--pad))}
    @media(min-width:768px){.vs-scroll{overflow-x:visible;margin:0}}
    
    .vs-table{background:var(--surface);border:1px solid var(--border);border-radius:8px;overflow:hidden;min-width:580px}
    @media(min-width:768px){.vs-table{min-width:0}}
    
    .vs-head{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;background:rgba(255,255,255,.03);border-bottom:1px solid var(--border)}
    .vh{padding:10px 14px;font-family:var(--f-dis);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
    .vh.highlight{color:var(--teal);background:rgba(0,191,168,.05)}
    .vs-row{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;border-bottom:1px solid var(--border);align-items:center}
    .vs-row:last-child{border-bottom:none}
    .vc{padding:10px 14px;font-size:12px}
    .vc.feature{color:var(--off-white);font-weight:500}
    .vc.yes{color:var(--teal);font-weight:600;text-align:center}.vc.yes::after{content:' ✓'}
    .vc.no{color:var(--muted);text-align:center;font-size:11px}.vc.no::after{content:' ✗';color:#c04040}
    .vc.partial{color:var(--muted-l);text-align:center;font-size:11px}
    .vc.hl{background:rgba(0,191,168,.04)}
    
    /* ── SCIENCE / WHO IT'S FOR ──────────────────────── */
    .science-sec{background:var(--surface);border-top:1px solid var(--border)}

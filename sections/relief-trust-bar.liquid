<!-- TRUST BAR -->
<div class="trust-bar">
  {% for block in section.blocks %}
    <div class="tb">
      {{ block.settings.icon }}
      {{ block.settings.text }}
    </div>
  {% endfor %}
</div>
<style>
    /* ── TRUST BAR ──────────────────────────────────── */
.trust-bar{
  background:var(--surface);border-bottom:1px solid var(--border);
  display:flex;align-items:center;
  overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;
  padding:0;
}
.trust-bar::-webkit-scrollbar{display:none}
.tb{
  display:flex;align-items:center;gap:6px;
  font-family:var(--f-dis);font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);
  padding: 14px var(--sp6);border-right:1px solid var(--border);flex-shrink:0;white-space:nowrap;
}
.tb:last-child{border-right:none}
.tb svg{color:var(--coral);width:12px;height:12px;flex-shrink:0}
</style>
{% schema %}
{
  "name": "Relief Trust Bar",
  "settings": [],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "SVG Icon",
          "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "3RD PARTY TESTED"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": " Relief Trust Bar",
      "blocks": [
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" }
      ]
    }
  ]
}
{% endschema %}
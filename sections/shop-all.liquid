<!DOCTYPE html>
    <html lang="en">
    <head>
    <meta charset="UTF-8">
    <meta name="description" content="Shop PHASIS — Max Relief Balm, Electro+ Drops, and Perform+. Science-backed recovery and performance supplements.">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop All — PHASIS · Recovery, Hydration &amp; Performance</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">
    <style>
    @font-face{font-family:"Conthrax";src:url("Conthrax-BoldItalic.otf") format("opentype");font-weight:700;font-style:italic}
    @font-face{font-family:"Conthrax";src:url("Conthrax-SemiBold.otf") format("opentype");font-weight:600;font-style:normal}
    @font-face{font-family:"Conthrax";src:url("Conthrax-Italic.otf") format("opentype");font-weight:400;font-style:italic}
    
    /* ═══════════════════════════════════════════════
       MOBILE FIRST — Base at 390px, scale up
       ═══════════════════════════════════════════════ */
    :root {
      --coral:#E8482A; --coral-h:#f05236;
      --teal:#00BFA8; --teal-h:#00d4bb;
      --amber:#D4831A; --amber-h:#e8941f; --orange:#D4831A;
      --page-bg:#080808;
      --surface:#18191C; --surface2:#1e1f23;
      --border:#2a2b2f; --border2:#383a3e;
      --off-white:#F4F3F0; --muted:#68717A; --muted-l:#9aa0a8;
      --pad:16px; --pad-md:32px; --pad-lg:80px;
      --f-dis:'Sora',sans-serif;
      --f-mark:'Conthrax',sans-serif; --f-body:'DM Sans',sans-serif;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
    body{background:var(--page-bg);color:var(--off-white);font-family:var(--f-body);font-size:15px;line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    a{text-decoration:none;color:inherit}
    ul{list-style:none}
    
    .eyebrow{display:inline-block;font-family:var(--f-mark);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--coral);margin-bottom:14px}
    h1{font-family:var(--f-dis);font-weight:800;font-size:36px;letter-spacing:-0.025em;line-height:.95}
    h2{font-family:var(--f-dis);font-weight:700;font-size:26px;letter-spacing:-0.02em;line-height:1.05}
    h1 em,h2 em{color:var(--coral);font-style:normal}
    @media(min-width:768px){h1{font-size:48px}h2{font-size:36px}}
    @media(min-width:1024px){h1{font-size:58px}h2{font-size:44px}}
    
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--f-dis);font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:13px 20px;min-height:48px;border-radius:5px;border:none;cursor:pointer;transition:all .18s;white-space:nowrap;width:100%}
    .btn::before{content:'●';font-size:6px;flex-shrink:0}
    .btn-p{background:var(--coral);color:#fff}.btn-p:hover{background:var(--coral-h)}
    .btn-t{background:var(--teal);color:#000}.btn-t:hover{background:var(--teal-h)}
    .btn-a{background:var(--amber);color:#fff}.btn-a:hover{background:var(--amber-h)}
    .btn-s{background:transparent;color:var(--off-white);border:1px solid var(--border2)}.btn-s:hover{background:rgba(255,255,255,.04)}
    @media(min-width:768px){.btn{width:auto}.btn-full{width:100%}}
    
    .globe-line{height:3px;background:linear-gradient(90deg,#FF5577,#FF9999,#FF9140,#FFE899,#8AC88A,#8AF2D3,#1CA8D8,#5271FF,#8C52FF)}
    .section{padding:48px var(--pad)}
    @media(min-width:768px){.section{padding:64px var(--pad-md)}}
    @media(min-width:1024px){.section{padding:80px var(--pad-lg)}}
    .mt-4{margin-top:16px}.mt-6{margin-top:24px}
        
    /* ── PAGE HEADER ─────────────────────────────────── */
    .page-header{background:var(--surface);border-bottom:1px solid var(--border);padding:32px var(--pad);position:relative;overflow:hidden}
    .page-header::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 100% at 100% 50%,rgba(232,72,42,.04) 0%,transparent 60%);pointer-events:none}
    .ph-breadcrumb{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--muted);margin-bottom:16px;font-family:var(--f-dis);letter-spacing:.06em;text-transform:uppercase}
    .ph-breadcrumb a{color:var(--muted);transition:color .15s}
    .ph-breadcrumb a:hover{color:var(--off-white)}
    .ph-breadcrumb span{color:var(--border2)}
    .ph-title{margin-bottom:12px;position:relative}
    .ph-sub{font-size:15px;font-weight:300;color:var(--muted-l);line-height:1.7;max-width:480px;position:relative}
    .ph-stats{display:flex;gap:24px;margin-top:20px;flex-wrap:wrap;position:relative}
    .ph-stat-val{font-family:var(--f-dis);font-size:20px;font-weight:800;line-height:1;margin-bottom:3px}
    .ph-stat-val.coral{color:var(--coral)}
    .ph-stat-val.teal{color:var(--teal)}
    .ph-stat-val.amber{color:var(--amber)}
    .ph-stat-lbl{font-size:10px;color:var(--muted);letter-spacing:.06em;text-transform:uppercase}
    @media(min-width:768px){.page-header{padding:48px var(--pad-md)}}
    @media(min-width:1024px){.page-header{padding:64px var(--pad-lg)}.ph-stats{gap:48px}}
    
    /* ── TRUST BAR ───────────────────────────────────── */
    .trust-bar{background:var(--page-bg);border-bottom:1px solid var(--border);display:flex;align-items:center;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
    .trust-bar::-webkit-scrollbar{display:none}
    .tb{display:flex;align-items:center;gap:6px;font-family:var(--f-dis);font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted-l);padding:12px 18px;border-right:1px solid var(--border);flex-shrink:0;white-space:nowrap}
    .tb:last-child{border-right:none}
    .tb svg{color:var(--coral);width:12px;height:12px;flex-shrink:0}
    
    /* ── FILTER BAR ──────────────────────────────────── */
    .filter-bar{background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:0 var(--pad);height:48px;gap:16px}
    .filter-bar::-webkit-scrollbar{display:none}
    .filter-tabs{display:flex;gap:0;flex-shrink:0}
    .filter-tab{background:none;border:none;border-bottom:2px solid transparent;color:var(--muted);font-family:var(--f-dis);font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:0 14px;height:48px;cursor:pointer;transition:all .15s;white-space:nowrap;min-height:48px}
    .filter-tab.active{color:var(--coral);border-bottom-color:var(--coral)}
    .filter-count{display:inline-flex;align-items:center;justify-content:center;background:rgba(232,72,42,.15);color:var(--coral);font-size:9px;font-weight:700;width:15px;height:15px;border-radius:50%;margin-left:4px}
    .sort-select{background:var(--surface2);border:1px solid var(--border2);border-radius:4px;color:var(--off-white);font-family:var(--f-dis);font-size:11px;font-weight:600;letter-spacing:.04em;padding:6px 10px;cursor:pointer;outline:none;flex-shrink:0;min-height:36px}
    .sort-select option{background:var(--surface)}
    @media(min-width:768px){.filter-bar{padding:0 var(--pad-md)}}
    @media(min-width:1024px){.filter-bar{padding:0 var(--pad-lg)}}
    
    /* ── PRODUCT GRID ────────────────────────────────── */
    .shop-main{padding:24px var(--pad)}
    .products-grid{display:grid;grid-template-columns:1fr;gap:16px}
    @media(min-width:600px){.products-grid{grid-template-columns:1fr 1fr}}
    @media(min-width:1024px){.products-grid{grid-template-columns:repeat(3,1fr)};.shop-main{padding:32px var(--pad-lg)}}
    
    /* ── PRODUCT CARD ────────────────────────────────── */
    .product-card{background:var(--surface);border:1px solid var(--border);border-radius:8px;overflow:hidden;display:flex;flex-direction:column;transition:border-color .2s,transform .15s;position:relative}
    .product-card:hover{transform:translateY(-2px)}
    .product-card.featured{border-color:rgba(232,72,42,.25)}
    
    .card-badge{position:absolute;top:12px;left:12px;z-index:2;display:flex;gap:6px;flex-wrap:wrap}
    .badge{display:inline-flex;align-items:center;gap:4px;font-family:var(--f-dis);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:4px 9px;border-radius:3px}
    .badge-bestseller{background:var(--coral);color:#fff}
    .badge-new{background:var(--teal);color:#000}
    .badge-soon{background:rgba(212,131,26,.15);color:var(--amber);border:1px solid rgba(212,131,26,.3)}
    .badge-soon::before{content:'';width:5px;height:5px;background:var(--amber);border-radius:50%;animation:pa 2s ease-in-out infinite}
    @keyframes pa{0%,100%{opacity:1}50%{opacity:.4}}
    
    .card-img{height:220px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
    .card-img-emoji{font-size:80px;filter:drop-shadow(0 14px 32px rgba(0,0,0,.4));transition:transform .3s ease;position:relative;z-index:1}
    .product-card:hover .card-img-emoji{transform:translateY(-5px) scale(1.04)}
    .card-img-glow{position:absolute;width:120px;height:120px;border-radius:50%;filter:blur(35px);opacity:.12;transition:opacity .3s}
    .product-card:hover .card-img-glow{opacity:.22}
    
    .card-body{padding:16px 16px 20px;flex:1;display:flex;flex-direction:column}
    .card-cat{font-family:var(--f-body);font-size:9px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;margin-bottom:6px}
    .card-name{font-family:var(--f-dis);font-size:18px;font-weight:700;letter-spacing:-0.01em;margin-bottom:8px;line-height:1.15}
    .card-tagline{font-size:12px;color:var(--muted);line-height:1.55;margin-bottom:14px;flex:1}
    .card-features{display:flex;flex-direction:column;gap:5px;margin-bottom:16px}
    .cf{display:flex;align-items:flex-start;gap:6px;font-size:11px;color:var(--muted-l);line-height:1.45}
    .cf::before{content:'✓';font-weight:700;font-size:10px;flex-shrink:0;margin-top:1px;font-family:var(--f-dis)}
    .cf.coral::before{color:var(--coral)}
    .cf.teal::before{color:var(--teal)}
    .cf.amber::before{color:var(--amber)}
    .card-footer{border-top:1px solid var(--border);padding-top:14px;display:flex;align-items:center;justify-content:space-between;gap:12px}
    .card-price{font-family:var(--f-dis);font-size:20px;font-weight:800;line-height:1}
    .card-price-sub{font-size:10px;color:var(--muted);margin-top:2px}
    .card-footer .btn{padding:11px 16px;font-size:11px;flex-shrink:0;width:auto;min-height:44px}
    
    /* Coming soon overlay */
    .cs-overlay{position:absolute;inset:0;background:rgba(8,8,8,.65);backdrop-filter:blur(3px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;z-index:3;opacity:0;transition:opacity .2s}
    .product-card.soon:hover .cs-overlay{opacity:1}
    .cs-text{font-family:var(--f-dis);font-size:13px;font-weight:700;color:var(--amber);letter-spacing:.08em;text-transform:uppercase}
    .cs-sub{font-size:11px;color:var(--muted-l)}
    .cs-overlay .btn{width:auto;padding:10px 18px;font-size:11px}
    
    /* ── STACK SECTION ───────────────────────────────── */
    .stack-sec{background:var(--surface);border-top:1px solid var(--border)}
    .stack-eyebrow-row{display:flex;align-items:center;gap:10px;margin-bottom:16px}
    .stack-eyebrow-row::before{content:'';width:20px;height:2px;background:var(--coral);flex-shrink:0}
    .stack-eyebrow-row span{font-family:var(--f-mark);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--coral)}
    .stack-sec h2{margin-bottom:14px}
    .stack-p{font-size:14px;font-weight:300;color:var(--muted-l);line-height:1.75;margin-bottom:20px}
    
    .stack-items{display:flex;flex-direction:column;gap:8px;margin-bottom:16px}
    .si{display:flex;align-items:center;gap:12px;padding:12px 14px;background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:6px}
    .si-emoji{font-size:20px;flex-shrink:0}
    .si-body{flex:1}
    .si-name{font-family:var(--f-dis);font-size:13px;font-weight:700}
    .si-desc{font-size:11px;color:var(--muted)}
    .si-price{font-family:var(--f-dis);font-size:14px;font-weight:700;flex-shrink:0}
    
    .stack-total{display:flex;align-items:center;justify-content:space-between;padding:14px 14px;background:rgba(232,72,42,.07);border:1px solid rgba(232,72,42,.2);border-radius:6px;margin-bottom:16px}
    .st-label{font-family:var(--f-dis);font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
    .st-original{font-size:12px;color:var(--muted);text-decoration:line-through}
    .st-sale{font-family:var(--f-dis);font-size:22px;font-weight:800;color:var(--coral)}
    .st-save{font-size:11px;color:var(--coral);font-weight:600}
    
    /* Stack visual — desktop only */
    .stack-visual{display:none}
    @media(min-width:1024px){
      .stack-inner{display:grid;grid-template-columns:1fr 1.1fr;gap:64px;align-items:center}
      .stack-visual{display:block;background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:48px 32px;text-align:center;position:relative;overflow:hidden}
      .stack-visual::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(232,72,42,.06) 0%,transparent 65%);pointer-events:none}
      .sv-emojis{font-size:52px;letter-spacing:16px;margin-bottom:20px;display:block;position:relative;z-index:1}
      .sv-title{font-family:var(--f-dis);font-size:16px;font-weight:700;margin-bottom:8px;position:relative;z-index:1}
      .sv-sub{font-size:12px;color:var(--muted);margin-bottom:24px;position:relative;z-index:1}
      .sv-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;position:relative;z-index:1}
      .sv-stat{background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:6px;padding:12px}
      .sv-stat-val{font-family:var(--f-dis);font-size:18px;font-weight:800;color:var(--coral);display:block;margin-bottom:3px}
      .sv-stat-lbl{font-size:10px;color:var(--muted)}
    }
    
    /* ── BENEFITS ────────────────────────────────────── */
    .benefits-sec{background:var(--page-bg);border-top:1px solid var(--border)}
    .benefits-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    @media(min-width:768px){.benefits-grid{grid-template-columns:repeat(4,1fr)}}
    .benefit-card{padding:16px 14px;border:1px solid var(--border);border-radius:6px;background:var(--surface)}
    .bc-icon{font-size:24px;margin-bottom:10px}
    .bc-title{font-family:var(--f-dis);font-size:12px;font-weight:700;margin-bottom:6px}
    .bc-desc{font-size:11px;color:var(--muted);line-height:1.6}
    
    /* ── REVIEWS ─────────────────────────────────────── */
    .reviews-sec{background:var(--surface);border-top:1px solid var(--border)}
    .rs-header{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px;flex-wrap:wrap}
    .rs-score{display:flex;align-items:center;gap:16px}
    .rs-big{font-family:var(--f-dis);font-size:40px;font-weight:800;line-height:1}
    .rs-stars{color:var(--coral);font-size:14px;letter-spacing:2px}
    .rs-label{font-size:11px;color:var(--muted);margin-top:3px}
    .reviews-grid{display:grid;grid-template-columns:1fr;gap:10px}
    @media(min-width:600px){.reviews-grid{grid-template-columns:1fr 1fr}}
    @media(min-width:1024px){.reviews-grid{grid-template-columns:repeat(3,1fr)}}
    .mini-rev{background:var(--page-bg);border:1px solid var(--border);border-radius:6px;padding:16px}
    .mr-stars{color:var(--coral);font-size:11px;margin-bottom:10px}
    .mr-q{font-size:13px;font-style:italic;color:var(--muted-l);line-height:1.65;margin-bottom:12px}
    .mr-name{font-family:var(--f-dis);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
    .mr-meta{font-size:10px;color:var(--muted);margin-top:2px}
    
    /* ── FAQ ─────────────────────────────────────────── */
    .faq-sec{background:var(--page-bg);border-top:1px solid var(--border)}
    .faq-sec h2{margin-bottom:8px}
    .faq-top-sub{font-size:14px;color:var(--muted);margin-bottom:24px}
    .faq-cols{display:grid;grid-template-columns:1fr;gap:0}
    @media(min-width:768px){.faq-cols{grid-template-columns:1fr 1fr;gap:0 48px}}
    .faq-item{border-bottom:1px solid var(--border)}
    .faq-item:first-child{border-top:1px solid var(--border)}
    .faq-q{display:flex;align-items:center;justify-content:space-between;padding:14px 0;cursor:pointer;gap:14px;min-height:52px}
    .faq-q-text{font-family:var(--f-dis);font-size:13px;font-weight:600;line-height:1.3}
    .faq-icon{color:var(--coral);font-size:18px;flex-shrink:0;transition:transform .2s;font-weight:300;line-height:1;min-width:22px;text-align:center}
    .faq-item.open .faq-icon{transform:rotate(45deg)}
    .faq-a{font-size:13px;color:var(--muted-l);line-height:1.7;padding-bottom:14px;display:none}
    .faq-item.open .faq-a{display:block}
    
    
    
    @media(min-width:768px){}
    @media(min-width:1024px){}
    .site-footer-grid{display:grid;grid-template-columns:1fr;gap:36px;margin-bottom:40px}
    @media(min-width:640px){.site-footer-grid{grid-template-columns:1.4fr 1fr 1fr}}
    @media(min-width:1024px){.site-footer-grid{grid-template-columns:1.6fr 1fr 1fr 1fr}}
    .sf-brand 
    .sf-brand 
    .sf-brand p{font-size:12px;color:var(--muted);line-height:1.65;margin-bottom:16px;max-width:260px}
    
    
    .sf-social:hover{border-color:var(--border2);color:var(--off-white)}
    .sf-col h5{font-family:var(--f-dis);font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
    .sf-col ul{list-style:none;display:flex;flex-direction:column;gap:9px}
    .sf-col ul li a{font-size:13px;color:var(--muted-l);text-decoration:none;transition:color .15s}
    .sf-col ul li a:hover{color:var(--off-white)}
    
    
    
    .sf-phasis-link:hover{color:var(--coral)}
    
    .site-footer{background:#060606;border-top:1px solid var(--border);padding:48px 20px 28px}
    @media(min-width:768px){.site-footer{padding:56px 32px 32px}}
    @media(min-width:1024px){.site-footer{padding:64px 48px 36px}}
    .site-footer-grid{display:grid;grid-template-columns:1fr;gap:36px;margin-bottom:40px}
    @media(min-width:640px){.site-footer-grid{grid-template-columns:1.4fr 1fr 1fr}}
    @media(min-width:1024px){.site-footer-grid{grid-template-columns:1.6fr 1fr 1fr 1fr}}
    .sf-brand{display:flex;flex-direction:column}
    .sf-brand .sf-logo-row{display:flex;align-items:center;gap:10px;margin-bottom:10px}
    .sf-brand .sf-tagline{font-family:var(--f-mark);font-size:9px;font-weight:400;font-style:italic;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:10px;display:block}
    .sf-brand p{font-size:12px;color:var(--muted);line-height:1.65;margin-bottom:16px;max-width:260px}
    .sf-socials{display:flex;gap:8px}
    .sf-social{width:32px;height:32px;border-radius:6px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--muted);text-decoration:none;transition:all .15s}
    .sf-social:hover{border-color:var(--border2);color:var(--off-white)}
    .sf-col h5{font-family:var(--f-dis);font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
    .sf-col ul{list-style:none;display:flex;flex-direction:column;gap:9px}
    .sf-col ul li a{font-size:13px;color:var(--muted-l);text-decoration:none;transition:color .15s}
    .sf-col ul li a:hover{color:var(--off-white)}
    .sf-bot{border-top:1px solid var(--border);padding-top:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px}
    .sf-legal{font-size:11px;color:var(--muted)}
    .sf-phasis-link{font-family:var(--f-dis);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);text-decoration:none}
    .sf-phasis-link:hover{color:var(--coral)}
    </style>
    </head>
    <body>
    

<section class="science-sec section">
    <div class="science-inner">
      <div>
        <div class="sci-eyebrow-row"><span>{{ section.settings.eyebrow }}</span></div>
        <h2>{{ section.settings.heading }}</h2>
        <p class="sci-p mt-4">{{ section.settings.description }}</p>
        <div class="sci-points">
          {% for block in section.blocks %}
            {% if block.type == 'science_point' %}
              <div class="sci-pt" {{ block.shopify_attributes }}>
                <div class="sci-pt-icon">{{ block.settings.icon }}</div>
                <div>
                  <h3 class="sci-pt-title">{{ block.settings.title }}</h3>
                  <div class="sci-pt-desc">{{ block.settings.desc }}</div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="who-cards">
        {% for block in section.blocks %}
          {% if block.type == 'who_card' %}
            <div class="who-card" {{ block.shopify_attributes }}>
              <div class="wc-header">
                <div class="wc-icon">{{ block.settings.icon }}</div>
                <div>
                  <h3 class="wc-title">{{ block.settings.title }}</h3>
                  <div class="wc-sub">{{ block.settings.sub }}</div>
                </div>
              </div>
              <div class="wc-body">
                <div class="wc-benefit">{{ block.settings.benefit_1 }}</div>
                <div class="wc-benefit">{{ block.settings.benefit_2 }}</div>
                <div class="wc-benefit">{{ block.settings.benefit_3 }}</div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
  <style>
    /* ── SCIENCE / WHO IT'S FOR ──────────────────────── */
    .science-sec{background:var(--surface);border-top:1px solid var(--border)}
    .sci-eyebrow-row{display:flex;align-items:center;gap:10px;margin-bottom:16px}
    .sci-eyebrow-row::before{content:'';width:20px;height:2px;background:var(--teal);flex-shrink:0}
    .sci-eyebrow-row span{font-family:var(--f-mark);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--teal)}
    .science-sec h2{margin-bottom:16px}
    .sci-p{font-size:15px;font-weight:300;color:#d0d0d0;line-height:1.75;margin-bottom:20px}
    .sci-p strong{color:var(--off-white);font-weight:600}
    
    .sci-points{display:flex;flex-direction:column;gap:10px;margin-bottom:28px}
    .sci-pt{display:flex;align-items:flex-start;gap:14px;padding:14px 16px;background:rgba(255,255,255,.03);border:1px solid var(--border);border-left:3px solid var(--teal);border-radius:4px}
    .sci-pt-icon{font-size:20px;flex-shrink:0;margin-top:1px}
    .sci-pt-title{font-family:var(--f-dis);font-size:16px;font-weight:700;margin-bottom:3px}
    .sci-pt-desc{font-size:15px;color:#d0d0d0;line-height:1.55}
    
    /* Who cards — 1 col mobile, 3 col desktop */
    .who-cards{display:flex;flex-direction:column;gap:10px}
    @media(min-width:1024px){
      .science-inner{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}
      .who-cards{margin-top:0}
    }
    .who-card{background:var(--page-bg);border:1px solid var(--border);border-radius:8px;overflow:hidden}
    .wc-header{padding:14px 16px;background: #ea580c1a;border-bottom:1px solid rgba(0,191,168,.15);display:flex;align-items:center;gap:12px}
    .wc-icon{font-size:20px;flex-shrink:0}
    .wc-title{font-family:var(--f-dis);font-size:16px;font-weight:700}
    .wc-sub{font-size:12px;color:#d0d0d0;margin-top:1px}
    .wc-body{padding:12px 16px}
    .wc-benefit{display:flex;align-items:center;gap:10px;font-size:15px;color:#d0d0d0;padding:6px 0;border-bottom:1px solid var(--border)}
    .wc-benefit:last-child{border-bottom:none}
    .wc-benefit::before{content:'→';color:var(--teal);font-size:11px;font-weight:700;flex-shrink:0}
  </style>
  {% schema %}
  {
    "name": "Phasis Electro Science",
    "settings": [
      { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Who It's Built For" },
      { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Anyone who sweats.<br><em>Anyone who trains.</em>" },
      { "type": "textarea", "id": "description", "label": "Description (HTML allowed)", "default": "Mineral depletion doesn't care if you're a professional athlete or someone who goes to the gym three times a week. <strong>Every time you sweat, you lose minerals.</strong>" }
    ],
    "blocks": [
      {
        "type": "science_point",
        "name": "Science point",
        "settings": [
          { "type": "text", "id": "icon", "label": "Icon", "default": "🏋️" },
          { "type": "text", "id": "title", "label": "Title", "default": "Pre-Workout — Prime Your Cells" },
          { "type": "textarea", "id": "desc", "label": "Description", "default": "Mineral loading before training improves cellular hydration and nerve conduction from rep one." }
        ]
      },
      {
        "type": "who_card",
        "name": "Who card",
        "settings": [
          { "type": "text", "id": "icon", "label": "Icon", "default": "🥋" },
          { "type": "text", "id": "title", "label": "Title", "default": "Combat Sports Athletes" },
          { "type": "text", "id": "sub", "label": "Sub title", "default": "BJJ · MMA · Boxing · Wrestling" },
          { "type": "text", "id": "benefit_1", "label": "Benefit 1", "default": "Prevents cramping during extended grappling sessions" },
          { "type": "text", "id": "benefit_2", "label": "Benefit 2", "default": "Faster recovery between hard training days" },
          { "type": "text", "id": "benefit_3", "label": "Benefit 3", "default": "Supports weight cutting and rehydration protocols" }
        ]
      }
    ],
    "max_blocks": 9,
    "presets": [
      {
        "name": "Phasis Electro Science",
        "blocks": [
          { "type": "science_point", "settings": { "icon": "🏋️", "title": "Pre-Workout — Prime Your Cells", "desc": "Mineral loading before training improves cellular hydration and nerve conduction from rep one." } },
          { "type": "science_point", "settings": { "icon": "⚡", "title": "Intra-Training — Sustain Output", "desc": "Replace what you lose in real time. Delay fatigue and cramping mid-session." } },
          { "type": "science_point", "settings": { "icon": "🌙", "title": "Pre-Sleep — Recover Deeper", "desc": "Magnesium drives 300+ enzymatic reactions including muscle repair and sleep regulation." } },
          { "type": "who_card", "settings": { "icon": "🥋", "title": "Combat Sports Athletes", "sub": "BJJ · MMA · Boxing · Wrestling", "benefit_1": "Prevents cramping during extended grappling sessions", "benefit_2": "Faster recovery between hard training days", "benefit_3": "Supports weight cutting and rehydration protocols" } },
          { "type": "who_card", "settings": { "icon": "🏃", "title": "Endurance Athletes", "sub": "Runners · Cyclists · Triathletes", "benefit_1": "Scalable dosing for long vs short efforts", "benefit_2": "No sugar crash mid-race or mid-ride", "benefit_3": "Compatible with any nutrition strategy" } },
          { "type": "who_card", "settings": { "icon": "💼", "title": "Daily High-Performance", "sub": "Anyone who wants to perform at their best", "benefit_1": "Morning mineral load for mental clarity", "benefit_2": "Stress depletes magnesium — Electro+ restores it", "benefit_3": "Better sleep, better recovery, better output" } }
        ]
      }
    ]
  }
  {% endschema %}
  
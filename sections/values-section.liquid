<section class="values-sec section">
  <div class="values-top">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>
      {{ section.settings.heading }}<br>
      <em>{{ section.settings.heading_em }}</em>
    </h2>
  </div>

  <div class="values-list">
    {% for block in section.blocks %}
      <div class="value-item">
        <div class="vi-num">
          {{ forloop.index | prepend: '0' }}
        </div>
        <div class="vi-body">
          <h3 class="vi-title">{{ block.settings.title }}</h3>
          <div class="vi-desc">{{ block.settings.description }}</div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
<style>
    /* ── VALUES ──────────────────────────────────────── */
.values-sec{background:var(--page-bg);border-top:1px solid var(--border)}
.values-top{text-align:center;margin-bottom:24px}
.values-top h2{margin-bottom:12px}

.values-list{display:flex;flex-direction:column;gap:12px}
.value-item{display:grid;grid-template-columns:44px 1fr;gap:16px;align-items:start;padding:16px;background:var(--surface);border:1px solid var(--border);border-radius:8px}
.vi-num{font-family:var(--f-dis);font-size:11px;font-weight:700;color:var(--red);letter-spacing:.12em;padding-top:2px;border:1px solid rgba(232,72,42,.25);border-radius:4px;text-align:center;height:28px;display:flex;align-items:center;justify-content:center}
.vi-body{}
.vi-title{font-family:var(--f-dis);font-size:14px;font-weight:700;margin-bottom:6px}
.vi-desc{font-size:15px;color:#c4c4c4;line-height:1.65}
.eyebrow {
    margin-bottom: 14px;
}

.values-sec h2 {
    font-family: var(--f-dis);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.02em;
    line-height: 1.05;
}

@media (min-width: 768px) {
    .values-sec h2 {
        font-size: 36px;
    }
}

@media (min-width: 1024px) {
    .values-sec h2 {
        font-size: 44px;
    }
}
</style>
{% schema %}
{
  "name": "Values Section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "What We Stand For"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Line 1",
      "default": "The Values We"
    },
    {
      "type": "text",
      "id": "heading_em",
      "label": "Heading Highlight",
      "default": "Won't Compromise On."
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Value Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Write description here..."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Values Section",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}
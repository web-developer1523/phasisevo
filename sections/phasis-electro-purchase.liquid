        { "type": "text", "id": "title", "label": "Title", "default": "30-Day Guarantee" },
        { "type": "text", "id": "desc", "label": "Description", "default": "Full refund. No questions." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Phasis Electro Purchase",
      "blocks": [
        { "type": "size_option", "settings": { "badge": "", "name": "1oz — 30 Servings", "desc": "20 drops = 1 serving. Count your drops.", "price": "$25", "serving_note": "$0.83/serving vs $1.50 LMNT" } },

<style>
  .swiper-wrapper .swiper-slide {
      display: flex;
      justify-content: center;
      align-items: center;
  }
    /* ── PURCHASE ────────────────────────────────────── */
    .purchase-sec{background:var(--surface);border-top:1px solid var(--border)}
    .purchase-visual{height:220px;background: #ea580c1a;border:1px solid var(--orange);display:flex;align-items:center;justify-content:center;font-size:90px;position:relative;overflow:hidden;border-radius:8px;margin-bottom:24px}
    .purchase-visual::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 70% 70% at 50% 40%,rgba(0,191,168,.08) 0%,transparent 70%)}
    @media(min-width:1024px){
      .purchase-inner{display:grid;grid-template-columns:50% 1fr;gap:64px;align-items:start}
      .purchase-visual{height:300px;margin-bottom:0}
    }
    .pi-eyebrow-row{display:flex;align-items:center;gap:10px;margin-bottom:16px}
    .pi-eyebrow-row::before{content:'';width:20px;height:2px;background:var(--teal);flex-shrink:0}
    .pi-eyebrow-row span{font-family:var(--f-mark);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--teal)}
    .pi-h{font-family:var(--f-dis);font-weight:700;font-size:28px;letter-spacing:-0.02em;line-height:1.1;margin-bottom:10px}
    .pi-tagline{font-size:15px;color:#d0d0d0;line-height:1.65;margin-bottom:24px}
    @media(min-width:768px){.pi-h{font-size:36px}}
    .size-label{font-family:var(--f-dis);font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#d0d0d0;margin-bottom:10px;display:block}
    .size-opts{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px}
    .sopt{background:var(--page-bg);border:2px solid var(--border);border-radius:6px;padding:14px 12px;cursor:pointer;transition:all .15s;position:relative;min-height:100px}
    .sopt.sel{border-color:var(--teal);background: #ea580c1a}
    .sopt-name{font-family:var(--f-dis);font-size:13px;font-weight:700;margin-bottom:2px}
    .sopt-desc{font-size:14px;color:#d0d0d0;margin-bottom:8px;line-height:1.4}
    .sopt-price{font-family:var(--f-dis);font-size:18px;font-weight:700}
    .sopt-servings{font-size:12px;color:var(--teal);margin-top:3px}
    .sopt-badge{position:absolute;top:-8px;right:10px;background:var(--teal);color:#000;font-family:var(--f-dis);font-size:9px;font-weight:700;letter-spacing:.06em;padding:2px 8px;border-radius:10px}
    .price-row{display:flex;align-items:baseline;gap:12px;margin-bottom:4px}
    .price-main{font-family:var(--f-dis);font-size:36px;font-weight:800;line-height:1}
    .price-note{font-size:13px;color:#d0d0d0}
    .price-sub{font-size:12px;color:#d0d0d0;margin-bottom:20px}
    .buy-block .btn-t{font-size:15px;padding:18px 24px;margin-bottom:12px}
    .guarantees{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}
    .g-item{background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:6px;padding:12px 10px;text-align:center}
    .g-icon{font-size:18px;margin-bottom:4px}
    .g-title{font-family:var(--f-dis);font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:2px}
    .g-desc{font-size:13px;color:#d0d0d0;line-height:1.4}
    .secure-row{display:flex;align-items:center;justify-content:center;gap:16px;padding-top:14px;border-top:1px solid var(--border);flex-wrap:wrap}
    .secure-item{font-size:14px;color:#d0d0d0;display:flex;align-items:center;gap:4px}
    .secure-item::before{content:'🔒';font-size:10px}

    /* Max Relief upsell */
    .upsell-block{background:rgba(232,72,42,.05);border:1px solid rgba(232,72,42,.2);border-radius:8px;padding:16px;margin-top:16px}
    .upsell-label{font-family:var(--f-dis);font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--coral);margin-bottom:12px}
    .upsell-inner{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .upsell-title{font-family:var(--f-dis);font-size:14px;font-weight:700;margin-bottom:3px}
    .upsell-desc{font-size:12px;color:var(--muted-l)}
    .upsell-btn{flex-shrink:0;display:flex;align-items:center;gap:5px;background:var(--coral);color:#fff;font-family:var(--f-dis);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:10px 14px;border-radius:5px;border:none;cursor:pointer;min-height:44px;white-space:nowrap}
    .upsell-btn::before{content:'●';font-size:6px}

    {% comment %} .main-swiper {
    width: 100%;
    height: 460px; /* desktop */
    overflow: hidden;
    position: relative;
  }

  .main-swiper .swiper-wrapper {
    height: 100%;
  }

  .main-swiper .swiper-slide {
    width: 100% !important;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .main-swiper .swiper-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* mobile */
  @media (max-width: 768px) {
    .main-swiper {
      height: 220px;
    }
  } {% endcomment %}
</style>

<script>
          document.addEventListener("DOMContentLoaded", function () {
        //thumbnailswipper
            const thumbSwiper = new Swiper('.custom-product-thumbnails', {
            slidesPerView: 'auto',
            spaceBetween: 10,
            freeMode: true,
            watchSlidesProgress: true,
            navigation: {
              nextEl: '.swiper-button-next',
              prevEl: '.swiper-button-prev',
            },
            breakpoints: {
              320: { slidesPerView: 3, spaceBetween: 5 },
              768: { slidesPerView: 4, spaceBetween: 10 }
            }
          });
          //min swiper for main image swipe
          const mainSwiper = new Swiper('.main-swiper', {
            slidesPerView: 1,
            speed: 400,
            thumbs: {
              swiper: thumbSwiper
            }
          });

            const variants = window.productVariants;
            if (variants && variants.length > 0) {
              document.querySelector('#selected-variant-id').value = variants[0].id;
            }
            const addToCart = async (variantId) => {
              if (!variantId) return;

              await fetch('/cart/add.js', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                  id: variantId,
                  quantity: 1
                })
              });

              // optional: cart refresh / drawer open
              console.log("Added to cart");
            };

            document.querySelectorAll('.sopt').forEach((opt, index) => {

              opt.addEventListener('click', function () {

                // remove old selection
                document.querySelectorAll('.sopt').forEach(o => o.classList.remove('sel'));
                this.classList.add('sel');

                // UI update
                const priceMain = document.querySelector('.price-main');
                const priceNote = document.querySelector('.price-note');

                const newPrice = this.querySelector('.sopt-price')?.innerText;
                const newNote = this.querySelector('.sopt-servings')?.innerText;

                if (priceMain && newPrice) {
                  priceMain.innerText = newPrice;
                }

                if (priceNote && newNote) {
                  priceNote.innerText = newNote;
                }
          //for variant
             const index = Array.from(document.querySelectorAll('.sopt')).indexOf(this);
    mainSwiper.slideTo(index);

          {% comment %} document.querySelector('#selected-variant-id').value = variantId; {% endcomment %}
           const variantId = this.getAttribute('data-variant-id');

          const input = document.querySelector('#selected-variant-id');

          if (input && variantId) {
            input.value = variantId;
          }

                //  aJAX ADD TO CART HERE
                {% comment %} addToCart(variant.id); {% endcomment %}

              });

            });

          });
          // UPSELL ADD TO CART
        document.querySelectorAll('.upsell-btn').forEach(btn => {
          btn.addEventListener('click', async function (e) {
            e.preventDefault();

            const variantId = this.dataset.upsellVariantId;
            const image = this.dataset.upsellImage;

            if (!variantId) return;

            await fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                id: variantId,
                quantity: 1
              })
            });
       updateCartCount();
            // optional: UI update
            {% comment %} const mainImg = document.getElementById('product-image');
            if (mainImg && image) {
              mainImg.src = image;
              mainImg.srcset = '';
            } {% endcomment %}
          });
        });
        //upshell add button counter update
      function updateCartCount() {
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {

            const count = cart.item_count;

            // number update (visible)
            document.querySelectorAll('.cart-count-bubble span[aria-hidden="true"]')
              .forEach(el => {
                el.textContent = count;
              });

            // accessibility text
            document.querySelectorAll('.cart-count-bubble .visually-hidden')
              .forEach(el => {
                el.textContent = count === 1 ? '1 item' : count + ' items';
              });

            //  optional: hide bubble if 0
            document.querySelectorAll('.cart-count-bubble')
              .forEach(el => {
                el.style.display = count > 0 ? 'flex' : 'none';
              });

          })
          .catch(err => console.error('Cart update error:', err));
      }


  //redirect stop fr add to cart button only
  // STOP FORM REDIRECT + AJAX ADD TO CART
document.querySelectorAll('.buy-form button[type="submit"]').forEach(btn => {
  btn.addEventListener('click', function (e) {
    e.preventDefault(); // stop redirect

    const variantId = document.querySelector('#selected-variant-id')?.value;
    if (!variantId) return;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        id: variantId,
        quantity: 1
      })
    })
    .then(res => res.json())
    .then(() => {
      updateCartCount(); // only counter update
    })
    .catch(err => console.error(err));
  });
});

</script>

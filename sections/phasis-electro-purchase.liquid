        { "type": "guarantee", "settings": { "icon": "🛡️", "title": "30-Day Guarantee", "desc": "Full refund. No questions." } },
        { "type": "guarantee", "settings": { "icon": "🚚", "title": "Free Shipping", "desc": "Orders over $75." } },

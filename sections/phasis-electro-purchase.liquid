<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<section class="purchase-sec section {{section.settings.custom_css_class }}" id="purchase">
  <div class="purchase-inner">
    <div class="purchase-gallery-wrapper gallery-type-{{ section.settings.gallery_type }}">
      <div class="purchase-visual swiper main-swiper">
        {% if section.settings.use_product and section.settings.product != blank %}
          <div class="swiper-wrapper">
            {% for image in section.settings.product.images %}
              <div class="swiper-slide" data-index="{{ forloop.index0 }}">
                <img
                  src="{{ image | image_url: width: 600 }}"
                  alt="{{ section.settings.product.title }}"
                  loading="lazy"
                >
              </div>
            {% endfor %}
          </div>
          {% comment %}
            {% if section.settings.product.featured_image %}
              <img
                id="product-image"
                src="{{ section.settings.product.featured_image | image_url: width: 500 }}"
                alt="{{ section.settings.product.title }}"
                loading="lazy"
              >
            {% endif %}
          {% endcomment %}

        {% elsif section.settings.use_image and section.settings.custom_image != blank %}
          <div class="swiper-slide">
            <img
              src="{{ section.settings.custom_image | image_url: width: 500 }}"
              alt="Custom Image"
              loading="lazy"
            >
          </div>

        {% else %}
          {{ section.settings.visual_emoji }}
        {% endif %}
      </div>

      {% comment %} thumbnail {% endcomment %}
      {% if section.settings.use_product
        and section.settings.product != blank
        and section.settings.gallery_type == 'thumbs_bottom'
      %}
        <div class="custom-product-thumbnails thumbs-bottom swiper">
          <div class="swiper-wrapper">
            {% for image in section.settings.product.images %}
              {% assign image_variant_id = image.variants.first.id %}
              <div
                class="thumb-box swiper-slide {% if forloop.first %}active{% endif %}"
                data-src="{{ image | image_url: width: 600 }}"
                {% if image_variant_id %}
                  data-variant-id="{{ image_variant_id }}"
                {% endif %}
              >
                <img src="{{ image | image_url}}" alt="thumb" loading="lazy">
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
      {% comment %} upshell block start {% endcomment %}
        <div class="upsell-block">
        <div class="upsell-label">{{ section.settings.upsell_label }}</div>
        {% assign upsell_product = section.settings.upsell_product %}
        {% assign upsell_variant = upsell_product.variants | where: 'title', 'Stick — 30ml' | first %}
        <div class="upsell-inner">
          <div class="upsell-content">
            <div class="upsell-icon" bis_skin_checked="1">
              <img
                src="
                  {% if upsell_variant.featured_image %}
                    {{ upsell_variant.featured_image | image_url: width: 100 }}
                  {% else %}
                    {{ upsell_product.featured_image | image_url: width: 100 }}
                  {% endif %}
                "
                alt="{{ upsell_product.title }}"
                loading="lazy"
              >
            </div>
            <div class="upsell-content-details">
              <div class="upsell-title">{{ section.settings.upsell_title }}</div>
              <div class="upsell-desc">{{ section.settings.upsell_desc }}</div>
            </div>
          </div>
          {% assign upsell_product = section.settings.upsell_product %}
          {% assign upsell_variant = upsell_product.variants | where: 'title', 'Stick — 30ml' | first %}
          <a
            href="{{ section.settings.upsell_url }}"
            class="upsell-btn"
            data-upsell-variant-id="{{ upsell_variant.id }}"
            data-upsell-image="{{ upsell_variant.featured_image | image_url: width: 400 }}"
          >
            {{- section.settings.upsell_btn_text -}}
          </a>
        </div>
        {% comment %} second upshell {% endcomment %}
        {% assign upsell_product_2 = section.settings.upsell_product_2 %}
        {% assign upsell_variant_2 = upsell_product_2.variants.first %}

        <div class="upsell-inner">
          <div class="upsell-content">
            <div class="upsell-icon" bis_skin_checked="1">
              <img
                src="
                  {% if upsell_variant_2.featured_image %}
                    {{ upsell_variant_2.featured_image | image_url: width: 100 }}
                  {% else %}
                    {{ upsell_product_2.featured_image | image_url: width: 100 }}
                  {% endif %}
                "
                alt="{{ upsell_product_2.title }}"
                loading="lazy"
              >
            </div>
            <div class="upsell-content-details">
              <div class="upsell-title">{{ section.settings.upsell_title_2 }}</div>
              <div class="upsell-desc">{{ section.settings.upsell_desc_2 }}</div>
            </div>
          </div>
          <a
            href="{{ section.settings.upsell_url }}"
            class="upsell-btn su-btn teal"
            data-upsell-variant-id="{{ upsell_variant_2.id }}"
            data-upsell-image="{{ upsell_variant_2.featured_image | image_url: width: 400 }}"
          >
            {{ section.settings.upsell_btn_text_2 }}
          </a>
        </div>
        {% comment %} end {% endcomment %}
      </div>
       {% comment %} upshell block end {% endcomment %}
    </div>
    {% comment %} end {% endcomment %}
    <div>
      <div class="pi-eyebrow-row">
        <span>{{ section.settings.eyebrow }}</span>
      </div>
      <!-- TITLE -->
      <h2 class="pi-h">
        {% if section.settings.use_product and section.settings.product != blank %}
          {{ section.settings.product.title }}
        {% else %}
          {{ section.settings.heading }}
        {% endif %}
      </h2>
      <!-- TAGLINE -->
      <p class="pi-tagline">
        {% if section.settings.use_product and section.settings.product != blank %}
          {{ section.settings.product.description }}
        {% else %}
          {{ section.settings.tagline }}
        {% endif %}
      </p>
      <span class="size-label">{{ section.settings.size_label }}</span>
      <!-- variants -->
      <div class="size-opts">
        {% for block in section.blocks %}
          {% if block.type == 'size_option' %}
            {% assign product = section.settings.product %}
            {% assign variant = product.variants[forloop.index0] %}
            {% if product == blank %}
              {% assign variant = blank %}
            {% endif %}
            <div
              class="sopt{% if forloop.first %} sel{% endif %}"
              data-variant-id="{{ variant.id }}"
              data-image="{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 600 }}{% else %}{{ section.settings.product.featured_image | image_url: width: 500 }}{% endif %}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.badge != blank %}
                <div class="sopt-badge">{{ block.settings.badge }}</div>
              {% endif %}
              <div class="sopt-name">
                {% if product != blank %}
                  {{ variant.title }}
                {% else -%}
                  {{- block.settings.name -}}
                {%- endif %}
              </div>
              <div class="sopt-desc">{{ block.settings.desc }}</div>
              <div class="sopt-price">
                {% if product != blank %}
                  {{ variant.price | money | replace: '.00', '' }}
                {% else -%}
                  {{- block.settings.price }}
                {% endif %}
              </div>
              <div class="sopt-servings">{{ block.settings.serving_note }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="price-row">
        <div class="price-main">{{ section.settings.price_main }}</div>
        <div class="price-note">{{ section.settings.price_note }}</div>
      </div>
      <div class="price-sub">{{ section.settings.price_sub }}</div>
      <div class="buy-block">

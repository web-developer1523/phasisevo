<section class="purchase-sec section" id="purchase">
  <div class="purchase-inner">
    <div class="purchase-visual">{{ section.settings.visual_emoji }}</div>
    <div>
      <div class="pi-eyebrow-row"><span>{{ section.settings.eyebrow }}</span></div>
      <h2 class="pi-h">{{ section.settings.heading }}</h2>
      <p class="pi-tagline">{{ section.settings.tagline }}</p>
      <span class="size-label">{{ section.settings.size_label }}</span>
      <div class="size-opts">
        {% for block in section.blocks %}
          {% if block.type == 'size_option' %}
            <div class="sopt{% if forloop.first %} sel{% endif %}" {{ block.shopify_attributes }}>
              {% if block.settings.badge != blank %}<div class="sopt-badge">{{ block.settings.badge }}</div>{% endif %}
              <div class="sopt-name">{{ block.settings.name }}</div>
              <div class="sopt-desc">{{ block.settings.desc }}</div>
              <div class="sopt-price">{{ block.settings.price }}</div>
              <div class="sopt-servings">{{ block.settings.serving_note }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="price-row">
        <div class="price-main">{{ section.settings.price_main }}</div>
        <div class="price-note">{{ section.settings.price_note }}</div>
      </div>
      <div class="price-sub">{{ section.settings.price_sub }}</div>
      <div class="buy-block">
        <a href="{{ section.settings.cta_url }}" class="btn btn-t btn-full">{{ section.settings.cta_text }}</a>
        <div class="guarantees mt-4">
          {% for block in section.blocks %}
            {% if block.type == 'guarantee' %}
              <div class="g-item" {{ block.shopify_attributes }}>
                <div class="g-icon">{{ block.settings.icon }}</div>
                <div class="g-title">{{ block.settings.title }}</div>
                <div class="g-desc">{{ block.settings.desc }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="secure-row mt-4">
          <span class="secure-item">{{ section.settings.secure_1 }}</span>
          <span class="secure-item">{{ section.settings.secure_2 }}</span>
          <span class="secure-item">{{ section.settings.secure_3 }}</span>
        </div>
      </div>
      <div class="upsell-block">
        <div class="upsell-label">{{ section.settings.upsell_label }}</div>
        <div class="upsell-inner">
          <div>
            <div class="upsell-title">{{ section.settings.upsell_title }}</div>
            <div class="upsell-desc">{{ section.settings.upsell_desc }}</div>
          </div>
          <a href="{{ section.settings.upsell_url }}" class="upsell-btn">{{ section.settings.upsell_btn_text }}</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  /* ── PURCHASE ────────────────────────────────────── */
  .purchase-sec{background:var(--surface);border-top:1px solid var(--border)}
  .purchase-visual{height:220px;background:linear-gradient(135deg,#060e0c,#0a1614);border:1px solid rgba(0,191,168,.15);display:flex;align-items:center;justify-content:center;font-size:90px;position:relative;overflow:hidden;border-radius:8px;margin-bottom:24px}
  .purchase-visual::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 70% 70% at 50% 40%,rgba(0,191,168,.08) 0%,transparent 70%)}
  @media(min-width:1024px){
    .purchase-inner{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}
    .purchase-visual{height:460px;margin-bottom:0}
  }
  .pi-eyebrow-row{display:flex;align-items:center;gap:10px;margin-bottom:16px}
  .pi-eyebrow-row::before{content:'';width:20px;height:2px;background:var(--teal);flex-shrink:0}
  .pi-eyebrow-row span{font-family:var(--f-mark);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--teal)}
  .pi-h{font-family:var(--f-dis);font-weight:700;font-size:28px;letter-spacing:-0.02em;line-height:1.1;margin-bottom:10px}
  .pi-tagline{font-size:14px;color:var(--muted-l);line-height:1.65;margin-bottom:24px}
  @media(min-width:768px){.pi-h{font-size:36px}}
  .size-label{font-family:var(--f-dis);font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:10px;display:block}
  .size-opts{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px}
  .sopt{background:var(--page-bg);border:2px solid var(--border);border-radius:6px;padding:14px 12px;cursor:pointer;transition:all .15s;position:relative;min-height:100px}
  .sopt.sel{border-color:var(--teal);background:rgba(0,191,168,.06)}
  .sopt-name{font-family:var(--f-dis);font-size:13px;font-weight:700;margin-bottom:2px}
  .sopt-desc{font-size:11px;color:var(--muted);margin-bottom:8px;line-height:1.4}
  .sopt-price{font-family:var(--f-dis);font-size:18px;font-weight:700}
  .sopt-servings{font-size:10px;color:var(--teal);margin-top:3px}
  .sopt-badge{position:absolute;top:-8px;right:10px;background:var(--teal);color:#000;font-family:var(--f-dis);font-size:9px;font-weight:700;letter-spacing:.06em;padding:2px 8px;border-radius:10px}
  .price-row{display:flex;align-items:baseline;gap:12px;margin-bottom:4px}
  .price-main{font-family:var(--f-dis);font-size:36px;font-weight:800;line-height:1}
  .price-note{font-size:13px;color:var(--muted)}
  .price-sub{font-size:12px;color:var(--muted);margin-bottom:20px}
  .buy-block .btn-t{font-size:15px;padding:18px 24px;margin-bottom:12px}
  .guarantees{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}
  .g-item{background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:6px;padding:12px 10px;text-align:center}
  .g-icon{font-size:18px;margin-bottom:4px}
  .g-title{font-family:var(--f-dis);font-size:9px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:2px}
  .g-desc{font-size:10px;color:var(--muted);line-height:1.4}
  .secure-row{display:flex;align-items:center;justify-content:center;gap:16px;padding-top:14px;border-top:1px solid var(--border);flex-wrap:wrap}
  .secure-item{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:4px}
  .secure-item::before{content:'🔒';font-size:10px}
  
  /* Max Relief upsell */
  .upsell-block{background:rgba(232,72,42,.05);border:1px solid rgba(232,72,42,.2);border-radius:8px;padding:16px;margin-top:16px}
  .upsell-label{font-family:var(--f-dis);font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--coral);margin-bottom:12px}
  .upsell-inner{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .upsell-title{font-family:var(--f-dis);font-size:14px;font-weight:700;margin-bottom:3px}
  .upsell-desc{font-size:12px;color:var(--muted-l)}
  .upsell-btn{flex-shrink:0;display:flex;align-items:center;gap:5px;background:var(--coral);color:#fff;font-family:var(--f-dis);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:10px 14px;border-radius:5px;border:none;cursor:pointer;min-height:44px;white-space:nowrap}
  .upsell-btn::before{content:'●';font-size:6px}
</style>
{% schema %}

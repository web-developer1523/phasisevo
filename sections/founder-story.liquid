<section class="phasis-founder" id="founder-story">
  
  <div class="phasis-founder__container">

    <!-- ─── PHOTO COLUMN ───────────────────────────────────────── -->
    <div class="phasis-founder__photo-wrap">
      <div class="phasis-founder__photo">
        {% if section.settings.founder_photo %}
          <img
            src="{{ section.settings.founder_photo | img_url: '800x' }}"
            alt="Founder photo"
          >
        {% else %}
          <div class="phasis-founder__photo--empty">
            <span>Founder photo</span>
            <span class="spec">
              4:5 portrait · 800×1000 min<br>
              dark/moody · 3/4 length
            </span>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- ─── CONTENT COLUMN ─────────────────────────────────────── -->
    <div class="phasis-founder__content">

      <p class="phasis-founder__eyebrow">
        {{ section.settings.eyebrow }}
      </p>

      <h2 class="phasis-founder__headline">
        {{ section.settings.headline }}
      </h2>

      <div class="phasis-founder__body">
        {{ section.settings.founder_story }}
      </div>

      <!-- ─── SIGNATURE ───────────────────────────────────────── -->
      <div class="phasis-founder__signature">

        {% if section.settings.founder_signature %}
          <img 
            src="{{ section.settings.founder_signature | img_url: '600x' }}"
            alt="Signature"
            class="phasis-founder__signature-img"
          />
        {% else %}
          <div class="phasis-founder__signature-script">
            {{ section.settings.founder_name }}
          </div>
        {% endif %}

        <div class="phasis-founder__signature-name">
          {{ section.settings.founder_name }}
        </div>

        <div class="phasis-founder__signature-meta">
          {{ section.settings.founder_meta }}
        </div>

      </div>

      <!-- ─── CTA ─────────────────────────────────────────────── -->
      <a href="{{ section.settings.cta_link }}" class="phasis-founder__cta">
        {{ section.settings.cta_text }}
        <span aria-hidden="true">→</span>
      </a>

    </div> 

  </div> 

</section>

<style>
  /* ─── Font imports (skip if already loaded in theme.liquid) ─────────── */
  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=DM+Sans:wght@300;400;500;600&family=Caveat:wght@500;600&display=swap');

  /* ─── Scoped reset ─────────────────────────────────────────────────── */
  .phasis-founder,
  .phasis-founder * {
    box-sizing: border-box;
  }

  /* ─── Section container ────────────────────────────────────────────── */
  .phasis-founder {
    background: #0A0A0A;
    padding: 120px 24px;
    color: #ffffff;
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    position: relative;
  }

  /* ─── Section bookends — entry + exit transitions ──────────────────── */
  .phasis-founder::before,
  .phasis-founder::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 64px;
    background: linear-gradient(to bottom, transparent, rgba(239, 68, 68, 0.4), transparent);
  }
  .phasis-founder::before { top: 0; }
  .phasis-founder::after  { bottom: 0; }

  .phasis-founder__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  /* ─── Photo column ─────────────────────────────────────────────────── */
  .phasis-founder__photo-wrap {
    position: sticky;
    top: 96px;
  }

  .phasis-founder__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 8px;
    overflow: hidden;
    background: #1a1a1a;
    border: 0.5px solid rgba(255, 255, 255, 0.08);
  }

  .phasis-founder__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Placeholder shown if no image yet — remove once photo is in */
  .phasis-founder__photo--empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: rgba(255, 255, 255, 0.32);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    padding: 20px;
  }

  .phasis-founder__photo--empty .spec {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.22);
    letter-spacing: 0.04em;
    line-height: 1.6;
  }

  /* ─── Content column ───────────────────────────────────────────────── */
  .phasis-founder__content {
    max-width: 580px;
  }

  /* Eyebrow — Conthrax Italic if loaded sitewide, else mono fallback */
  .phasis-founder__eyebrow {
    font-family: 'Conthrax', ui-monospace, "SF Mono", Menlo, "Courier New", monospace;
    font-style: italic;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #DC2626;
    text-shadow: 0 0 10px rgba(239, 68, 68, 0.5);
    margin: 0 0 18px;
  }

  /* H2 hook — Sora 600 */
  .phasis-founder__headline {
    font-family: 'Sora', -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-size: 44px;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.012em;
    color: #ffffff;
    margin: 0 0 36px;
  }

  /* Headline accent — single italic red turn-word */
  .phasis-founder__headline .accent {
    color: #DC2626;
    font-style: italic;
    font-weight: 600;
  }

  /* Body copy — DM Sans 400 */
  .phasis-founder__body p {
    font-family: 'DM Sans', sans-serif;
    font-size: 17px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
    margin: 0 0 22px;
  }

  .phasis-founder__body p:last-child {
    margin-bottom: 0;
  }

  /* Pull-quote blockquotes — Sora 500, red border + glow */
  .phasis-founder__body blockquote {
    margin: 36px 0;
    padding: 6px 0 6px 22px;
    border-left: 2px solid #DC2626;
    box-shadow: -2px 0 12px rgba(239, 68, 68, 0.28);
    font-family: 'Sora', sans-serif;
    font-size: 23px;
    line-height: 1.4;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -0.005em;
  }

  .phasis-founder__body blockquote p {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    margin: 0;
  }

  /* ─── Signature — handwritten image (primary) or script fallback ───── */
  .phasis-founder__signature {
    margin: 48px 0 36px;
    padding-top: 28px;
    border-top: 0.5px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Actual handwritten signature image — preferred treatment */
  .phasis-founder__signature-img {
    height: 80px;
    width: auto;
    max-width: 360px;
    opacity: 0.95;
    display: block;
    margin-left: -6px; /* visually align signature start with text edge */
  }

  /* Script font fallback — used until Jonathan's signature is uploaded */
  .phasis-founder__signature-script {
    font-family: 'Caveat', 'Brush Script MT', cursive;
    font-size: 38px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1;
    letter-spacing: 0.005em;
  }

  /* Typed name — editorial pairing with signature mark */
  .phasis-founder__signature-name {
    font-family: 'Sora', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.01em;
    margin-top: 4px;
  }

  .phasis-founder__signature-meta {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-style: italic;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.01em;
  }

  /* CTA button — Sora SemiBold, uppercase */
  .phasis-founder__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 15px 26px;
    background: #DC2626;
    color: #ffffff;
    text-decoration: none;
    font-family: 'Sora', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 6px;
    box-shadow:
      0 0 18px rgba(239, 68, 68, 0.4),
      0 0 36px rgba(239, 68, 68, 0.15);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .phasis-founder__cta:hover {
    transform: translateY(-1px);
    box-shadow:
      0 0 24px rgba(239, 68, 68, 0.6),
      0 0 48px rgba(239, 68, 68, 0.22);
  }

  /* ─── Mobile (≤ 768px) ─────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .phasis-founder {
      padding: 72px 20px;
    }

    .phasis-founder::before,
    .phasis-founder::after {
      height: 48px;
    }

    .phasis-founder__container {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .phasis-founder__photo-wrap {
      position: static;
    }

    .phasis-founder__photo {
      max-width: 320px;
      margin: 0 auto;
    }

    .phasis-founder__content {
      max-width: 100%;
    }

    .phasis-founder__headline {
      font-size: 30px;
      margin-bottom: 28px;
    }

    .phasis-founder__body p {
      font-size: 16px;
    }

    /* Mobile glow boost — shadows that read subtly at desktop scale
       are nearly invisible at 375px. Bump intensity. */
    .phasis-founder__body blockquote {
      font-size: 20px;
      margin: 28px 0;
      padding-left: 18px;
      box-shadow: -2px 0 14px rgba(239, 68, 68, 0.42);
    }

    .phasis-founder__eyebrow {
      text-shadow: 0 0 12px rgba(239, 68, 68, 0.65);
    }

    .phasis-founder__cta {
      box-shadow:
        0 0 20px rgba(239, 68, 68, 0.5),
        0 0 40px rgba(239, 68, 68, 0.18);
    }

    .phasis-founder__signature-script {
      font-size: 32px;
    }

    .phasis-founder__signature-img {
      height: 64px;
    }
  }
</style>

{% schema %}
{
  "name": "Founder Story",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "founder_photo",
      "label": "Founder portrait",
      "info": "Recommended: 4:5 portrait, 1200×1500 min"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "— THE FOUNDER"
    },
    {
      "type": "html",
      "id": "headline",
      "label": "Headline",
    },
    {
      "type": "html",
      "id": "founder_story",
      "label": "Founder Story Content"
    },
    {
      "type": "image_picker",
      "id": "founder_signature",
      "label": "Handwritten signature"
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder Name",
      "default": "Jonathan Ross-Turcios"
    },
    {
      "type": "text",
      "id": "founder_meta",
      "label": "Founder Title",
      "default": "Founder, PHASIS"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Take the phase scan"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Founder Story"
    }
  ]
}
{% endschema %}

<section class="featured-section">
  <div class="section-label">{{ section.settings.heading }}</div>
  <div class="featured-grid">

    {% assign blog = blogs[section.settings.blog] %}
    
    {% for article in blog.articles limit: section.settings.post_limit %}

    <a href="{{ article.url }}" 
       class="jcard {% if forloop.first %}jcard-large{% endif %}" 
       style="text-decoration:none;display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden;transition:border-color .2s">

      <div class="jcard-img" style="height:{% if forloop.first %}350px{% else %}200px{% endif %};background:var(--surface2);overflow:hidden;flex-shrink:0">
        
        {% if article.image %}
          <img src="{{ article.image | image_url: width: 800 }}" 
               alt="{{ article.title }}" 
               style="width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s ease">
        {% endif %}

      </div>

      <div class="jcard-body" style="padding:18px 20px;display:flex;flex-direction:column;flex:1">

        <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
          
          {% if article.tags.size > 0 %}
            <span style="font-family:var(--f-dis);font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--red);background:rgba(255,255,255,.05);border:1px solid var(--border2);border-radius:4px;padding:3px 8px">
              {{ article.tags.first }}
            </span>
          {% endif %}

          <span style="font-size:11px;color:var(--muted)">
            {{ article.published_at | date: "%b %d, %Y" }}
          </span>
        </div>

        <h3 style="font-family:var(--f-dis);font-size:{% if forloop.first %}20px{% else %}16px{% endif %};font-weight:700;letter-spacing:-.01em;line-height:1.3;color:var(--off-white);margin-bottom:10px;flex:1">
          {{ article.title }}
        </h3>

        <p style="font-size:15px;color:#d0d0d0;line-height:1.7;margin-bottom:14px">
           {{ article.excerpt | strip_html | truncate: 120 }} 
           {% comment %} {% if article.excerpt != blank %}
  {{ article.excerpt | strip_html | truncate: 120 }}
{% else %}
  {{ article.content | strip_html | truncate: 120 }}
{% endif %} {% endcomment %}
        </p>

        <div style="display:flex;align-items:center;justify-content:space-between">
          <span style="font-family:var(--f-dis);font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)">
            {{ article.author }}
          </span>
          <span style="font-family:var(--f-dis);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--red)">
            READ →
          </span>
        </div>

      </div>
    </a>

    {% endfor %}

  </div>
</section>
<style>
    /* ── FEATURED SECTION ───────────────────────────────────── */
.featured-section {
  padding:48px var(--pad);
  border-bottom:1px solid var(--border);
}
@media(min-width:768px){.featured-section{padding:64px var(--pad-md)}}
@media(min-width:1024px){.featured-section{padding:72px var(--pad-lg)}}

.section-label {
  font-family:var(--f-dis);
  font-size:10px;
  font-weight:700;
  letter-spacing:.18em;
  text-transform:uppercase;
  color:var(--muted);
  margin-bottom:24px;
  display:flex;
  align-items:center;
  gap:10px;
}
.section-label::after {
  content:'';
  flex:1;
  height:1px;
  background:var(--border);
}

/* Featured grid */
.featured-grid {
  display:grid;
  grid-template-columns:1fr;
  gap:16px;
}
@media(min-width:640px){
  .featured-grid {
    grid-template-columns:1fr 1fr;
  }
  .featured-grid .jcard:first-child {
    grid-column:1 / -1;
  }
}
@media(min-width:1024px){
  .featured-grid {
    grid-template-columns:1.6fr 1fr;
    grid-template-rows:auto auto;
  }
  .featured-grid .jcard:first-child {
    grid-column:1;
    grid-row:1 / 3;
  }
  .featured-grid .jcard:not(:first-child) {
    grid-column:2;
  }
}

/* Card hover effects */
.jcard:hover {
  border-color:var(--border2) !important;
}
.jcard:hover .jcard-img img {
  transform:scale(1.03);
}
</style>
{% schema %}
{
  "name": "Journal Blog Posts",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Recent Posts"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Number of posts",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Journal Blog Posts"
    }
  ]
}
{% endschema %}
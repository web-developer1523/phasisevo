{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}

<div id="wholesale-form" class="contact-form">
  <div class="container">
    <div class="contact-form__container contact-form__container--{{ section.settings.content_align }}">
      {% if template == 'page.contact' %}
        <nav
          id="breadcrumbs"
          class="breadcrumb"
          role="navigation"
          aria-label="breadcrumbs"
        >
          <a
            href="{{ routes.root_url }}"
            title="{{ 'general.breadcrumbs.home' | t }}"
            class="focus-inset"
          >
            {{- 'general.breadcrumbs.home' | t -}}
          </a>
          <div class="breadcrumb__delimiter">
            {% render 'icon-caret' %}
          </div>
          <span>{{ page.title }}</span>
        </nav>
      {% endif %}
      <div class="wholesale-form__inner">
        <div class="">
          {%- if section.settings.heading != blank -%}
            {% assign heading_tag = section.settings.heading_tag %}
            <{{ heading_tag }} class="contact-form__title {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </{{ heading_tag }}>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="contact-form__text">
              {{ section.settings.text }}
            </p>
          {%- endif -%}
          {%- form 'contact', id: 'ContactForm', class: 'wholesale-form' -%}
            {% comment %} {%- if form.posted_successfully? -%}
              <div class="form-status form-status-list form__message" tabindex="-1" autofocus>
                {% render 'icon-success' %}
                {{ 'templates.contact.form.post_success' | t }}
              </div>
            {%- elsif form.errors -%}
            {%- endif -%} {% endcomment %}
            {%- if form.posted_successfully? -%}
              <div class="wholesale-form__success">
                <h5>Thank you for applying to become a FASE Wholesale Partner</h5>
                <p>Our team will review your application and get back to you within 2–3 business days.</p>
                <p>For urgent inquiries, please contact <a href="mailto:Sales@naturalperformance.co">Sales@naturalperformance.co</a></p>
              </div>
            {%- else -%}
            <h5>Business Information</h5>
            <div class="fields_wrapper">
              <div class="field field-third">
                <input
                  class="field__input focus-inset"
                  autocomplete="business_name"
                  type="text"
                  dir="ltr"
                  id="ContactForm-business_name"
                  name="contact[business_name]"
                  value="{% if form.business_name %}{{ form.business_name }}{% elsif customer %}{{ customer.business_name }}{% endif %}"
                  placeholder="Business Name"
                  required
                >
                <label
                  class="field__label"
                  for="ContactForm-business_name"
                  placeholder="Business Name"
                >
                  Business Name
                </label>
              </div>
              <div class="field field-third">
                <select
                  class="field__input focus-inset"
                  autocomplete="business_type"
                  type="text"
                  dir="ltr"
                  id="ContactForm-business_type"
                  name="contact[business_type]"
                  value="{% if form.business_type %}{{ form.business_type }}{% elsif customer %}{{ customer.business_type }}{% endif %}"
                  placeholder="Business Type"
                  required
                >
                  <option value="retail_store">Retail Store</option>
                  <option value="online_store">Online Store</option>
                  <option value="distributor">Distributor</option>
                  <option value="clinic_wellness_center">Clinic / Wellness Center</option>
                  <option value="gym_training_facility">Gym / Training Facility</option>
                  <option value="other">Other</option>
                </select>
                <label
                  class="field__label"
                  for="ContactForm-business_type"
                  placeholder="Business Type"
                >
                  Business Type
                </label>
              </div>
              <div class="field field-third">
                <input
                  class="field__input focus-inset"
                  autocomplete="website_url"
                  type="text"
                  dir="ltr"
                  id="ContactForm-website_url"
                  name="contact[website_url]"
                  value="{% if form.website_url %}{{ form.website_url }}{% elsif customer %}{{ customer.website_url }}{% endif %}"
                  placeholder="Website / Online Store"
                >
                <label
                  class="field__label"
                  for="ContactForm-website_url"
                  placeholder="Website / Online Store"
                >
                  Website / Online Store
                </label>
              </div>
              <div class="field">
                <input
                  class="field__input focus-inset"
                  autocomplete="business_address"
                  type="text"
                  dir="ltr"
                  id="ContactForm-business_address"
                  name="contact[business_address]"
                  value="{% if form.business_address %}{{ form.business_address }}{% elsif customer %}{{ customer.business_address }}{% endif %}"
                  placeholder="Business Address"
                  required
                >
                <label
                  class="field__label"
                  for="ContactForm-business_address"
                  placeholder="Business Address"
                >
                  Business Address
                </label>
              </div>
              {% comment %} <div class="field">
                <input
                  class="field__input focus-inset"
                  autocomplete="business_address"
                  type="text"
                  dir="ltr"
                  id="ContactForm-business_address"
                  name="contact[business_address]"
                  value="{% if form.business_address %}{{ form.business_address }}{% elsif customer %}{{ customer.business_address }}{% endif %}"
                  placeholder="Business Address"
                  required
                >
                <label
                  class="field__label"
                  for="ContactForm-business_address"
                  placeholder="Business Address"
                >
                  City, State, ZIP, Country
                </label>
              </div> {% endcomment %}
              <div class="field field-half">
                <input
                  class="field__input focus-inset"
                  autocomplete="city"
                  type="text"
                  dir="ltr"
                  id="ContactForm-city"
                  name="contact[city]"
                  value="{% if form.city %}{{ form.city }}{% elsif customer %}{{ customer.city }}{% endif %}"
                  placeholder="City"
                  required
                >
                <label
                  class="field__label"
                  for="ContactForm-city"
                  placeholder="City"
                >
                  City
                </label>
              </div>
              <div class="field field-half">
                <input
                  class="field__input focus-inset"
                  autocomplete="state_province"
                  type="text"
                  dir="ltr"
                  id="ContactForm-state_province"
                  name="contact[state_province]"
                  value="{% if form.state_province %}{{ form.state_province }}{% elsif customer %}{{ customer.state_province }}{% endif %}"
                  placeholder="State / Province"
                  required
                >
                <label
                  class="field__label"
                  for="ContactForm-state_province"
                  placeholder="State / Province"
                >
                  State / Province
                </label>
              </div>
              <div class="field field-half">
                <input
                  class="field__input focus-inset"
                  autocomplete="zip_postal_code"
                  type="text"
                  dir="ltr"
                  id="ContactForm-zip_postal_code"
                  name="contact[zip_postal_code]"
                  value="{% if form.zip_postal_code %}{{ form.zip_postal_code }}{% elsif customer %}{{ customer.zip_postal_code }}{% endif %}"
                  placeholder="ZIP / Postal Code"
                  required
                >
                <label
                  class="field__label"
                  for="ContactForm-zip_postal_code"
                  placeholder="ZIP / Postal Code"
                >
                  ZIP / Postal Code
                </label>
              </div>
              <div class="field field-half">
                <select
                  class="field__input focus-inset"
                  autocomplete="country"
                  type="text"
                  dir="ltr"
                  id="ContactForm-country"
                  name="contact[country]"
                  value="{% if form.country %}{{ form.country }}{% elsif customer %}{{ customer.country }}{% endif %}"
                  placeholder="Country"
                  required
                >
                  {% render 'country_list_option' %}
                </select>
                <label
                  class="field__label"
                  for="ContactForm-business_type"
                  placeholder="Business Type"
                >
                  Country
                </label>
              </div>
            </div>

            <hr/>
            <h5>Contact Information</h5>
            <div class="fields_wrapper">
              <div class="field field-third">
                <input
                  class="field__input focus-inset"
                  autocomplete="first_name"
                  type="text"
                  dir="ltr"
                  id="ContactForm-first_name"
                  name="contact[first_name]"
                  value="{% if form.first_name %}{{ form.first_name }}{% elsif customer %}{{ customer.first_name }}{% endif %}"
                  placeholder="First Name"
                  required
                >
                <label
                  class="field__label"
                  for="ContactForm-first_name"
                  placeholder="First Name"
                >
                  First Name
                </label>
              </div>
              <div class="field field-third">
                <input
                  class="field__input focus-inset"
                  autocomplete="last_name"
                  type="text"
                  dir="ltr"
                  id="ContactForm-last_name"
                  name="contact[last_name]"
                  value="{% if form.last_name %}{{ form.last_name }}{% elsif customer %}{{ customer.last_name }}{% endif %}"
                  placeholder="Last Name"
                  required
                >
                <label
                  class="field__label"
                  for="ContactForm-last_name"
                  placeholder="Last Name"
                >
                  Last Name
                </label>
              </div>
              {% comment %} <div class="field field-half">
                <input
                  class="field__input focus-inset"
                  autocomplete="full_name"
                  type="text"
                  dir="ltr"
                  id="ContactForm-full_name"
                  name="contact[full_name]"
                  value="{% if form.full_name %}{{ form.full_name }}{% elsif customer %}{{ customer.full_name }}{% endif %}"
                  placeholder="Full Name",
                  required
                >
                <label
                  class="field__label"
                  for="ContactForm-full_name"
                  placeholder="Full Name"
                >
                  Full Name
                </label>
              </div> {% endcomment %}
              <div class="field field--with-error field-third">
                <input
                  autocomplete="email"
                  type="email"
                  dir="ltr"
                  id="ContactForm-email"
                  class="field__input focus-inset"
                  name="contact[email]"
                  spellcheck="false"
                  autocapitalize="off"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  aria-required="true"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="ContactForm-email-error"
                  {% endif %}
                  placeholder="Email"
                  required
                >
                <label
                  class="field__label"
                  for="ContactForm-email"
                  placeholder="Email"
                >
                  Email
                </label>
                {%- if form.errors contains 'email' -%}
                  <small class="contact-form__field-error" id="ContactForm-email-error">
                    <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                    <span class="form__message">
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </span>
                  </small>
                {%- endif -%}
              </div>
              <div class="field field-half">
                <input
                  type="tel"
                  dir="ltr"
                  id="ContactForm-phone"
                  class="field__input"
                  autocomplete="tel"
                  name="contact[phone]"
                  pattern="[0-9\-]*"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  placeholder="Phone Number"
                  required
                >
                <label
                  class="field__label"
                  for="ContactForm-phone"
                  placeholder="Phone Number"
                >
                  Phone Number
                </label>
              </div>
              <div class="field field-half">
                <select
                  class="field__input focus-inset"
                  autocomplete="preferred_contact_method"
                  type="text"
                  dir="ltr"
                  id="ContactForm-preferred_contact_method"
                  name="contact[preferred_contact_method]"
                  value="{% if form.preferred_contact_method %}{{ form.preferred_contact_method }}{% elsif customer %}{{ customer.preferred_contact_method }}{% endif %}"
                  placeholder="Preferred Contact Method"
                >
                  <option value="email">Email</option>
                  <option value="phone">Phone</option>
                  <option value="either">Either</option>
                </select>
                <label
                  class="field__label"
                  for="ContactForm-preferred_contact_method"
                  placeholder="Preferred Contact Method"
                >
                  Preferred Contact Method
                </label>
              </div>
            </div>

            <hr/>
            <h5>Business Details</h5>
            <div class="fields_wrapper">
              <div class="field">
                <select
                  class="field__input focus-inset"
                  autocomplete="how_long_been_in_business"
                  type="text"
                  dir="ltr"
                  id="ContactForm-preferred_contact_method"
                  name="contact[how_long_been_in_business]"
                  value="{% if form.how_long_been_in_business %}{{ form.how_long_been_in_business }}{% elsif customer %}{{ customer.how_long_been_in_business }}{% endif %}"
                  placeholder="How long have you been in business?"
                >
                  <option value="under_1_year">Under 1 year</option>
                  <option value="1_3_years">1–3 years</option>
                  <option value="3_5_years">3–5 years</option>
                  <option value="5_years">5+ years</option>
                </select>
                <label
                  class="field__label"
                  for="ContactForm-how_long_been_in_business"
                  placeholder="How long have you been in business?"
                >
                  How long have you been in business?
                </label>
              </div>
              <div class="field field-half">
                <select
                  class="field__input focus-inset"
                  autocomplete="do_you_currently_carry_other_wellness_or_supplement_brands"
                  type="text"
                  dir="ltr"
                  id="ContactForm-preferred_contact_method"
                  name="contact[do_you_currently_carry_other_wellness_or_supplement_brands]"
                  value="{% if form.do_you_currently_carry_other_wellness_or_supplement_brands %}{{ form.do_you_currently_carry_other_wellness_or_supplement_brands }}{% elsif customer %}{{ customer.do_you_currently_carry_other_wellness_or_supplement_brands }}{% endif %}"
                  placeholder="Do you currently carry other wellness or supplement brands?"
                >
                  <option value="yes">Yes</option>
                  <option value="no">No</option>
                </select>
                <label
                  class="field__label"
                  for="ContactForm-do_you_currently_carry_other_wellness_or_supplement_brands"
                  placeholder="Do you currently carry other wellness or supplement brands?"
                >
                  Do you currently carry other wellness or supplement brands?
                </label>
              </div>
              <div class="field field-half other_wellness">
                <input
                  class="field__input focus-inset"
                  autocomplete="if_yes_which_ones"
                  type="text"
                  dir="ltr"
                  id="ContactForm-if_yes_which_ones"
                  name="contact[if_yes_which_ones]"
                  value="{% if form.if_yes_which_ones %}{{ form.if_yes_which_ones }}{% elsif customer %}{{ customer.if_yes_which_ones }}{% endif %}"
                  placeholder="If yes, which ones?"
                >
                <label
                  class="field__label"
                  for="ContactForm-if_yes_which_ones"
                  placeholder="If yes, which ones?"
                >
                  If yes, which ones?
                </label>
              </div>
              <div class="field">
                <select
                  class="field__input focus-inset"
                  autocomplete="estimated_monthly_order_volume"
                  type="text"
                  dir="ltr"
                  id="ContactForm-preferred_contact_method"
                  name="contact[estimated_monthly_order_volume]"
                  value="{% if form.estimated_monthly_order_volume %}{{ form.estimated_monthly_order_volume }}{% elsif customer %}{{ customer.estimated_monthly_order_volume }}{% endif %}"
                  placeholder="Estimated Monthly Order Volume"
                >
                  <option value="under_1000">Under $1,000</option>
                  <option value="1000_5000">$1,000–$5,000</option>
                  <option value="5000_10000">$5,000–$10,000</option>
                  <option value="over_10000">Over $10,000</option>
                </select>
                <label
                  class="field__label"
                  for="ContactForm-estimated_monthly_order_volume"
                  placeholder="Estimated Monthly Order Volume"
                >
                  Estimated Monthly Order Volume
                </label>
              </div>
              <div class="field">
                <span
                  class="field__label"
                >
                  Where do you plan to sell FASE products?
                </span>
                <div class="field_radio_group_item">
                  <input type="radio" name="contact[where_to_sell_fase_products]" value="in_store" id="in_store">
                  <label for="in_store">In-Store</label>
                </div>
                <div class="field_radio_group_item">
                  <input type="radio" name="contact[where_to_sell_fase_products]" value="online" id="online">
                  <label for="online">Online</label>
                </div>
                <div class="field_radio_group_item">
                  <input type="radio" name="contact[where_to_sell_fase_products]" value="both" id="both">
                  <label for="both">Both</label>
                </div>
              </div>
            </div>

            <hr/>
            <h5>Resale Documentation</h5>
            <div class="fields_wrapper">
              <div class="field">
                <input
                  class="field__input focus-inset"
                  autocomplete="reseller_permit_or_tax_id_number"
                  type="text"
                  dir="ltr"
                  id="ContactForm-reseller_permit_or_tax_id_number"
                  name="contact[reseller_permit_or_tax_id_number]"
                  value="{% if form.reseller_permit_or_tax_id_number %}{{ form.reseller_permit_or_tax_id_number }}{% elsif customer %}{{ customer.reseller_permit_or_tax_id_number }}{% endif %}"
                  placeholder="Reseller Permit or Tax ID Number"
                >
                <label
                  class="field__label"
                  for="ContactForm-reseller_permit_or_tax_id_number"
                  placeholder="Reseller Permit or Tax ID Number"
                >
                  Reseller Permit or Tax ID Number
                </label>
              </div>
              <div class="field">
                <input
                  class="field__input focus-inset"
                  autocomplete="upload_business_license_or_resale_certificate"
                  type="file"
                  dir="ltr"
                  id="ContactForm-upload_business_license_or_resale_certificate"
                  name="contact[upload_business_license_or_resale_certificate]"
                  placeholder="Upload Business License or Resale Certificate"
                >
                <label
                  class="field__label"
                  for="ContactForm-upload_business_license_or_resale_certificate"
                  placeholder="Upload Business License or Resale Certificate"
                >
                  Upload Business License or Resale Certificate
                </label>
              </div>
            </div>

            <hr/>
            <h5>Additional Notes</h5>
            <div class="fields_wrapper">
              <div class="field other_wellness">
                <textarea
                  class="field__input focus-inset"
                  autocomplete="business_description"
                  type="text"
                  dir="ltr"
                  id="ContactForm-business_description"
                  name="contact[business_description]"
                  value="{% if form.business_description %}{{ form.business_description }}{% elsif customer %}{{ customer.business_description }}{% endif %}"
                ></textarea>
                <label
                  class="field__label"
                  for="ContactForm-business_description"
                >
                  Tell us briefly about your business or how you plan to carry FASE products:
                </label>
              </div>
            </div>

            <hr/>
            <h5>Acknowledgment</h5>
            <div class="fields_wrapper acknowledgment_checkbox">
              <div class="field">
                <input type="checkbox" class="field__input" name="contact[acknowledgment]" id="acknowledgment" required>
                <label
                  class="field__label"
                  for="acknowledgment"
                  placeholder="I confirm that the information provided is accurate and that I am authorized to apply for a wholesale account on behalf of this business."
                >
                  I confirm that the information provided is accurate and that I am authorized to apply for a wholesale account on behalf of this business.
                </label>
              </div>
            </div>

            <div class="contact-form__bottom">
              <button
                type="submit"
                class="button button--secondary	focus-inset	dot_active"
                data-button-text="Apply for Wholesale Access"
              >
                <span>Apply for Wholesale Access</span>
              </button>

              {% if section.settings.additional_text != blank %}
                <div class="contact-form__add-text">
                  {{ section.settings.additional_text }}
                </div>
              {% endif %}
            </div>
            {% endif %}
          {%- endform -%}
        </div>

        {% if section.settings.image != blank %}
          {% capture style %}
            {% if section.settings.image_ratio != 'adapt' %}
              --aspect-ratio: {{ section.settings.image_ratio }};
            {% elsif section.settings.image_ratio == 'adapt' %}
              --aspect-ratio: {{section.settings.image.aspect_ratio }};
            {% endif %}
          {% endcapture %}
          {% capture sizes %}
            (min-width: 750px) 600px, 
            calc(100vw - 20px)
          {% endcapture %}
          {{
            section.settings.image
            | image_url: width: section.settings.image.width
            | image_tag: 
              loading: 'lazy', 
              widths: '375, 600, 750, 990, 1200, 1400, 1600',
              class: "contact-form__image",
              style: style,
              sizes: sizes
          }} 
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wholesale Form",
  "tag": "section",
  "class": "spaced-section contact-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "select",
      "id": "content_align",
      "label": "t:sections.contact-form.settings.content_align.label",
      "options": [
        {
        "value": "left",
        "label": "t:sections.contact-form.settings.content_align.options_1.label"
        },
        {
        "value": "center",
        "label": "t:sections.contact-form.settings.content_align.options_2.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_options.header.content"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "t:sections.contact-form.settings.heading.default",
      "label": "t:sections.all.heading.label"
    },
        {
			"type": "select",
			"id": "heading_tag",
			"label": "t:sections.all.heading.tag",
			"options": [
				{
					"value": "h1",
					"label": "H1"
				},
				{
					"value": "h2",
					"label": "H2"
				},
				{
					"value": "h3",
					"label": "H3"
				},
				{
					"value": "h4",
					"label": "H4"
				},
				{
					"value": "h5",
					"label": "H5"
				},
				{
					"value": "h6",
					"label": "H6"
				},
				{
					"value": "div",
					"label": "div"
				},
				{
					"value": "p",
					"label": "p"
				},
				{
					"value": "span",
					"label": "span"
				}
			],
			"default": "h2"
		},
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "text",
      "default": "t:sections.contact-form.settings.text.default",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "inline_richtext",
      "id": "additional_text",
      "default": "t:sections.contact-form.settings.additional_text.default",
      "label": "t:sections.contact-form.settings.additional_text.label"
    },
    {
			"type": "header",
			"content": "t:sections.all.image.header.content"
		},
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
			"type": "select",
			"id": "image_ratio",
			"default": "16/9",
			"label": "t:sections.all.image.aspect_ratio.label",
			"options": [
				{
					"value": "1/1",
					"label": "t:sections.all.image.aspect_ratio.options__1.label"
				},
				{
					"value": "3/2",
					"label": "t:sections.all.image.aspect_ratio.options__2.label"
				},

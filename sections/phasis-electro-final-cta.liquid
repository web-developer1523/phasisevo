<section class="final-cta section {{ section.settings.custom_css_class }}">
  <span class="fc-eyebrow">{{ section.settings.eyebrow }}</span>
  <h2 class="fc-h">{{ section.settings.heading }}</h2>
  <p class="fc-p">{{ section.settings.text }}</p>
  <div class="fc-cta">
    <a
      href="
        {% if section.settings.button_url != blank %}
            {{ section.settings.button_url }}
        {% elsif section.settings.section_id != blank %}
            #{{ section.settings.section_id }}
        {% else %}
            #
        {% endif %}
      "
      class="btn btn-t btn-full"
    >
      {{ section.settings.button_text }}
    </a>
    <div class="fc-trust">
      <p><span class="highlight_tick">✔</span> {{ section.settings.trust_1 }}</p>
      <p><span class="highlight_tick">✔</span> {{ section.settings.trust_2 }}</p>
      <p><span class="highlight_tick">✔</span> {{ section.settings.trust_3 }}</p>
    </div>
  </div>
</section>
<style>
    /* ── FINAL CTA ───────────────────────────────────── */
    .final-cta {
      background: var(--surface);
      border-top: 1px solid var(--border);
      text-align: center;
      position: relative;
      overflow: hidden;
      padding: 48px var(--pad);
   }

   @media (min-width: 768px) {
    .final-cta {
        padding: 64px var(--pad-md);
    }
  }

  @media (min-width: 1024px) {
    .final-cta {
        padding: 80px var(--pad-lg);
    }
  }

    .final-cta::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 50% at 50% 100%,rgba(0,191,168,.07) 0%,transparent 55%);pointer-events:none}
    .fc-eyebrow{display:block;font-family:var(--f-mark);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--coral);margin-bottom:14px;position:relative;z-index:1}
    .fc-h {
    z-index: 1;
    font-family: 'Sora',sans-serif;
    font-weight: 800;
    font-size: clamp(28px,6vw,44px);
    letter-spacing: -.025em;
    line-height: .95;
    margin-bottom: 12px;
    position: relative;
  }
    .fc-h em{color:var(--coral);font-style:normal}
    .fc-p{font-size:15px;font-weight:300;color:var(--muted-l);line-height:1.7;max-width:500px;margin:0 auto 28px;position:relative;z-index:1}
    .fc-cta{display:flex;flex-direction:column;align-items:center;gap:12px;position:relative;z-index:1}
    .fc-btn{max-width:360px}
    .fc-trust{display:flex;align-items:center;gap:20px;flex-wrap:wrap;justify-content:center}
    .fc-trust span{font-size:14px;color:#d0d0d0}

</style>
{% schema %}
{
  "name": "Phasis Electro Final CTA",
  "settings": [
      { "type": "text", "id": "custom_css_class", "label": "Custom CSS Class"},
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Start Hydrating Right" },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (HTML)",
      "default": "Your Water Isn't<br><em>Working Hard Enough.</em>"
    },
    {
      "type": "html",
      "id": "text",
      "label": "Text (HTML)",
      "default": "50+ trace minerals. Zero sugar. Liquid drops - works in any drink. <strong>70%</strong> less per serving than leading powders. Backed by a 30-day guarantee."
    },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "GET ELECTRO+ — FROM $25" },
    { "type": "url", "id": "button_url", "label": "Button URL" },
    { "type": "text", "id": "section_id", "label": "Section Button Id" },
    { "type": "text", "id": "trust_1", "label": "Trust text 1", "default": "30-day money-back guarantee" },
    { "type": "text", "id": "trust_2", "label": "Trust text 2", "default": "Free shipping $75+" },
    { "type": "text", "id": "trust_3", "label": "Trust text 3", "default": "Free shipping $75+" }
  ],
  "presets": [{ "name": "Phasis Electro Final CTA" }]
}
{% endschema %}

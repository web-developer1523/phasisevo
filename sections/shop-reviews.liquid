<!-- ============================================ -->
<!-- REVIEWS SECTION                              -->
<!-- ============================================ -->
{% comment %}
  Reviews Section
  - Displays average rating and individual review cards.
{% endcomment %}

<section class="reviews-sec section">
    <div class="rs-header">
      <div class="rs-score">
        <div class="rs-big">{{ section.settings.rating_value }}</div>
        <div>
          <div class="rs-stars">{{ section.settings.star_rating }}</div>
          <div class="rs-label">{{ section.settings.rating_label }}</div>
        </div>
      </div>
      <a href="{{ section.settings.all_reviews_link }}" class="btn btn-s" style="width:auto;padding:10px 16px;font-size:11px;min-height:44px">{{ section.settings.all_reviews_text }}</a>
    </div>
    <div class="reviews-grid">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <div class="mini-rev">
            <div class="mr-stars">{{ block.settings.stars }}</div>
            <div class="mr-q">"{{ block.settings.quote }}"</div>
            <div class="mr-name">{{ block.settings.name }}</div>
            <div class="mr-meta">{{ block.settings.meta }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>
  <style>
    /* ── REVIEWS ─────────────────────────────────────── */
    .reviews-sec{background:var(--surface);border-top:1px solid var(--border)}
    .rs-header{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px;flex-wrap:wrap}
    .rs-score{display:flex;align-items:center;gap:16px}
    .rs-big{font-family:var(--f-dis);font-size:40px;font-weight:800;line-height:1}
    .rs-stars{color:var(--coral);font-size:14px;letter-spacing:2px}
    .rs-label{font-size:11px;color:var(--muted);margin-top:3px}
    .reviews-grid{display:grid;grid-template-columns:1fr;gap:10px}
    @media(min-width:600px){.reviews-grid{grid-template-columns:1fr 1fr}}
    @media(min-width:1024px){.reviews-grid{grid-template-columns:repeat(3,1fr)}}
    .mini-rev{background:var(--page-bg);border:1px solid var(--border);border-radius:6px;padding:16px}
    .mr-stars{color:var(--coral);font-size:11px;margin-bottom:10px}
    .mr-q{font-size:13px;font-style:italic;color:var(--muted-l);line-height:1.65;margin-bottom:12px}
    .mr-name{font-family:var(--f-dis);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
    .mr-meta{font-size:10px;color:var(--muted);margin-top:2px}
    
  </style>
  {% schema %}
  {
    "name": "Reviews",
    "settings": [
      {
        "type": "text",
        "id": "rating_value",
        "label": "Rating value",
        "default": "4.9"
      },
      {
        "type": "text",
        "id": "star_rating",
        "label": "Star rating (HTML or text)",
        "default": "★★★★★"
      },
      {
        "type": "text",
        "id": "rating_label",
        "label": "Rating label",
        "default": "Verified buyers · All products"
      },
      {
        "type": "text",
        "id": "all_reviews_text",
        "label": "All reviews button text",
        "default": "ALL REVIEWS"
      },
      {
        "type": "url",
        "id": "all_reviews_link",
        "label": "All reviews link"
      }
    ],
    "blocks": [
      {
        "type": "review",
        "name": "Review",
        "settings": [
          {
            "type": "text",
            "id": "stars",
            "label": "Stars (HTML or text)",
            "default": "★★★★★"
          },
          {
            "type": "textarea",
            "id": "quote",
            "label": "Quote",
            "default": "I have disc disease and have tried everything. This is the only thing that actually works. The relief is almost immediate."
          },
          {
            "type": "text",
            "id": "name",
            "label": "Name",
            "default": "Megan T."
          },
          {
            "type": "text",
            "id": "meta",
            "label": "Meta info",
            "default": "Max Relief · Recovery & Soreness"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Reviews",
        "blocks": [
          { "type": "review" },
          { "type": "review" },
          { "type": "review" }
        ]
      }
    ]
  }
  {% endschema %}
  
<section class="how-sec {{ section.settings.custom_css_class }}">

  <div class="how-hdr">
    <div>
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">
          {{ section.settings.eyebrow }}
        </span>
      {% endif %}

      <h2 class="sec-title">
        {{ section.settings.heading }} <em>{{ section.settings.heading_emphasis }}</em>
      </h2>
    </div>

    {% if section.settings.subtext != blank %}
      <p>
        {{ section.settings.subtext }}
      </p>
    {% endif %}
  </div>

  <div class="how-grid">
    {% for block in section.blocks %}
      {% if block.type == 'step' %}

        <div class="hwc">

          <div class="hwc-n">
            {{ block.settings.number }}
          </div>

          <h4>
            {{ block.settings.title }}
          </h4>

          <p>
            {{ block.settings.description }}
          </p>

          {% if block.settings.tag != blank %}
            <div class="hwc-tag">
              {{ block.settings.tag }}
            </div>
          {% endif %}

        </div>

      {% endif %}
    {% endfor %}
  </div>

</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [
      {
      "type": "text",
      "id": "custom_css_class",
      "label": "Custom CSS Class"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "4-Pathway"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading Emphasis",
      "default": "Relief System"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Sub Text",
      "default": "Most topicals work one way. Max Relief works four — simultaneously."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Step Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Step description goes here."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Optional Tag"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "01",
            "title": "Nerve Block",
            "description": "Lidocaine HCl blocks sodium channels, stopping pain signals before they register. Fast onset, targeted numbing.",
            "tag": "Pharmaceutical-Grade · OTC Active"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Counterirritant",
            "description": "Menthol delivers immediate cooling. Capsaicin follows with warming that desensitizes pain receptors over repeated use.",
            "tag": "Cooling → Warming → Desensitizing"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "Anti-Inflammatory",
            "description": "Full Spectrum CBD modulates the endocannabinoid system. Arnica reduces swelling. Turmeric + Black Pepper maximizes bioactivity.",
            "tag": "CBD · Arnica · Turmeric Synergy"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "04",
            "title": "Circulation",
            "description": "Clary Sage Extract promotes circulation and muscle relaxation. Improved blood flow accelerates tissue recovery.",
            "tag": "Clary Sage · Blood Flow Support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
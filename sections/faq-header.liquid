<div class="faq-header {{section.settings.custom_css }}">
  <span class="fh-eyebrow">
    {{ section.settings.eyebrow }}
  </span>

  <h1 class="fh-title">
    {{ section.settings.title_line_1 }} <br>
    <em>{{ section.settings.title_highlight }}</em>
  </h1>

  <p class="fh-sub">
    {{ section.settings.description }}
    {% if section.settings.email != blank %}
      <br>
      <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
    {% endif %}
  </p>

  <div class="search-wrap">
    <span class="search-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </span>

    <input 
      class="search-input" 
      id="faq-search" 
      type="text" 
      placeholder="{{ section.settings.placeholder }}"
      oninput="searchFaqs(this.value)"
    >
  </div>
</div>
<style>
    /* ── PAGE HEADER ─────────────────────────────────── */
.fh-sub br {
    display: none;
}
.fh-sub a {
    color: var(--red);
}
.faq-header{background:var(--surface);border-bottom:1px solid var(--border);padding:40px var(--pad) 32px;position:relative;overflow:hidden}
.faq-header::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 100% 50%,rgba(232,72,42,.04) 0%,transparent 60%);pointer-events:none}
.fh-eyebrow{font-family:var(--f-mark);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--red);display:block;margin-bottom:12px;position:relative}
.fh-title{font-family:var(--f-dis);font-weight:800;font-size:clamp(30px,5vw,48px);letter-spacing:-0.025em;line-height:.95;margin-bottom:14px;position:relative}
.fh-title em{color:var(--red);font-style:normal}
.fh-sub{font-size:15px;font-weight:300;color:#d0d0d0;line-height:1.7;max-width:520px;position:relative}
@media(min-width:768px){.faq-header{padding:56px var(--pad-md) 40px}}
@media(min-width:1024px){.faq-header{padding:72px var(--pad-lg) 48px}}

/* Search bar */
.search-wrap{position:relative;margin-top:24px;max-width:520px}
.search-input{width:100%;background:var(--page-bg);border:1px solid var(--border2);border-radius:8px;color:var(--off-white);font-family:var(--f-body);font-size:14px;padding:14px 16px 14px 44px;outline:none;transition:border-color .15s;min-height:52px}
.search-input:focus{border-color:var(--coral)}
.search-input::placeholder{color:var(--muted)}
.search-icon{position:absolute;left:16px;top:50%;transform:translateY(-50%);color:var(--muted);pointer-events:none;line-height: 0;}
.search-icon svg{width:16px;height:16px;}

</style>
<script>
window.searchFaqs = function(searchTerm) {
  const term = searchTerm.trim().toLowerCase();
  const faqItems = document.querySelectorAll('.faq-item');

  faqItems.forEach(item => {
    const questionTextElem = item.querySelector('.faq-q-text');
    if (!questionTextElem) return;

    const questionText = questionTextElem.textContent.toLowerCase();

    if (term !== '' && questionText.includes(term)) {
      // Show matching question & open it
      item.style.display = '';  // Ensure visible (optional, since no hide)
      item.classList.add('open');
    } else {
      // Close non-matching questions but keep visible
      item.classList.remove('open');
      item.style.display = '';
    }
  });

  // Optionally show/hide no-results if none matched
  const noResults = document.getElementById('no-results');
  if (noResults) {
    const anyMatch = Array.from(faqItems).some(item => 
      item.querySelector('.faq-q-text')?.textContent.toLowerCase().includes(term)
    );
    noResults.style.display = anyMatch || term === '' ? 'none' : 'block';
  }
};
</script>
{% schema %}
{
  "name": "FAQ Header",
  "tag": "section",
  "class": "faq-header-section",
  "settings": [
      {
      "type": "text",
      "id": "custom_css",
      "label": "Custom CSS Class"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Top Small Text",
      "default": "Help Center"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Main Title Line 1",
      "default": "Frequently"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Highlighted Text",
      "default": "Asked Questions"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Everything you need to know about our products, ordering, and policies. Can't find what you're looking for?"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support Email",
      "default": "support@example.com"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search Placeholder",
      "default": "Search questions..."
    }
  ],
  "presets": [
    {
      "name": "FAQ Header"
    }
  ]
}
{% endschema %}
{{ 'custom-tabs.css' | asset_url | stylesheet_tag }}

{%- style -%}
    {% render 'section-margin' %}
    {% render 'section-header' %}
{%- endstyle -%}

{% capture product_details_table %}
    {% assign product_details = product.metafields.custom.product_details %}
    <div class="product_details_table_wrap">
        <table class="product_details_table">
        {% for item in product_details.value %}
            <tr>
                <td class="product_details_title">{{ item.title }}</td>
                <td class="product_details_value">{{ item.value }}</td>
            </tr>
        {% endfor %}
        </table>
    </div>
{% endcapture %}

<div class="custom_tabs cst-new-tabs">
    <div class="container">
        {% if section.settings.heading != blank or section.settings.content != blank %}
        <div class="custom_tabs__heading">
            <{{ section.settings.section_heading_tag }} class="custom_tabs__heading_title {{ section.settings.heading_size }} {% if section.settings.subheading == blank %}margin-none{% endif %}">
                {{ section.settings.heading }}
            </{{ section.settings.section_heading_tag }}>
            <div class="custom_tabs__content">
                {{ section.settings.content }}
            </div>
        </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
        <div class="custom_tabs__tabs">
            <div class="custom_tabs__title_list">
                {% for block in section.blocks %}
                    <div class="custom_tabs__title_item">
                        {{ block.settings.tab_title }}
                    </div>
                {% endfor %}
            </div>
            <div class="custom_tabs__content_list">
                {% for block in section.blocks %}
                    <div class="custom_tabs__content_accordion">
                        <div class="custom_tabs__title_accordion">
                            {{ block.settings.tab_title }}
                            <i class="open">-</i>
                            <i class="close">+</i>
                        </div>
                        {% liquid
                            assign tab_content = block.settings.tab_content

                            if tab_content contains '[product_details]'
                                assign tab_content = tab_content | replace: '[product_details]', product_details_table | remove: '<p>' | remove: '</p>'
                            endif
                        %}


                        <div class="custom_tabs__content_item">
                            <div class="custom_tabs__content_item_inner">
                                {{ tab_content }}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>
</div>

<script>
  class CustomTabs {
    constructor(container) {
      this.container = container;
      this.tabTitles = container.querySelectorAll('.custom_tabs__title_item');
      this.tabContents = container.querySelectorAll('.custom_tabs__content_item');
      this.accordionTitles = container.querySelectorAll('.custom_tabs__title_accordion');
      this.accordionWrappers = container.querySelectorAll('.custom_tabs__content_accordion');
      this.init();
    }

    init() {
      this.initTabs();
      this.initAccordion();
      this.handleResize();
      window.addEventListener('resize', () => this.handleResize());
    }

    handleResize() {
      if (window.innerWidth >= 768) {
        this.showTab(0);
      } else {
        this.closeAllAccordions();
      }
    }

    initTabs() {
      if (this.tabTitles.length === 0 || this.tabContents.length === 0) return;
      
      if (window.innerWidth >= 768) {
        this.showTab(0);
      }

      this.tabTitles.forEach((title, index) => {
        title.addEventListener('click', () => {
          if (window.innerWidth >= 768) {
            this.showTab(index);
          }
        });
      });
    }

    initAccordion() {
      if (this.accordionTitles.length === 0) return;

      this.accordionTitles.forEach((title, index) => {
        title.addEventListener('click', () => {
          if (window.innerWidth < 768) {
            this.toggleAccordion(index);
          }
        });
      });
    }

    showTab(index) {
      this.tabTitles.forEach((title, i) => {
        title.classList.toggle('active', i === index);
      });

      this.tabContents.forEach((content, i) => {
        content.classList.toggle('active', i === index);
      });
    }

    toggleAccordion(index) {
      const wrapper = this.accordionWrappers[index];
      const isActive = wrapper.classList.contains('active');
      
      wrapper.classList.toggle('active', !isActive);
    }

    closeAllAccordions() {
      this.accordionWrappers.forEach(wrapper => {
        wrapper.classList.remove('active');
      });
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.custom_tabs').forEach(container => {
      new CustomTabs(container);
    });
  });
</script>


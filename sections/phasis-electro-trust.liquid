<section class="trust-bar">
    {% for block in section.blocks %}
      <div class="tb" {{ block.shopify_attributes }}>
        {% case block.settings.icon %}
          {% when 'shield' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          {% when 'clock' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {% when 'grid' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          {% when 'plane' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        {% endcase %}
        {{ block.settings.text }}
      </div>
    {% endfor %}
  </section>
  <style>
        /* ── TRUST BAR ───────────────────────────────────── */
        .trust-bar{background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
        .trust-bar::-webkit-scrollbar{display:none}
        .tb{display:flex;align-items:center;gap:6px;font-family:var(--f-dis);font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#d0d0d0;padding:12px 20px;border-right:1px solid var(--border);flex-shrink:0;white-space:nowrap}
        .tb:last-child{border-right:none}
        .tb svg{color:var(--teal);width:12px;height:12px;flex-shrink:0}
  </style>
  {% schema %}
  {
    "name": "Phasis Electro Trust",
    "settings": [],
    "blocks": [
      {
        "type": "item",
        "name": "Trust item",
        "settings": [
          {
            "type": "select",
            "id": "icon",
            "label": "Icon",
            "default": "shield",
            "options": [
              { "value": "shield", "label": "Shield" },
              { "value": "clock", "label": "Clock" },
              { "value": "grid", "label": "Grid" },
              { "value": "plane", "label": "Plane" }
            ]
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "3RD PARTY TESTED"
          }
        ]
      }
    ],
    "max_blocks": 8,
    "presets": [
      {
        "name": "Phasis Electro Trust",
        "blocks": [
          { "type": "item", "settings": { "icon": "shield", "text": "3RD PARTY TESTED" } },
          { "type": "item", "settings": { "icon": "clock", "text": "ZERO SUGAR EVER" } },
          { "type": "item", "settings": { "icon": "grid", "text": "MADE IN USA" } },
          { "type": "item", "settings": { "icon": "clock", "text": "30-DAY GUARANTEE" } },
          { "type": "item", "settings": { "icon": "plane", "text": "FREE SHIPPING $75+" } }
        ]
      }
    ]
  }
  {% endschema %}
  
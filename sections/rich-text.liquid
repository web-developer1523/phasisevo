{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-margin' %}
  {% render 'section-header' %}
{%- endstyle -%}

<div
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id }}"
  {% endif %}
  class="rich-text container  cst-utm-new {{ section.settings.custom_css_class }} cst-new-spc"
>
  <div class="rich-text__wrapper rich-text__wrapper--{{ section.settings.section_layout }}">
    <div class="rich-text__title">
      {% if section.settings.subheading != blank %}
        <div class="rich-text__subheading {% if section.settings.dot %}rich-text__subheading_dot{% endif %} subheading {% if section.settings.heading == blank %}margin-none{% endif %}">
          {{ section.settings.subheading | escape }}
        </div>
      {% endif %}
      {% comment %}
        {% if section.settings.heading != blank %}
          {% assign section_heading_tag = section.settings.section_heading_tag %}
          <{{ section_heading_tag }} class="rich-text__heading {{ section.settings.heading_size }} {% if section.settings.subheading == blank %}margin-none{% endif %}">
            {{ section.settings.heading }}
          </{{ section_heading_tag }}>
        {% endif %}
      {% endcomment %}
     {% comment %} {% if section.settings.heading != blank %}
  {% assign section_heading_tag = section.settings.section_heading_tag %}
  <{{ section_heading_tag }} class="rich-text__heading {{ section.settings.heading_size }} {% if section.settings.subheading == blank %}margin-none{% endif %}">
    
   {{ section.settings.heading | replace: "fast", '<span class="new_txt">fast.</span>' }}

  </{{ section_heading_tag }}>
{% endif %} {% endcomment %}
 {% if section.settings.heading != blank %}
  {% assign section_heading_tag = section.settings.section_heading_tag %}
  <{{ section_heading_tag }} class="rich-text__heading {{ section.settings.heading_size }} {% if section.settings.subheading == blank %}margin-none{% endif %}">

    {% assign heading_html = section.settings.heading | replace: "fast", '<span class="new_txt">fast.</span>' %}

     {% if template.name == 'index' %}
      {% assign heading_html = heading_html | replace: "Evolve.", '<span class="home_txt">Evolve.</span>' %}
    {% endif %}

    {{ heading_html }}

  </{{ section_heading_tag }}>
{% endif %}
      {% if section.settings.heading_2 != blank %}
        <div class="rich-text__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading_2 }}
        </div>
      {% endif %}
    </div>
    {% if section.settings.text != blank %}
      <div class="rich-text__text">
        {{ section.settings.text }}
      </div>
    {% endif %}
    {% if section.settings.button_label != blank or section.settings.button_label_2 != blank %}
      <div class="rich-text__buttons">
        {% if section.settings.button_label != blank %}
         {%- assign first_link = '' -%}

    {%- if section.settings.button_link != blank -%}
      {%- assign first_link = section.settings.button_link -%}
    {%- elsif section.settings.first_section_id != blank -%}
      {%- assign first_link = '#' | append: section.settings.first_section_id -%}
    {%- endif -%}
          {% render 'button',
            btn_label: section.settings.button_label,
            btn_link: first_link,
            btn_style: section.settings.button_style,
            button_dot: section.settings.button_dot,
            add_classes: 'rich-text__button focus-inset glow-cta'
          %}
        {%- endif -%}
        {% if section.settings.button_label_2 != blank %}
             {%- assign second_link = '' -%}

    {%- if section.settings.button_link_2 != blank -%}
      {%- assign second_link = section.settings.button_link_2 -%}
    {%- elsif section.settings.second_section_id != blank -%}
      {%- assign second_link = '#' | append: section.settings.second_section_id -%}
    {%- endif -%} 
          {% render 'button',
            btn_label: section.settings.button_label_2,
            btn_link: second_link,
            btn_style: section.settings.button_style_2,
            button_dot: section.settings.button_dot_2,
            add_classes: 'rich-text__button focus-inset'
          %}
        {%- endif -%}
      </div>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <div class="rich-text__text cst-item">
        {% for block in section.blocks %}
          {% if block.type == 'guarantee' %}
            <p><span class="highlight_tick">✔</span> {{ block.settings.text }}</p>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "tag": "section",
  "class": "spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "text",
      "id": "custom_css_class",
      "label": "Custom CSS Class"
    },
    {
      "type": "select",
      "id": "section_layout",
      "default": "row",
      "label": "t:sections.rich-text.settings.section_layout.label",
      "options": [
        {
          "value": "row",
          "label": "t:sections.rich-text.settings.section_layout.options.options__1.label"
        },
        {
          "value": "column",
          "label": "t:sections.rich-text.settings.section_layout.options.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.content_options.header.content"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "t:sections.rich-text.settings.subheading.default",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "t:sections.rich-text.settings.heading.default",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading 2"
    },
    {
      "type": "select",
      "id": "section_heading_tag",
      "label": "t:sections.all.heading.tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "div",
          "label": "div"
        },
        {
          "value": "p",
          "label": "p"
        },
        {
          "value": "span",
          "label": "span"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "checkbox",
      "id": "dot",
      "default": true,
      "label": "t:sections.all.section-header.dot.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.all.text.label",
      "default": "t:sections.rich-text.settings.text.default"
    },
    {
      "type": "header",
      "content": "t:sections.all.button.header_button.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "t:sections.rich-text.settings.button.label",
      "label": "t:sections.all.button.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.all.button.button_link.label"
    },
    {
  "type": "text",
  "id": "first_section_id",
  "label": "First Button Section ID",
  "default": "purchase"
},
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "checkbox",
      "id": "button_dot",
      "default": true,
      "label": "t:sections.all.button.button_dot.label"
    },
    {
      "type": "header",
      "content": "Second Button"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second Button Label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second Button Link"
    },
    {
  "type": "text",
  "id": "second_section_id",
  "label": "Second Button ID",
  "default": "purchase"
},
    {
      "type": "select",
      "id": "button_style_2",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "tertiary", "label": "Tertiary" }
      ],
      "default": "secondary",
      "label": "Second Button Style"
    },
    {
      "type": "checkbox",
      "id": "button_dot_2",
      "default": true,
      "label": "Show Dot on Second Button"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "s",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "s",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Add a unique ID to the section to use in JavaScript"
    }
  ],
  "blocks": [
    {
      "type": "guarantee",
      "name": "Guarantee Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "30-day guarantee"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich-text.presets.name",
      "blocks": [
        { "type": "guarantee", "settings": { "text": "30-day guarantee" } },
        { "type": "guarantee", "settings": { "text": "Free shipping $75+" } },
        { "type": "guarantee", "settings": { "text": "No subscription" } }
      ]
    }
  ]
}
{% endschema %}

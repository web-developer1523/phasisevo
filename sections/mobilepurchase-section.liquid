  </script>
{% endcomment %}
<script>
   document.addEventListener("DOMContentLoaded", function () {
      //min swiper for main image swipe
      const thumbSwiper = new Swiper('.thumbs-bottom', {
      slidesPerView: 4,
      spaceBetween: 10,
      watchSlidesProgress: true,
    });
        const mainSwiper = new Swiper('.main-swiper', {
          slidesPerView: 1,
          speed: 400,
           thumbs: {
            swiper: thumbSwiper
          }
        });
  let selectedVariantId = null;
  const btn = document.getElementById('ajax-add-to-cart');
  const mainImgElement = document.getElementById('main-product-image');

  // Handle variant selection
  document.querySelectorAll('.sopt').forEach((opt) => {
    opt.addEventListener('click', function () {
      // Toggle Classes
      document.querySelectorAll('.sopt').forEach((o) => o.classList.remove('sel'));
      this.classList.add('sel');

      // Update Price and Note
      document.getElementById('price-display').innerText = this.dataset.price;
      document.getElementById('note-display').innerText = this.dataset.note;

      // FIX 1: Update Image
      {% comment %} const newImgUrl = this.getAttribute('data-img');
      if (newImgUrl && mainImgElement) {
         mainImgElement.src = newImgUrl;
      } {% endcomment %}
      const slideIndex = this.dataset.slideIndex;
      if (slideIndex !== undefined) {
        mainSwiper.slideTo(parseInt(slideIndex));
      }

      // FIX 2: Update Variant ID
      selectedVariantId = this.dataset.variantId;
      btn.value = selectedVariantId;
      btn.disabled = false;
    });
  });

  // Default Select on Load
  document.addEventListener('DOMContentLoaded', () => {
    const firstSel = document.querySelector('.sopt.sel');
    if (firstSel) {
      selectedVariantId = firstSel.dataset.variantId;
      btn.value = selectedVariantId;
      btn.disabled = false;
      
      // Load initial image if exists
      if(firstSel.dataset.img && mainImgElement) {
        mainImgElement.src = firstSel.dataset.img;
      }
    }
  });

  // Ajax Add to Cart (Main Button)
  btn.addEventListener('click', function () {
    const idToAdd = this.value || selectedVariantId;
    if (!idToAdd) {
      alert('Please select a variant');
      return;
    }


    btn.disabled = true;

    let formData = {
     'items': [{ 'id': idToAdd, 'quantity': 1 }]
    };

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    })
     .then(() => {
    updateCartCount();
  })
    {% comment %} .then(response => {
      window.location.href = '/cart';
    }) {% endcomment %}
    .catch((error) => {
      console.error('Error:', error);
      btn.innerText = 'ADD TO CART';
      btn.disabled = false;
    });
  });
//update counter
function updateCartCount() {
  fetch('/cart.js')
    .then(res => res.json())
    .then(cart => {
      const count = cart.item_count;

      const visibleCount = document.querySelector('.cart-count-bubble span[aria-hidden="true"]');
      const hiddenText = document.querySelector('.cart-count-bubble .visually-hidden');
      const bubble = document.querySelector('.cart-count-bubble');

      if (visibleCount) visibleCount.innerText = count;
      if (hiddenText) hiddenText.innerText = `${count} items`;
      if (bubble) bubble.style.display = count > 0 ? 'flex' : 'none';
    });
}
  // Upsell add button for  Add to Cart functionality
  document.querySelectorAll('.su-btn').forEach((upsellBtn) => {
    upsellBtn.addEventListener('click', function (e) {
      e.preventDefault();
      const vId = this.getAttribute('data-variant-id');
      if (!vId) return;

      let formData = {
       'items': [{ 'id': vId, 'quantity': 1 }]
      };

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData)
      })
      .then(() => {
        updateCartCount();
      })
      .catch(() => {
        alert('Error adding upsell');
        this.innerText = 'ADD';
      });
    });
  });
});
</script>
{% schema %}
{
  "name": "Purchase Section",
  "settings": [
    { "type": "text", "id": "custom_css_class", "label": "Custom CSS Class" },
    { "type": "text", "id": "section_id", "label": "Section ID", "default": "purchase" },

    { "type": "checkbox", "id": "use_product", "label": "Use Shopify Product", "default": false },
    { "type": "product", "id": "product", "label": "Select Product" },


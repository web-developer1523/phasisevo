<!-- ============================================ -->
<!-- PRODUCT GRID SECTION                         -->
<!-- ============================================ -->
{% comment %}
  Product Grid Section
  - Displays product cards with full details.
  - Each product card is a block with customizable content.
  - Supports badges, images, features, and buttons.
{% endcomment %}

<div class="shop-main">
    <div class="products-grid" id="products-grid">
      {% for block in section.blocks %}
        {% if block.type == 'product' %}
          <div class="product-card {% if block.settings.featured %}featured{% endif %} {% if block.settings.coming_soon %}soon{% endif %}" data-cat="{{ block.settings.category }}">
            <div class="card-badge">
              {% if block.settings.badge_text != blank %}
                <span class="badge badge-{{ block.settings.badge_type }}">{{ block.settings.badge_text }}</span>
              {% endif %}
            </div>
            <div class="card-img" style="background:{{ block.settings.bg_gradient }}">
              <div class="card-img-glow" style="background:{{ block.settings.glow_color }}"></div>
              <div class="card-img-emoji">{{ block.settings.emoji }}</div>
            </div>
            <div class="card-body">
              <div class="card-cat" style="color:{{ block.settings.category_color }}">{{ block.settings.category_text }}</div>
              <div class="card-name">{{ block.settings.product_name }}</div>
              <div class="card-tagline">{{ block.settings.tagline }}</div>
              <div class="card-features">
                {% for i in (1..4) %}
                  {% assign feature = "feature_" | append: i %}
                  {% if block.settings[feature] != blank %}
                    <div class="cf {{ block.settings.feature_color_class }}">{{ block.settings[feature] }}</div>
                  {% endif %}
                {% endfor %}
              </div>
              <div class="card-footer">
                <div>
                  <div class="card-price">{{ block.settings.price }}</div>
                  {% if block.settings.price_sub != blank %}
                    <div class="card-price-sub">{{ block.settings.price_sub }}</div>
                  {% endif %}
                </div>
                <a href="{{ block.settings.button_link }}" class="btn btn-{{ block.settings.button_style }}">{{ block.settings.button_text }}</a>
              </div>
            </div>
            {% if block.settings.coming_soon %}
              <div class="cs-overlay">
                <div class="cs-text">{{ block.settings.cs_title }}</div>
                <div class="cs-sub">{{ block.settings.cs_subtext }}</div>
                <a href="{{ block.settings.cs_link }}" class="btn btn-{{ block.settings.cs_button_style }}">{{ block.settings.cs_button_text }}</a>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <style>
    /* ── PRODUCT GRID ────────────────────────────────── */
    .shop-main{padding:24px var(--pad)}
    .products-grid{display:grid;grid-template-columns:1fr;gap:16px}
    @media(min-width:600px){.products-grid{grid-template-columns:1fr 1fr}}
    @media(min-width:1024px){.products-grid{grid-template-columns:repeat(3,1fr)};.shop-main{padding:32px var(--pad-lg)}}
    
    /* ── PRODUCT CARD ────────────────────────────────── */
    .product-card{background:var(--surface);border:1px solid var(--border);border-radius:8px;overflow:hidden;display:flex;flex-direction:column;transition:border-color .2s,transform .15s;position:relative}
    .product-card:hover{transform:translateY(-2px)}
    .product-card.featured{border-color:rgba(232,72,42,.25)}
    
    .card-badge{position:absolute;top:12px;left:12px;z-index:2;display:flex;gap:6px;flex-wrap:wrap}
    .badge{display:inline-flex;align-items:center;gap:4px;font-family:var(--f-dis);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:4px 9px;border-radius:3px}
    .badge-bestseller{background:var(--coral);color:#fff}
    .badge-new{background:var(--teal);color:#000}
    .badge-soon{background:rgba(212,131,26,.15);color:var(--amber);border:1px solid rgba(212,131,26,.3)}
    .badge-soon::before{content:'';width:5px;height:5px;background:var(--amber);border-radius:50%;animation:pa 2s ease-in-out infinite}
    @keyframes pa{0%,100%{opacity:1}50%{opacity:.4}}
    
    .card-img{height:220px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
    .card-img-emoji{font-size:80px;filter:drop-shadow(0 14px 32px rgba(0,0,0,.4));transition:transform .3s ease;position:relative;z-index:1}
    .product-card:hover .card-img-emoji{transform:translateY(-5px) scale(1.04)}
    .card-img-glow{position:absolute;width:120px;height:120px;border-radius:50%;filter:blur(35px);opacity:.12;transition:opacity .3s}
    .product-card:hover .card-img-glow{opacity:.22}
    
    .card-body{padding:16px 16px 20px;flex:1;display:flex;flex-direction:column}
    .card-cat{font-family:var(--f-body);font-size:9px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;margin-bottom:6px}
    .card-name{font-family:var(--f-dis);font-size:18px;font-weight:700;letter-spacing:-0.01em;margin-bottom:8px;line-height:1.15}
    .card-tagline{font-size:12px;color:var(--muted);line-height:1.55;margin-bottom:14px;flex:1}
    .card-features{display:flex;flex-direction:column;gap:5px;margin-bottom:16px}
    .cf{display:flex;align-items:flex-start;gap:6px;font-size:11px;color:var(--muted-l);line-height:1.45}
    .cf::before{content:'✓';font-weight:700;font-size:10px;flex-shrink:0;margin-top:1px;font-family:var(--f-dis)}
    .cf.coral::before{color:var(--coral)}
    .cf.teal::before{color:var(--teal)}
    .cf.amber::before{color:var(--amber)}
    .card-footer{border-top:1px solid var(--border);padding-top:14px;display:flex;align-items:center;justify-content:space-between;gap:12px}
    .card-price{font-family:var(--f-dis);font-size:20px;font-weight:800;line-height:1}
    .card-price-sub{font-size:10px;color:var(--muted);margin-top:2px}
    .card-footer .btn{padding:11px 16px;font-size:11px;flex-shrink:0;width:auto;min-height:44px}
    
    /* Coming soon overlay */
    .cs-overlay{position:absolute;inset:0;background:rgba(8,8,8,.65);backdrop-filter:blur(3px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;z-index:3;opacity:0;transition:opacity .2s}
    .product-card.soon:hover .cs-overlay{opacity:1}
    .cs-text{font-family:var(--f-dis);font-size:13px;font-weight:700;color:var(--amber);letter-spacing:.08em;text-transform:uppercase}
    .cs-sub{font-size:11px;color:var(--muted-l)}
    .cs-overlay .btn{width:auto;padding:10px 18px;font-size:11px}
  </style>
  {% schema %}
  {
    "name": "Shop Product Grid",
    "settings": [],
    "blocks": [
      {
        "type": "product",
        "name": "Product Card",
        "settings": [
          {
            "type": "text",
            "id": "category",
            "label": "Category filter key",
            "default": "recovery"
          },
          {
            "type": "checkbox",
            "id": "featured",
            "label": "Featured product",
            "default": false
          },
          {
            "type": "checkbox",
            "id": "coming_soon",
            "label": "Coming Soon",
            "default": false
          },
          {
            "type": "text",
            "id": "badge_text",
            "label": "Badge text",
            "default": "★ Best Seller"
          },
          {
            "type": "select",
            "id": "badge_type",
            "label": "Badge type",
            "options": [
              { "value": "bestseller", "label": "Bestseller" },
              { "value": "new", "label": "New" },
              { "value": "soon", "label": "Soon" }
            ],
            "default": "bestseller"
          },
          {
            "type": "text",
            "id": "bg_gradient",
            "label": "Background gradient",
            "default": "linear-gradient(135deg,#1c1212,#18191c)"
          },
          {
            "type": "color",
            "id": "glow_color",
            "label": "Glow color",
            "default": "#E8482A"
          },
          {
            "type": "text",
            "id": "emoji",
            "label": "Product emoji",
            "default": "🧴"
          },
          {
            "type": "text",
            "id": "category_text",
            "label": "Category text",
            "default": "Recovery · CBD Topical"
          },
          {
            "type": "color",
            "id": "category_color",
            "label": "Category color",
            "default": "#E8482A"
          },
          {
            "type": "text",
            "id": "product_name",
            "label": "Product name",
            "default": "Max Relief Balm"
          },
          {
            "type": "textarea",
            "id": "tagline",
            "label": "Tagline",
            "default": "4-pathway formula. Pharmaceutical nerve block + full spectrum CBD at 20mg/ml + botanical anti-inflammatories."
          },
          {
            "type": "text",
            "id": "feature_1",
            "label": "Feature 1",
            "default": "Lidocaine HCl — pharmaceutical nerve block"
          },
          {
            "type": "text",
            "id": "feature_2",
            "label": "Feature 2",
            "default": "20mg/ml full spectrum CBD"
          },
          {
            "type": "text",
            "id": "feature_3",
            "label": "Feature 3",
            "default": "Arnica + Turmeric anti-inflammatory stack"
          },
          {
            "type": "text",
            "id": "feature_4",
            "label": "Feature 4",
            "default": "Non-intoxicating · No drug test impact"
          },
          {
            "type": "select",
            "id": "feature_color_class",
            "label": "Feature color class",
            "options": [
              { "value": "coral", "label": "Coral" },
              { "value": "teal", "label": "Teal" },
              { "value": "amber", "label": "Amber" }
            ],
            "default": "coral"
          },
          {
            "type": "text",
            "id": "price",
            "label": "Price",
            "default": "$30–$60"
          },
          {
            "type": "text",
            "id": "price_sub",
            "label": "Price subtitle",
            "default": "Stick 30ml · Jar 60ml"
          },
          {
            "type": "text",
            "id": "button_text",
            "label": "Button text",
            "default": "ADD TO CART"
          },
          {
            "type": "url",
            "id": "button_link",
            "label": "Button link"
          },
          {
            "type": "select",
            "id": "button_style",
            "label": "Button style",
            "options": [
              { "value": "p", "label": "Primary (Coral)" },
              { "value": "t", "label": "Teal" },
              { "value": "a", "label": "Amber" },
              { "value": "s", "label": "Secondary" }
            ],
            "default": "p"
          },
          {
            "type": "header",
            "content": "Coming Soon Overlay"
          },
          {
            "type": "text",
            "id": "cs_title",
            "label": "Overlay title",
            "default": "Launching Soon"
          },
          {
            "type": "text",
            "id": "cs_subtext",
            "label": "Overlay subtext",
            "default": "Join the waitlist for early access"
          },
          {
            "type": "text",
            "id": "cs_button_text",
            "label": "Overlay button text",
            "default": "GET EARLY ACCESS"
          },
          {
            "type": "url",
            "id": "cs_link",
            "label": "Overlay button link"
          },
          {
            "type": "select",
            "id": "cs_button_style",
            "label": "Overlay button style",
            "options": [
              { "value": "p", "label": "Primary (Coral)" },
              { "value": "t", "label": "Teal" },
              { "value": "a", "label": "Amber" },
              { "value": "s", "label": "Secondary" }
            ],
            "default": "a"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Shop Product Grid",
        "blocks": [
          { "type": "product" },
          { "type": "product" },
          { "type": "product" }
        ]
      }
    ]
  }
  {% endschema %}
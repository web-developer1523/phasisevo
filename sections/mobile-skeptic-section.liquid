<section class="skeptic-sec section">

  <div class="skeptic-center">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>

    <h2>
      {{ section.settings.heading_line1 }}<br>
      <em>{{ section.settings.heading_line2 }}</em>
    </h2>

    <p class="skeptic-sub mt-4">
      {{ section.settings.subtext }}
    </p>
  </div>

  <div class="objections">
    {% for block in section.blocks %}
      <div class="obj-card">
        <div class="obj-num">{{ block.settings.number }}</div>
        <h4 class="obj-q">{{ block.settings.question }}</h4>
        <div class="obj-a">{{ block.settings.answer }}</div>
      </div>
    {% endfor %}
  </div>

  <div class="what-is">
    <span class="wi-label">{{ section.settings.bottom_label }}</span>

    <div class="wi-text">
      {{ section.settings.bottom_highlight }}
    </div>

    <p class="wi-sub mt-4">
      {{ section.settings.bottom_description }}
    </p>
  </div>

</section>
<style>
    /* ── SKEPTIC SECTION ─────────────────────────────── */
.skeptic-sec{background:var(--page-bg);border-top:1px solid var(--border)}
.skeptic-center{text-align:center;margin-bottom:24px}
.skeptic-center h2{margin-bottom:12px}
.skeptic-sub{font-size:15px;font-weight:300;color:#d0d0d0;line-height:1.7}
/* Objection cards — 1 col mobile, 2 col desktop */
.objections{display:grid;grid-template-columns:1fr;gap:12px;margin-bottom:24px}
@media(min-width:768px){.objections{grid-template-columns:1fr 1fr}}

.obj-card{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:20px 16px;position:relative;overflow:hidden}
.obj-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--amber);opacity:.6}
.obj-num{font-family:var(--f-dis);font-size:32px;font-weight:800;color:var(--amber);opacity:.8;line-height:1;margin-bottom:12px;}
.obj-q{font-family:var(--f-dis);font-size:16px;font-weight:700;margin-bottom:12px;line-height:1.3}
.obj-a{font-size:15px;color:#d0d0d0;line-height:1.7}
.obj-a strong{color:var(--off-white);font-weight:600}

.what-is{background:rgba(212,131,26,.05);border:1px solid rgba(212,131,26,.2);border-radius:8px;padding:20px 16px;text-align:center}
.wi-label{font-family:var(--f-body);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--amber);margin-bottom:12px;display:block}
.wi-text{font-family:var(--f-dis);font-size:clamp(15px,2vw,19px);font-weight:600;line-height:1.4;letter-spacing:-0.01em;margin-bottom:12px}
.wi-text em{color:var(--amber);font-style:normal}
.wi-sub{font-size:15px;font-weight:300;color:#d0d0d0;line-height:1.7}
</style>
{% schema %}
{
  "name": " Mobile Skeptic Section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Before You Scroll Past"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "We Know The"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading Line 2",
      "default": "Four Things You're Thinking."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Sub Text",
      "default": "Every serious athlete has the same objections. Let's address all of them now."
    },

    {
      "type": "text",
      "id": "bottom_label",
      "label": "Bottom Label",
      "default": "The Numbers From The Research"
    },
    {
      "type": "textarea",
      "id": "bottom_highlight",
      "label": "Bottom Highlight Text",
      "default": "Up to +2kg lean muscle in 10 weeks. Significant bench press strength gains."
    },
    {
      "type": "textarea",
      "id": "bottom_description",
      "label": "Bottom Description",
      "default": "These are results from a peer-reviewed study..."
    }
  ],

  "blocks": [
    {
      "type": "objection",
      "name": "Objection Card",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your objection here"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Your answer here"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": " Mobile Skeptic Section",
      "blocks": [
        { "type": "objection" },
        { "type": "objection" },
        { "type": "objection" },
        { "type": "objection" }
      ]
    }
  ]
}
{% endschema %}
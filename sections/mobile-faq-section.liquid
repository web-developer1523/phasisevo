<section class="faq-sec section {{ section.settings.custom_cc_class }}">

  <span class="eyebrow">{{ section.settings.eyebrow }}</span>

  <h2>
    {{ section.settings.heading_line1 }}<br>
    <em>{{ section.settings.heading_emphasis }}</em>
  </h2>

  <p class="faq-top-sub">{{ section.settings.subtext }}</p>

  {% for block in section.blocks %}
    <div class="faq-item {% if block.settings.open_default %}open{% endif %}">
      
      <div class="faq-q">
        <span class="faq-q-text">{{ block.settings.question }}</span>
        <span class="faq-icon">+</span>
      </div>

      <div class="faq-a">
        {{ block.settings.answer }}
      </div>

    </div>
  {% endfor %}

</section>
<style>
    /* ── FAQ ─────────────────────────────────────────── */
.faq-sec{background:var(--page-bg);border-top:1px solid var(--border)}
.faq-sec h2{margin-bottom:8px}
.faq-top-sub{font-size:14px;color:var(--muted);margin-bottom:24px}
.faq-item{border-bottom:1px solid var(--border)}
.faq-item:first-of-type{border-top:1px solid var(--border)}
.faq-q{display:flex;align-items:center;justify-content:space-between;padding:16px 0;cursor:pointer;gap:16px;min-height:52px}
.faq-q-text{font-family:var(--f-dis);font-size:16px;font-weight:600;line-height:1.3}
.faq-icon{color:var(--amber);font-size:20px;flex-shrink:0;transition:transform .2s;font-weight:300;line-height:1;min-width:24px;text-align:center}
.faq-item.open .faq-icon{transform:rotate(45deg)}
.faq-a{font-size:15px;color:#d0d0d0;line-height:1.75;padding-bottom:16px;display:none}
.faq-item.open .faq-a{display:block}
 </style>  
<!-- FAQ TOGGLE SCRIPT -->
<script>
document.querySelectorAll('.faq-q').forEach(q => {
  q.addEventListener('click', function() {
    const item = this.parentElement;

    if (item.classList.contains('open')) {
      item.classList.remove('open');
    } else {
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      item.classList.add('open');
    }
  });
});
</script>

{% schema %}
{
  "name": "FAQ Section",
  "settings": [
       {
      "type": "text",
      "id": "custom_cc_class",
      "label": "Custom CSS Class"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Common Questions"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "Everything You Need to Know"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading Emphasis",
      "default": "Need to Know"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "The questions we get asked most about Perform+."
    }
  ],

  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "checkbox",
          "id": "open_default",
          "label": "Open by Default",
          "default": false
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Your answer here."
        }
      ]
    }
  ],

  "presets": [
    {
      "name": " MobileFAQ Section",
      "category": "Custom",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "open_default": true,
            "question": "Will this get me banned?",
            "answer": "No, it is not banned."
          }
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        }
      ]
    }
  ]
}
{% endschema %}
        "default": "Everything your body needs.<br><em>Nothing it doesn't.</em>"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Max Relief for recovery, aches, and soreness. Electro+ to replenish what you sweat out and keep you going. Perform+ to build lean muscle and elevate performance — without the hormones. One system. Built to help you feel and perform better."
      },
      {
        "type": "text",
        "id": "total_label",
        "label": "Total label",
        "default": "The PHASIS Stack"
      },
      {
        "type": "text",
        "id": "original_price_text",

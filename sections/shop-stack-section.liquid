      },
      {
        "type": "text",
        "id": "visual_title",
        "label": "Visual title",
        "default": "The Complete Recovery System"
      },
      {
        "type": "text",
        "id": "visual_subtitle",
        "label": "Visual subtitle",
        "default": "Recovery & soreness · Mineral hydration · Muscle performance"
      }
    ],
    "blocks": [
      {
        "type": "stack_item",
        "name": "Stack Item",
        "settings": [
          {
            "type": "text",
            "id": "emoji",
            "label": "Emoji",
            "default": "🧴"
          },
          {
            "type": "text",
            "id": "name",

          },
          {
            "type": "text",
            "id": "description",
            "label": "Description",
            "default": "4-pathway recovery formula · Jar 60ml"
          },
          {
            "type": "text",
            "id": "price",
            "label": "Price",
            "default": "$60"
          }
        ]
      },
      {
        "type": "stat",
        "name": "Visual Stat",
        "settings": [
          {
            "type": "text",
            "id": "value",
            "label": "Value",
            "default": "4.9★"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Average rating"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "The Stack",
        "blocks": [
          { "type": "stack_item" },
          { "type": "stack_item" },
          { "type": "stack_item" },
          { "type": "stat" },
          { "type": "stat" },
          { "type": "stat" }
        ]
      }
    ]
  }
  {% endschema %}
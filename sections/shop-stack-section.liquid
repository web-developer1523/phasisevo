<!-- ============================================ -->
<!-- STACK SECTION -->
<!-- ============================================ -->
{% comment %}
  Stack Section
  - Displays the product bundle or system stack.
  - Includes items, total savings, and visual representation.
{% endcomment %}

<section class="stack-sec section {{section.settings.custom_Css_Class }}" id="stack">
  <div class="stack-inner">
    <div>
      <div class="stack-eyebrow-row">
        <span>{{ section.settings.eyebrow }}</span>
      </div>
      <h2>{{ section.settings.heading }}</h2>
      <p class="stack-p mt-4">{{ section.settings.description }}</p>
      <div class="stack-items">
        {% assign total_price = 0 %}
        {% assign total_compare_price = 0 %}
        {% assign has_product = false %}
        {% for block in section.blocks %}
          {% if block.type == 'stack_item' %}
            {% assign product = all_products[block.settings.product_id] %}
            {% if product != blank %}
              {% assign has_product = true %}

              {% comment %}
                {% assign total_price = total_price | plus: product.price %}
                {% assign total_compare_price = total_compare_price | plus: product.compare_at_price %}
              {% endcomment %}

              {% if product.handle == 'max-relief-balm' %}
                {% assign target_variant = product.variants | where: 'title', 'Jar — 60ml' | first %}
              {% elsif product.handle == 'electro-drops' %}
                {% assign target_variant = product.variants | where: 'title', '120ml' | first %}
              {% elsif product.handle == 'perform' %}
                {% assign target_variant = product.variants | where: 'title', '60 Capsules' | first %}
              {% else %}
                {% assign target_variant = product.variants.first %}
              {% endif %}

              {% assign price = target_variant.price %}
              {% assign compare_price = target_variant.compare_at_price %}

              {% assign total_price = total_price | plus: price %}
              {% assign total_compare_price = total_compare_price | plus: compare_price %}
            {% endif %}
            <div class="si" data-variant-id="{% if product != blank %}{{ target_variant.id }}{% endif %}">
              <div class="si-emoji">
                {% if product != blank %}
                  <img
                    src="{{ product.featured_image | image_url: width: 100 }}"
                    alt="{{ product.title }}"
                    width="40"
                    height="40"
                  >
                {% else -%}
                  {{- block.settings.emoji -}}
                {%- endif %}
              </div>
              <div class="si-body">
                <div class="si-name">
                  {% if product != blank %}
                    {{ product.title }}
                  {% else %}
                    {{ block.settings.name -}}
                  {%- endif %}
                </div>
                <div class="si-desc">{{ block.settings.description }}</div>
              </div>
              <div class="si-price">
                {% if product != blank %}
                  {% if product.handle == 'max-relief-balm' %}
                    {% assign target_variant = product.variants | where: 'title', 'Jar — 60ml' | first %}
                  {% elsif product.handle == 'electro-drops' %}
                    {% assign target_variant = product.variants | where: 'title', '120ml' | first %}
                  {% elsif product.handle == 'perform' %}
                    {% assign target_variant = product.variants | where: 'title', '60 Capsules' | first %}
                  {% else %}
                    {% assign target_variant = product.variants.first %}
                  {% endif %}
                  {{ target_variant.price | money | replace: '.00', '' }}
                {% else %}
                  {{ block.settings.price }}
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="stack-total">
        <div class="st-label">{{ section.settings.total_label }}</div>
        <div>
          <div class="st-original">
            {% if has_product %}
              {% if total_compare_price > total_price %}
                {{ total_compare_price | money }}
              {% else %}
                {{ section.settings.original_price_text }}
              {% endif %}
            {% else %}
              {{ section.settings.original_price_text }}
            {% endif %}
          </div>
          <div class="st-sale">
            {% if has_product %}
              {{ total_price  |  minus: 2800  | money | replace: '.00', '' }}
            {% else %}
              {{ section.settings.sale_price }}
            {% endif %}
            <span class="st-save">
              {% if has_product and total_compare_price > total_price %}
                — Save {{ total_compare_price | minus: total_price | money }}
              {% else %}
                {{ section.settings.save_text -}}
              {%- endif -%}
            </span>
          </div>
        </div>
      </div>
      <a href="#" class="btn btn-p btn-full" id="build-my-stack">{{ section.settings.button_text }}</a>
    </div>
    <div class="stack-visual">
      <span class="sv-emojis">
        {% if section.settings.visual_img_1 != blank
          or section.settings.visual_img_2 != blank
          or section.settings.visual_img_3 != blank
        %}
          {% if section.settings.visual_img_1 != blank %}
            <img src="{{ section.settings.visual_img_1 | image_url }}" alt="img1">
          {% endif %}

          {% if section.settings.visual_img_2 != blank %}
            <img src="{{ section.settings.visual_img_2 | image_url }}" alt="img2">
          {% endif %}

          {% if section.settings.visual_img_3 != blank %}
            <img src="{{ section.settings.visual_img_3 | image_url }}" alt="img3">
          {% endif %}

        {% else %}
          {{ section.settings.visual_emojis }}
        {% endif %}
      </span>
      <div class="sv-title">{{ section.settings.visual_title }}</div>
      <div class="sv-sub">{{ section.settings.visual_subtitle }}</div>
      <div class="sv-stats">
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            <div class="sv-stat">
              <span class="sv-stat-val">{{ block.settings.value }}</span>
              <span class="sv-stat-lbl">{{ block.settings.label }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>
<style>
  /* ── STACK SECTION ───────────────────────────────── */
  .stack-sec{background:var(--surface);border-top:1px solid var(--border)}
  .stack-eyebrow-row{display:flex;align-items:center;gap:10px;margin-bottom:16px}
  .stack-eyebrow-row::before{content:'';width:20px;height:2px;background:var(--red);flex-shrink:0}
  .stack-eyebrow-row span{font-family:var(--f-mark);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--red)}
  .stack-sec h2{margin-bottom:14px}
  .stack-p{font-size:14px;font-weight:300;color:#d0d0d0;line-height:1.75;margin-bottom:20px}

  .stack-items{display:flex;flex-direction:column;gap:8px;margin-bottom:16px}
  .si{display:flex;align-items:center;gap:12px;padding:12px 14px;background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:6px}
  .si-emoji{font-size:20px;flex-shrink:0}
  .si-body{flex:1}
  .si-name{font-family:var(--f-dis);font-size:16px;font-weight:700}
  .si-desc{font-size:15px;color:#d0d0d0}
  .si-price{font-family:var(--f-dis);font-size:14px;font-weight:700;flex-shrink:0}

  .stack-total{display:flex;align-items:center;justify-content:space-between;padding:14px 14px;background:rgba(232,72,42,.07);border:1px solid rgba(232,72,42,.2);border-radius:6px;margin-bottom:16px}
  .st-label{font-family:var(--f-dis);font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
  .st-original{font-size:12px;color:var(--muted);text-decoration:line-through}
  .st-sale{font-family:var(--f-dis);font-size:22px;font-weight:800;color:var(--red)}
  .st-save{font-size:11px;color:var(--coral);font-weight:600}

  /* Stack visual — desktop only */
  .stack-visual{display:none}
  @media(min-width:1024px){
    .stack-inner{display:grid;grid-template-columns:1fr 1.1fr;gap:64px;align-items:center}
    .stack-visual{display:block;background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:48px 32px;text-align:center;position:relative;overflow:hidden;height: 100%; display: flex; flex-direction: column;justify-content: center;
}
    .stack-visual::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(232,72,42,.06) 0%,transparent 65%);pointer-events:none}
    .sv-emojis{font-size: clamp(50px, 8vw, 100px);letter-spacing:16px;margin-bottom:20px;display:block;position:relative;z-index:1}
    .sv-title{font-family:var(--f-dis);font-size:16px;font-weight:700;margin-bottom:8px;position:relative;z-index:1}
    .sv-sub{font-size:14px;color:#d0d0d0;margin-bottom:24px;position:relative;z-index:1}
    .sv-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;position:relative;z-index:1}
    .sv-stat{background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:6px;padding:12px}
    .sv-stat-val{font-family:var(--f-dis);font-size:18px;font-weight:800;color:var(--red);display:block;margin-bottom:3px}
    .sv-stat-lbl{font-size:14px;color:#d0d0d0}
  }
.sv-emojis {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0; /* emoji jaisa tight spacing */
  line-height: 1;
}

.sv-emojis img {
  width: 1.6em;
  height: 1.6em;
  object-fit: contain;
  display: block;
  margin: 0 -2px; 
}
</style>

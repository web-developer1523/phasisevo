        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Stack Section",
      "blocks": [
        { "type": "why" },
        { "type": "why" },
        { "type": "why" },
        { "type": "why" },
        { "type": "fact" },
        { "type": "fact" },
        { "type": "fact" },
        { "type": "fact" }
      ]
    }
  ]
}

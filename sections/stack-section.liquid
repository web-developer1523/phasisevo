<section class="stack-sec {{ section.settings.custm_css_class }}" id="stack">
  <div class="stack-inner">
    <!-- LEFT -->
    <div class="stack-left">
      <div class="stack-eyebrow">
        <span>{{ section.settings.eyebrow }}</span>
      </div>

      <h2 class="stack-h">
        {{ section.settings.heading_line1 -}}
        <br>
        {{ section.settings.heading_line2 -}}
        <br>
        <span>{{ section.settings.heading_highlight }}</span>
      </h2>

      <p class="stack-p">
        {{ section.settings.description }}
      </p>

      <div class="stack-why">
        {% for block in section.blocks %}
          {% if block.type == 'why' %}
            <div class="sw-item">
              <div class="sw-dot"></div>
              <div class="sw-text">
                {{ block.settings.text | rich_text }}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <a href="{{ section.settings.left_btn_link }}" class="btn btn-t">
        {{ section.settings.left_btn_text }}
      </a>
    </div>

    <!-- RIGHT -->
    <div class="stack-right">
      {% assign product = section.settings.product %}

      {% if product != blank %}
        <div class="electro-card">
          <!-- IMAGE OR EMOJI -->
          <div class="electro-card-img">
            {% if section.settings.card_image != blank %}
              <img
                src="{{ section.settings.card_image | image_url: width: 600 }}"
                alt="Card Image"
                loading="lazy"
              >

            {% elsif section.settings.card_emoji != blank %}
              <span class="card-emoji">
                {{ section.settings.card_emoji }}
              </span>

            {% elsif product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.title }}"
                 class="stack-product-image"
                loading="lazy"
              >
            {% endif %}
          </div>

          <div class="electro-card-body">
            <span class="ctag">
              {{ section.settings.card_tag }}
            </span>

            <h3>{{ product.title }}</h3>

            <p class="edesc">
              {{ section.settings.card_desc }}
            </p>

            <!-- FACTS -->
            <div class="electro-facts">
              {% for block in section.blocks %}
                {% if block.type == 'fact' %}
                  <div class="ef">
                    <div class="ef-val">{{ block.settings.value }}</div>
                    <div class="ef-lbl">{{ block.settings.label }}</div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            {% comment %} <div class="electro-footer">
              <div class="electro-price">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <span style="text-decoration:line-through;">
                    {{ product.compare_at_price | money }}
                    
                  </span>
                {% endif %}
              </div>  {% endcomment %}
              <div class="electro-footer">
              <div class="electro-price">
                {% assign prices = product.variants | map: 'price' | uniq %}
                From {% for price in prices %}
                  {{ price | money | replace: '.00', '' }}{% unless forloop.last %} - {% endunless %}
                {% endfor %} <span class="unit-text variant-pills cst-pills-select">
              {% if product.variants.size > 0 %}

                {% assign variant_titles = product.variants | map: 'title' | uniq %}

                {% for variant in product.variants %}
                  <input
                    type="radio"
                    id="variant-{{ variant.id }}"
                    name="id"
                    value="{{ variant.id }}"
                    data-price="{{ variant.price | money }}"
                    data-image="{{ variant.featured_image | image_url: width: 600 }}"
                      {% if variant.title contains '120' %}checked{% elsif forloop.first %}checked{% endif %}
                    hidden
                  >

                  <label for="variant-{{ variant.id }}" class="pill variant">
                    {{ variant.title }}
                  </label>
                {% endfor %}
              {% else %}
                1 oz or 4 oz
              {% endif %}
            </span>

              {% if product.compare_at_price > product.price %}
                <span style="text-decoration:line-through;">
                  {{ product.compare_at_price | money }}
                </span>
              {% endif %}
            </div> 
            {% if section.settings.card_btn_link != blank %}
            <!-- fallback  mode -->
            <a href="{{ section.settings.card_btn_link }}" class="btn btn-t">
              {{ section.settings.card_btn_text }}
            </a>
          {% else %}
            <!-- Shopify Add to Cart  -->
            <form method="post" action="/cart/add" class="perf-cta-form">
              <input type="hidden" name="id" id="selected-variant" value="{{ product.variants.first.id }}">
              <button type="submit" class="btn btn-t">
                {{ section.settings.card_btn_text }}
              </button>
            </form>
          {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>
<script>
document.addEventListener('DOMContentLoaded', function () {

  let selectedVariant = document.querySelector('#stack .variant-pills input:checked')?.value;
  const stackSection = document.querySelector('#stack');
  const checkedInput = document.querySelector('#stack .variant-pills input:checked');
  if (checkedInput) {
    applyDynamicClass(checkedInput);
  }
 
  // VARIANT CHANGE (IMAGE + STORE)

  document.querySelectorAll('#stack .variant-pills input').forEach(input => {

    input.addEventListener('change', function () {

      selectedVariant = this.value;
       applyDynamicClass(this);

      // IMAGE CHANGE
      const newImage = this.dataset.image;

      if (newImage) {
        const img = document.querySelector('#stack .electro-card-img img');
        if (img) img.src = newImage;
      }

    });

  });


  // ADD TO CART (AJAX)

  const form = document.querySelector('#stack .perf-cta-form');

  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        id: selectedVariant,
        quantity: 1
      })
    })
    .then(res => res.json())
    .then(data => {

      console.log('Added to cart:', data);

      updateCartCount();

    })
    .catch(err => {
      console.error('Add to cart error:', err);
    });

  });


  // CART COUNT UPDATE (Dawn theme FIX)

  function updateCartCount() {
    fetch('/cart.js')
      .then(res => res.json())
      .then(cart => {

        const count = cart.item_count;

        // MAIN CART BUBBLE (your theme)
        document.querySelectorAll('.cart-count-bubble span[aria-hidden="true"]')
          .forEach(el => {
            el.textContent = count;
          });

        // accessibility text
        document.querySelectorAll('.cart-count-bubble .visually-hidden')
          .forEach(el => {
            el.textContent = count + (count === 1 ? ' item' : ' items');
          });

      });
  }


    function applyDynamicClass(input) {
   const label = document.querySelector(`label[for="${input.id}"]`)?.textContent.toLowerCase();

    // old class remove
    stackSection.classList.remove('is-120ml');

    // 120ml detect
     if (label && label.includes('120')) {
    stackSection.classList.add('is-120ml');
  }
  }



});
</script>

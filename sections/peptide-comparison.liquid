<!-- PEPTIDE COMPARISON -->
<section class="peptide-sec section">
  <div class="peptide-top">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>
      {{ section.settings.heading_line1 }}<br>
      <em>{{ section.settings.heading_emphasis }}</em>
    </h2>
    <p class="peptide-sub mt-4">{{ section.settings.subheading }}</p>
  </div>

  <div class="peptide-grid">

    <!-- LEFT CARD -->
    <div class="peptide-card theirs">
      <div class="pc-label bad">{{ section.settings.left_label }}</div>
      <div class="pc-title">{{ section.settings.left_title }}</div>

      <div class="pc-pts">
        {% for block in section.blocks %}
          {% if block.type == 'left_point' %}
            <div class="pc-pt bad">
              <b>{{ block.settings.bold_text }}</b> — {{ block.settings.normal_text }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- RIGHT CARD -->
    <div class="peptide-card ours">
      <div class="pc-label good">{{ section.settings.right_label }}</div>
      <div class="pc-title">{{ section.settings.right_title }}</div>

      <div class="pc-pts">
        {% for block in section.blocks %}
          {% if block.type == 'right_point' %}
            <div class="pc-pt good">
              <b>{{ block.settings.bold_text }}</b> — {{ block.settings.normal_text }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  </div>

  <!-- LOGIC SECTION -->
  <div class="peptide-logic">
    <span class="pl-eyebrow">{{ section.settings.logic_eyebrow }}</span>

    <div class="pl-text">
      {{ section.settings.logic_text }}
    </div>

    <p class="pl-sub">{{ section.settings.logic_subtext }}</p>

    <a href="{{ section.settings.button_link }}" class="btn btn-a btn-full" style="max-width:360px;margin:0 auto 16px">
      {{ section.settings.button_text }}
    </a>

    <p class="pl-disclaimer">{{ section.settings.disclaimer }}</p>
  </div>
</section>
<style>
    /* ── PEPTIDE COMPARISON ──────────────────────────── */
.peptide-sec{background:var(--surface);border-top:1px solid var(--border)}
.peptide-top{text-align:center;margin-bottom:24px}
.peptide-top h2{margin-bottom:12px}
.peptide-sub{font-size:15px;font-weight:300;color:#d0d0d0;line-height:1.7}

.peptide-grid{display:grid;grid-template-columns:1fr;gap:12px;margin-bottom:24px}
@media(min-width:768px){.peptide-grid{grid-template-columns:1fr 1fr}}

.peptide-card{background:var(--page-bg);border:1px solid var(--border);border-radius:8px;padding:20px 16px}
.peptide-card.theirs{border-top:3px solid #c04040}
.peptide-card.ours{border-top:3px solid var(--amber)}
.pc-label{display:flex;align-items:center;gap:10px;font-family:var(--f-dis);font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:14px}
.pc-label.bad{color:#c04040}
.pc-label.bad::before{content:'💉';font-size:16px}
.pc-label.good{color:var(--amber)}
.pc-label.good::before{content:'💊';font-size:16px}
.pc-title{font-family:var(--f-dis);font-size:15px;font-weight:700;margin-bottom:14px;line-height:1.2}
.pc-pts{display:flex;flex-direction:column;gap:6px}
.pc-pt{display:flex;align-items:flex-start;gap:10px;font-size:14px;color:#d0d0d0;line-height:1.5;padding:8px 12px;background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:4px}
.pc-pt.bad::before{content:'✗';color:#c04040;font-weight:700;font-size:11px;flex-shrink:0;margin-top:1px;font-family:var(--f-dis)}
.pc-pt.good::before{content:'✓';color:var(--amber);font-weight:700;font-size:11px;flex-shrink:0;margin-top:1px;font-family:var(--f-dis)}
.pc-pt b{color:var(--off-white);font-weight:600}

.peptide-logic{background:rgba(212,131,26,.06);border:1px solid rgba(212,131,26,.2);border-radius:8px;padding:20px 16px;text-align:center}
.pl-eyebrow{font-family:var(--f-body);font-size:10px;font-weight:500;font-style:italic;letter-spacing:.22em;text-transform:uppercase;color:var(--amber);margin-bottom:12px;display:block}
.pl-text{font-family:var(--f-dis);font-size:clamp(15px,2vw,19px);font-weight:700;line-height:1.4;letter-spacing:-0.01em;margin-bottom:12px}
.pl-text em{color:var(--amber);font-style:normal}
.pl-sub{font-size:14px;color:#d0d0d0;line-height:1.7;margin-bottom:16px}
.pl-disclaimer{font-size:14px;color:#d0d0d0;font-style:italic}

</style>

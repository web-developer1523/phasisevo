            desc: 'A few more questions will help us understand whether this is acute soreness, chronic load, or joint-related — so your protocol hits the right target.',
            pills: ['Soreness type', 'Recovery time', 'Joint comfort', 'Training load'],
            questions: [
              { text: 'Is your soreness more acute (after hard sessions) or chronic (ongoing, between sessions)?', opts: ['Mostly acute','Mostly chronic','Both'] },
              { text: 'How many days per week do you train at high intensity?', opts: ['1–2 days','3–4 days','5+ days'] },
              { text: 'Do you experience joint stiffness or reduced range of motion?', opts: ['Rarely','Sometimes','Often'] },

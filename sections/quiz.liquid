        function getAgeModifiers(domain) {
          var age = state.intake.age;
          var modifiers = [];
  
          if (!age) return modifiers;
  
          var is46plus = age === '46-60' || age === '60+';
          var is60plus = age === '60+';
          var is31plus = age === '31-45' || is46plus;
  
          var map = {
            sleep: {

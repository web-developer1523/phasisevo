  const DOMAIN_MAX_SCORES = {
    sleep: 20,
    stress: 20,
    mood: 20,
    digestion: 20,
    energy: 25,
    physical: 20
  };

  const DOMAIN_MIN_SCORES = {
    sleep: 4,
    stress: 4,
    mood: 4,
    digestion: 4,
    energy: 5,
    physical: 4
  };

  const DOMAIN_PRIORITY_ORDER = ['sleep', 'stress', 'mood', 'energy', 'digestion', 'physical'];

  const PRIORITY_THRESHOLDS = {
    primary_min: 30,
    secondary_min: 40,
    deep_dive_trigger: 60
  };

  function normalizeToPriority(rawScore, domainKey) {
    var max = DOMAIN_MAX_SCORES[domainKey];
    var min = DOMAIN_MIN_SCORES[domainKey];
    return Math.round(((rawScore - min) / (max - min)) * 100);
  }

  function getDomainPriority(domainKey) {
    var raw = state.scores[domainKey] || 0;
    var priority = normalizeToPriority(raw, domainKey);
    return Math.min(Math.max(priority, 0), 100);
  }

  function priorityLabel(priority) {
    if (priority >= 70) return 'Top priority';
    if (priority >= 50) return 'High priority';
    if (priority >= 30) return 'Moderate priority';
    if (priority >= 15) return 'Well supported';
    return 'Fully supported';
  }

  function getDomainBarWidth(priority) {
    return Math.min(Math.max(priority, 4), 100);
  }
  

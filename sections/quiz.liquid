          if (state.intake.supplements) {
            html += '<span style="display:inline-flex;align-items:center;background:rgba(255,255,255,.05);border:1px solid var(--border2);border-radius:20px;padding:5px 11px;font-family:var(--f-dis);font-size:9px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted-l)">' + (suppLabels[state.intake.supplements] || state.intake.supplements) + '</span>';
          }
          if (isBeginner) {
            html += '<span style="display:inline-flex;align-items:center;background:rgba(74,158,92,.1);border:1px solid rgba(74,158,92,.3);border-radius:20px;padding:5px 11px;font-family:var(--f-dis);font-size:9px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#4A9E5C">🌱 Foundation Protocol</span>';
          }
          html += '</div></div></div>';
  
          // ── ZONE 2 — SCAN SUMMARY ─────────────────────────────────────────────
          html += '<div style="padding:24px 20px;background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">';
          html += '<div style="font-family:var(--f-dis);font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:16px">Your 6-Area Scan</div>';
          ranked.forEach(function(d, i) {
            var dom = DOMAINS[d];
            var pct = state.maxScores[d] > 0 ? Math.round((state.scores[d] / state.maxScores[d]) * 100) : 0;
            var isPri = i === 0;
            var isSec = i === 1;
            html += '<div style="margin-bottom:' + (i < 5 ? '12' : '0') + 'px">';

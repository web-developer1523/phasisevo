  function renderQuestion(restoredIndex) {
    const q = QUESTIONS[state.currentQ];
    const d = DOMAINS[q.domain];
    const total = QUESTIONS.length;
    const current = state.currentQ + 1;
  
    updateProgress(4 + state.currentQ, 4 + total + 5);
  
    // Domain pill
    const pill = document.getElementById('q-domain-pill');
    pill.textContent = d.icon + ' ' + d.name;
    pill.style.background = d.bg;
    pill.style.borderColor = d.border;
    pill.style.color = d.color;
  
    document.getElementById('q-num').textContent = 'Question ' + current + ' of ' + total;
    document.getElementById('q-text').textContent = q.text;
  
    const optsEl = document.getElementById('q-opts');
    optsEl.innerHTML = '';
    const nextBtn = document.getElementById('q-next');
    nextBtn.disabled = true;
    delete nextBtn.dataset.score;
    nextBtn.onclick = nextQuestion;
  
    q.opts.forEach((opt, i) => {
      const score = i + 1;
      const div = document.createElement('div');
      div.className = 'qopt';
      div.innerHTML = '<span>' + opt + '</span><span class="qopt-check"><span class="qopt-check-inner"></span></span>';
  
      // Restore previously selected answer if going back
      if (restoredIndex === i) {
        div.classList.add('sel');
        div.style.borderColor = d.color;
        div.style.background = d.bg;
        div.style.color = d.color;
        nextBtn.disabled = false;
        nextBtn.dataset.score = score;
        nextBtn.dataset.domain = q.domain;
      }
  
      div.addEventListener('click', function() {
        optsEl.querySelectorAll('.qopt').forEach(o => {
          o.classList.remove('sel');
          o.style.borderColor = '';
          o.style.background = '';
          o.style.color = '';
        });
        div.classList.add('sel');
        div.style.borderColor = d.color;
        div.style.background = d.bg;
        div.style.color = d.color;
        nextBtn.disabled = false;
        nextBtn.dataset.score = score;
        nextBtn.dataset.domain = q.domain;
        nextBtn.dataset.selectedIndex = i;
      });
      optsEl.appendChild(div);
    });
  
    if (restoredIndex !== undefined) {
      nextBtn.dataset.selectedIndex = restoredIndex;
    }
  }
  
  function nextQuestion() {
    const btn = document.getElementById('q-next');
    const score = parseInt(btn.dataset.score);
    const domain = btn.dataset.domain;
    const selectedIndexRaw = parseInt(btn.dataset.selectedIndex, 10);
    const selectedIndex = isNaN(selectedIndexRaw) ? Math.max(score - 1, 0) : selectedIndexRaw;
  
    // Save this answer to history before advancing
    state.questionHistory.push({ score, domain, selectedIndex });
    state.scores[domain] += score;
    state.currentQ++;
  
    if (state.currentQ < QUESTIONS.length) {
      renderQuestion();
      const qs = document.getElementById('screen-question');
      qs.classList.remove('entering', 'back');
      void qs.offsetWidth;
      qs.classList.add('entering');
    } else {
      const topDomain = getTopDomain();
      const topPriority = getDomainPriority(topDomain);
      const shouldShowDeepDive = topDomain === 'sleep' && topPriority >= PRIORITY_THRESHOLDS.deep_dive_trigger;
      state.deepDiveDomain = topDomain;
      if (shouldShowDeepDive) showDeepDivePrompt(topDomain);
      else showResults();
    }
  }
  
  function getTopDomain() {
    let top = null, topPriority = -1;
    Object.keys(state.scores).forEach(d => {
      const priority = getDomainPriority(d);
      if (priority > topPriority) { topPriority = priority; top = d; }
      if (priority === topPriority && DOMAIN_PRIORITY_ORDER.indexOf(d) < DOMAIN_PRIORITY_ORDER.indexOf(top)) top = d;
    });
    return top;
  }
  
  function getRankedDomains() {
    return Object.keys(state.scores).sort((a, b) => {
      var priorityA = getDomainPriority(a);
      var priorityB = getDomainPriority(b);
      if (priorityB !== priorityA) return priorityB - priorityA;
      return DOMAIN_PRIORITY_ORDER.indexOf(a) - DOMAIN_PRIORITY_ORDER.indexOf(b);
    });
  }
  

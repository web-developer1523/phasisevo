  function startCoreScan() {
    // ── Pregnancy intercept ──────────────────────────────────────
    if (state.intake.gender === 'pregnant') {
      showScreen('screen-pregnant-redirect', 'forward');
      return;
    }
  
    state.history.push('screen-intake-age');
  
    state.currentQ = 0;

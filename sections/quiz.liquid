          };
  
          var domainMap = map[domain];
          if (!domainMap) return modifiers;
  
          // Find most specific match
          if (is60plus && domainMap['60+']) modifiers.push(domainMap['60+']);
          else if (is46plus && domainMap['46-60']) modifiers.push(domainMap['46-60']);
          else if (is31plus && domainMap['31-45']) modifiers.push(domainMap['31-45']);
          else if (age === '18-30' && domainMap['18-30']) modifiers.push(domainMap['18-30']);
  
          return modifiers;
        }
  
  

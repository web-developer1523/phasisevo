  function showScreen(id, direction) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active', 'entering', 'back'));
    const target = document.getElementById(id);
    target.classList.add('active');
    if (direction === 'forward') target.classList.add('entering');
    if (direction === 'back') target.classList.add('back');
    window.scrollTo(0, 0);
  }
  
  function nextScreen(id) {
    state.history.push(getCurrentScreen());
    showScreen(id, 'forward');
    updateNav();
  }
  
  function getCurrentScreen() {
    return document.querySelector('.screen.active').id;
  }
  
  function goBack() {
    const currentScreen = getCurrentScreen();
  
    // If on question screen — go back one question
    if (currentScreen === 'screen-question') {
      if (state.inDeepDive) {
        // Deep dive back
        if (state.deepDiveQ > 0) {
          state.deepDiveQ--;
          renderDeepDiveQuestion();
          animateBack();
          updateNav();
          return;
        } else {
          // Back to deep dive prompt
          state.inDeepDive = false;
          showScreen('screen-deep-prompt', 'back');
          updateNav();
          return;
        }
      } else {
        // Core scan back
        if (state.currentQ > 0) {
          // Undo the last recorded score
          const last = state.questionHistory.pop();
          if (last) {
            state.scores[last.domain] -= last.score;
            state.lastSelectedIndex = last.selectedIndex;
          }
          state.currentQ--;
          renderQuestion(state.lastSelectedIndex);
          animateBack();
          updateNav();
          return;
        } else {
          // Back to intake screen 3
          if (state.history.length > 0) {
            const prev = state.history.pop();
            showScreen(prev, 'back');
            updateNav();
          }
          return;
        }
      }
    }
  
    // All other screens — standard screen history pop
    if (state.history.length === 0) return;
    const prev = state.history.pop();
    showScreen(prev, 'back');
    updateNav();
  }
  
  function animateBack() {
    const qs = document.getElementById('screen-question');
    qs.classList.remove('entering', 'back');
    void qs.offsetWidth;
    qs.classList.add('back');
  }
  
  function updateNav() {
    const backBtn = document.getElementById('back-btn');
    const currentScreen = getCurrentScreen();
    // Show back button if there's screen history OR if we're mid-quiz
    const onQuestionScreen = currentScreen === 'screen-question';
    const canGoBack = state.history.length > 0 || onQuestionScreen;
    backBtn.style.display = canGoBack ? 'flex' : 'none';
  }
  
  function updateProgress(step, total) {
    const pct = Math.round((step / total) * 100);
    const fill = document.getElementById('progress-fill');
    fill.style.width = pct + '%';
  }
  

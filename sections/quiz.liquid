    document.getElementById('dp-title').textContent = dd.title;
    document.getElementById('dp-desc').textContent = dd.desc;
    const pillsEl = document.getElementById('dp-pills');
    pillsEl.innerHTML = '';
    dd.pills.forEach(p => {
      const el = document.createElement('div');
      el.className = 'dp-pill';
      el.style.borderColor = d.border;
      el.style.color = d.color;
      el.textContent = p;
      pillsEl.appendChild(el);
    });
    document.getElementById('dp-yes').style.background = 'var(--red)';
    state.history.push('screen-question');
    showScreen('screen-deep-prompt', 'forward');
    updateNav();
    updateProgress(28, 35);

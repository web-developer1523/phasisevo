<div
    class="phasis-quiz-section"
    data-section-id="{{ section.id }}"
    data-section-type="phasis-quiz"
  >
    <div class="phasis-quiz-wrapper">
      <style>
        @font-face{font-family:"Conthrax";src:url("Conthrax-BoldItalic.otf") format("opentype");font-weight:700;font-style:italic}
        @font-face{font-family:"Conthrax";src:url("Conthrax-SemiBold.otf") format("opentype");font-weight:600;font-style:normal}
        @font-face{font-family:"Conthrax";src:url("Conthrax-Italic.otf") format("opentype");font-weight:400;font-style:italic}
  
        /* ══════════════════════════════════════════════════
           PHASIS QUIZ — Mobile First
           ══════════════════════════════════════════════════ */
        :root {
          --page-bg: #080808;
          --surface: #18191C;
          --surface2: #1e1f23;
          --border: #2a2b2f;
          --border2: #383a3e;
          --off-white: #F4F3F0;
          --muted: #68717A;
          --muted-l: #9aa0a8;
  
          /* Domain colors */
          --purple: #9B6FD4;
          --teal: #00BFA8;
          --orange: #D4831A;
          --green: #4CAF7D;
          --red: #E8482A;
          --coral: #E85C7A;
          --blue: #4A90D9;
          --yellow: #D4B84A;
  
          --f-dis: 'Sora', sans-serif;
          --f-mark:'Conthrax',sans-serif;
          --f-body: 'DM Sans', sans-serif;
          --pad: 20px;
        }
  
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
        body {
          background: var(--page-bg);
          color: var(--off-white);
          font-family: var(--f-body);
          font-size: 15px;
          line-height: 1.65;
          -webkit-font-smoothing: antialiased;
          min-height: 100vh;
          overflow-x: hidden;
        }
  
        /* ── NAV ─────────────────────────────────────────── */
        .nav {
          display: flex; align-items: center; justify-content: space-between;
          padding: 0; height: 56px;
          background: rgba(8,8,8,.97); backdrop-filter: blur(20px);
          border-bottom: 1px solid var(--border);
          position: sticky; top: 0; z-index: 100;
        }
        /* Nav inner wrapper — constrains content width on wide screens */
        .nav-inner {
          display: flex; align-items: center; justify-content: space-between;
          width: 100%; max-width: 1280px; margin: 0 auto;
          padding: 0 var(--pad);
        }
        @media(min-width: 768px) { .nav-inner { padding: 0 32px; } }
        @media(min-width: 1024px) { .nav-inner { padding: 0 48px; } }
  
        .nav-brand { display: flex; align-items: center; gap: 10px; }
        .logo-mk { width: 30px; height: 30px; border-radius: 6px; background: var(--surface); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .nav-wm { font-family: var(--f-dis); font-size: 13px; font-weight: 800; font-style: italic; letter-spacing: .04em; text-transform: uppercase; }
        .nav-back { background: none; border: none; color: var(--muted-l); font-family: var(--f-dis); font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; display: flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 8px; }
        .nav-back svg { width: 14px; height: 14px; }
  
        /* ── PROGRESS ────────────────────────────────────── */
        .progress-bar {
          height: 3px; background: var(--border);
          position: sticky; top: 56px; z-index: 99;
        }
        .progress-fill {
          height: 100%; background: var(--off-white);
          transition: width .4s ease, background .4s ease;
          border-radius: 0 2px 2px 0;
        }
  
        /* ── SCREENS ─────────────────────────────────────── */
        .screen { display: none; min-height: calc(100vh - 59px); flex-direction: column; }
        .screen.active { display: flex; }
  
        /* ── INTRO SCREEN ────────────────────────────────── */
        .intro {
          flex: 1; display: flex; flex-direction: column;
          align-items: center; justify-content: center;
          padding: 48px var(--pad); text-align: center;
          position: relative; overflow: hidden;
        }
        .intro::before {
          content: '';
          position: absolute; inset: 0;
          background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(212,131,26,.06) 0%, transparent 60%);
          pointer-events: none;
        }
        .intro-badge {
          display: inline-flex; align-items: center; gap: 8px;
          background: rgba(232,72,42,.1); border: 1px solid rgba(232,72,42,.25);
          border-radius: 20px; padding: 6px 14px;
          font-family: var(--f-dis); font-size: 10px; font-weight: 700;
          letter-spacing: .12em; text-transform: uppercase; color: var(--red);
          margin-bottom: 24px;
        }
        .intro-badge::before { content: ''; width: 6px; height: 6px; background: var(--red); border-radius: 50%; animation: pulse 2s ease-in-out infinite; }
        @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }
        .intro h1 {
          font-family: var(--f-dis); font-weight: 800;
          font-size: clamp(34px, 8vw, 56px);
          letter-spacing: -.025em; line-height: .95;
          margin-bottom: 16px;
        }
        .intro h1 em { color: var(--red); font-style: normal; }
        .intro-sub {
          font-size: 15px; font-weight: 300; color: var(--muted-l);
          line-height: 1.75; max-width: 380px; margin: 0 auto 32px;
        }
        .intro-sub strong { color: var(--off-white); font-weight: 600; }
        .intro-meta {
          display: flex; align-items: center; justify-content: center;
          gap: 24px; margin-bottom: 32px; flex-wrap: wrap;
        }
        .im { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
        .im::before { content: '✓'; color: var(--red); font-weight: 700; font-size: 10px; font-family: var(--f-dis); }
        .globe-line { height: 3px; background: linear-gradient(90deg,#FF5577,#FF9999,#FF9140,#FFE899,#8AC88A,#8AF2D3,#1CA8D8,#5271FF,#8C52FF); margin-bottom: 32px; border-radius: 2px; width: 60px; }
  
        /* ── INTAKE SCREEN ───────────────────────────────── */
        .intake {
          flex: 1; display: flex; flex-direction: column;
          padding: 24px var(--pad) 20px; max-width: 520px; margin: 0 auto; width: 100%;
        }
        .intake-eyebrow {
          font-family: var(--f-mark); font-size: 10px; font-weight: 400;
          font-style: italic; letter-spacing: .22em; text-transform: uppercase;
          color: var(--red); margin-bottom: 8px; display: block;
        }
        .intake h2 {
          font-family: var(--f-dis); font-weight: 700;
          font-size: clamp(20px, 5vw, 26px);
          letter-spacing: -.02em; line-height: 1.1;
          margin-bottom: 16px;
        }
        .intake-note { display: none; }
        .intake-opts { display: flex; flex-direction: column; gap: 10px; flex: 1; }
        .iopt {
          display: flex; align-items: center; gap: 14px;
          background: var(--surface); border: 2px solid var(--border);
          border-radius: 8px; padding: 16px; cursor: pointer;
          transition: all .15s; min-height: 60px;
        }
        .iopt:hover { border-color: var(--border2); background: var(--surface2); }
        .iopt.sel { border-color: var(--red); background: rgba(232,72,42,.06); }
        .iopt-icon { font-size: 22px; flex-shrink: 0; width: 36px; text-align: center; }
        .iopt-label { font-family: var(--f-dis); font-size: 13px; font-weight: 700; margin-bottom: 2px; }
        .iopt-desc { font-size: 11px; color: var(--muted); line-height: 1.4; }
  
        /* ── QUESTION SCREEN ─────────────────────────────── */
        .question-screen {
          flex: 1; display: flex; flex-direction: column;
          padding: 28px var(--pad); max-width: 520px; margin: 0 auto; width: 100%;
        }
        .q-domain-pill {
          display: inline-flex; align-items: center; gap: 7px;
          border-radius: 20px; padding: 5px 12px; margin-bottom: 20px;
          font-family: var(--f-dis); font-size: 10px; font-weight: 700;
          letter-spacing: .1em; text-transform: uppercase;
          border: 1px solid; align-self: flex-start;
        }
        .q-num {
          font-family: var(--f-dis); font-size: 11px; font-weight: 600;
          letter-spacing: .1em; text-transform: uppercase;
          color: var(--muted); margin-bottom: 10px;
        }
        .q-text {
          font-family: var(--f-dis); font-weight: 700;
          font-size: clamp(20px, 5vw, 26px);
          letter-spacing: -.02em; line-height: 1.15;
          margin-bottom: 28px; flex: 1;
        }
        .q-opts { display: flex; flex-direction: column; gap: 10px; }
        .qopt {
          display: flex; align-items: center; justify-content: space-between;
          background: var(--surface); border: 2px solid var(--border);
          border-radius: 8px; padding: 16px 18px;
          cursor: pointer; transition: all .15s; min-height: 56px;
          font-family: var(--f-dis); font-size: 14px; font-weight: 600;
        }
        .qopt:hover { border-color: var(--border2); background: var(--surface2); }
        .qopt.sel { color: #fff; }
        .qopt-check { width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--border2); flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all .15s; }
        .qopt.sel .qopt-check { background: currentColor; border-color: currentColor; }
        .qopt-check-inner { width: 6px; height: 6px; background: #000; border-radius: 50%; display: none; }
        .qopt.sel .qopt-check-inner { display: block; }
  
        /* ── DEEP DIVE PROMPT ────────────────────────────── */
        .deep-prompt {
          flex: 1; display: flex; flex-direction: column; align-items: center;
          justify-content: center; padding: 40px var(--pad); text-align: center;
          max-width: 480px; margin: 0 auto; width: 100%;
        }
        .dp-domain-badge {
          font-size: 48px; margin-bottom: 20px;
        }
        .dp-title {
          font-family: var(--f-dis); font-weight: 800;
          font-size: clamp(24px, 5vw, 32px);
          letter-spacing: -.02em; line-height: 1.1; margin-bottom: 12px;
        }
        .dp-desc { font-size: 14px; color: var(--muted-l); line-height: 1.75; margin-bottom: 28px; }
        .dp-pills { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 28px; }
        .dp-pill {
          display: flex; align-items: center; gap: 5px;
          border: 1px solid var(--border2); border-radius: 20px;
          padding: 5px 12px; font-size: 11px; font-weight: 600;
          color: var(--muted-l); font-family: var(--f-dis);
          letter-spacing: .06em; text-transform: uppercase;
        }
  
        /* ── RESULTS ─────────────────────────────────────── */
        .results {
          flex: 1; display: flex; flex-direction: column;
          padding: 0;
        }
        .results-header {
          padding: 32px var(--pad) 24px;
          position: relative; overflow: hidden; text-align: center;
        }
        .results-header::before {
          content: ''; position: absolute; inset: 0;
          pointer-events: none;
        }
        .results-eyebrow {
          font-family: var(--f-mark); font-size: 10px; font-weight: 400;
          font-style: italic; letter-spacing: .22em; text-transform: uppercase;
          margin-bottom: 12px; display: block;
        }
        .results-title {
          font-family: var(--f-dis); font-weight: 800;
          font-size: clamp(28px, 6vw, 40px);
          letter-spacing: -.025em; line-height: .95; margin-bottom: 10px;
        }
        .results-sub { font-size: 13px; color: var(--muted-l); line-height: 1.65; max-width: 360px; margin: 0 auto; }
  
        /* Domain score bars */
        .domain-scores { padding: 0 var(--pad) 24px; }
        .ds-title {
          font-family: var(--f-dis); font-size: 10px; font-weight: 700;
          letter-spacing: .15em; text-transform: uppercase; color: var(--muted);
          margin-bottom: 14px;
        }
        .ds-item { margin-bottom: 12px; }
        .ds-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 5px; }
        .ds-name { font-family: var(--f-dis); font-size: 12px; font-weight: 600; display: flex; align-items: center; gap: 7px; }
        .ds-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
        .ds-pct { font-family: var(--f-dis); font-size: 11px; font-weight: 700; color: var(--muted); }
        .ds-track { height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; }
        .ds-fill { height: 100%; border-radius: 2px; transition: width 1s ease; }
        .ds-item.primary .ds-name { color: var(--off-white); font-size: 13px; }
        .ds-item.primary .ds-pct { color: var(--off-white); }
  
        /* Protocol sections */
        .protocol-section {
          margin: 0 var(--pad) 16px;
          background: var(--surface); border: 1px solid var(--border);
          border-radius: 10px; overflow: hidden;
        }
        .ps-header {
          padding: 16px; border-bottom: 1px solid var(--border);
          display: flex; align-items: center; gap: 12px;
        }
        .ps-icon { font-size: 22px; flex-shrink: 0; }
        .ps-label {
          font-family: var(--f-dis); font-size: 9px; font-weight: 700;
          letter-spacing: .18em; text-transform: uppercase; margin-bottom: 3px;
        }
        .ps-title { font-family: var(--f-dis); font-size: 15px; font-weight: 700; line-height: 1.2; }
        .ps-body { padding: 16px; }
        .ps-point {
          display: flex; align-items: flex-start; gap: 10px;
          font-size: 13px; color: var(--muted-l); line-height: 1.6;
          padding: 8px 0; border-bottom: 1px solid var(--border);
        }
        .ps-point:last-child { border-bottom: none; padding-bottom: 0; }
        .ps-point::before {
          content: '→'; font-size: 10px; font-weight: 700;
          flex-shrink: 0; margin-top: 3px; font-family: var(--f-dis);
        }
        .ps-point strong { color: var(--off-white); font-weight: 600; }
  
        /* Product recommendation */
        .product-rec {
          margin: 0 var(--pad) 16px;
          border-radius: 10px; overflow: hidden;
          border: 1px solid;
        }
        .pr-header {
          padding: 14px 16px; border-bottom: 1px solid;
          display: flex; align-items: center; gap: 10px;
        }
        .pr-eyebrow {
          font-family: var(--f-dis); font-size: 9px; font-weight: 700;
          letter-spacing: .18em; text-transform: uppercase; margin-bottom: 4px;
        }
        .pr-name { font-family: var(--f-dis); font-size: 17px; font-weight: 800; letter-spacing: -.01em; }
        .pr-body { padding: 16px; }
        .pr-why { font-size: 13px; color: var(--muted-l); line-height: 1.7; margin-bottom: 14px; }
        .pr-why strong { color: var(--off-white); font-weight: 600; }
        .pr-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 14px; }
        .prf { background: rgba(255,255,255,.04); border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px; }
        .prf-val { font-family: var(--f-dis); font-size: 16px; font-weight: 800; line-height: 1; margin-bottom: 3px; }
        .prf-lbl { font-size: 10px; color: var(--muted); line-height: 1.4; }
        .pr-cta {
          display: flex; align-items: center; justify-content: center; gap: 8px;
          width: 100%; padding: 15px; border-radius: 6px; border: none;
          font-family: var(--f-dis); font-size: 13px; font-weight: 700;
          letter-spacing: .08em; text-transform: uppercase; cursor: pointer;
          transition: all .15s; min-height: 52px; text-decoration: none;
        }
        .pr-cta::before { content: '●'; font-size: 6px; }
  
        /* Advanced tier */
        .advanced-tier {
          margin: 0 var(--pad) 16px;
          background: rgba(255,255,255,.02); border: 1px solid var(--border2);
          border-radius: 10px; overflow: hidden;
        }
        .at-header {
          padding: 14px 16px; border-bottom: 1px solid var(--border);
          display: flex; align-items: center; gap: 10px;
        }
        .at-badge {
          font-family: var(--f-dis); font-size: 9px; font-weight: 700;
          letter-spacing: .15em; text-transform: uppercase; color: var(--muted);
          background: var(--surface2); border: 1px solid var(--border2);
          border-radius: 4px; padding: 3px 8px; flex-shrink: 0;
        }
        .at-title { font-family: var(--f-dis); font-size: 14px; font-weight: 700; }
        .at-body { padding: 16px; }
        .at-intro { font-size: 13px; color: var(--muted-l); line-height: 1.7; margin-bottom: 14px; }
        .at-compound { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px; margin-bottom: 8px; }
        .atc-name { font-family: var(--f-dis); font-size: 13px; font-weight: 700; margin-bottom: 4px; }
        .atc-desc { font-size: 12px; color: var(--muted); line-height: 1.55; }
        .atc-tag { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; margin-top: 6px; padding: 3px 8px; border-radius: 4px; }
  
        .referral-source-link { transition: background .15s; }
        .referral-source-link:hover { background: rgba(255,255,255,.03); }
        .at-disclaimer { font-size: 11px; color: var(--muted); font-style: italic; line-height: 1.6; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); }
  
        /* Coming soon domain */
        .coming-soon-domain {
          margin: 0 var(--pad) 16px;
          background: rgba(255,255,255,.02); border: 1px dashed var(--border2);
          border-radius: 10px; padding: 16px;
          display: flex; align-items: center; gap: 14px;
        }
        .csd-icon { font-size: 24px; flex-shrink: 0; }
        .csd-title { font-family: var(--f-dis); font-size: 13px; font-weight: 700; margin-bottom: 4px; }
        .csd-desc { font-size: 12px; color: var(--muted); line-height: 1.5; }
        .csd-badge { font-family: var(--f-dis); font-size: 9px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--border); border-radius: 4px; padding: 2px 7px; display: inline-block; margin-top: 6px; }
  
        /* Email capture */
        .email-capture {
          margin: 0 var(--pad) 24px;
          background: var(--surface); border: 1px solid var(--border);
          border-radius: 10px; padding: 20px 16px;
        }
        .ec-label {
          font-family: var(--f-dis); font-size: 10px; font-weight: 700;
          letter-spacing: .15em; text-transform: uppercase; color: var(--muted);
          margin-bottom: 8px; display: block;
        }
        .ec-title { font-family: var(--f-dis); font-size: 15px; font-weight: 700; margin-bottom: 6px; }
        .ec-desc { font-size: 12px; color: var(--muted-l); margin-bottom: 14px; line-height: 1.55; }
        .ec-row { display: flex; gap: 8px; }
        .ec-input {
          flex: 1; background: var(--page-bg); border: 1px solid var(--border2);
          border-radius: 6px; color: var(--off-white); font-family: var(--f-body);
          font-size: 14px; padding: 12px 14px; outline: none; min-height: 48px;
          transition: border-color .15s;
        }
        .ec-input:focus { border-color: var(--orange); }
        .ec-input::placeholder { color: var(--muted); }
        .ec-btn {
          background: var(--orange); color: #fff; border: none; border-radius: 6px;
          font-family: var(--f-dis); font-size: 12px; font-weight: 700;
          letter-spacing: .08em; text-transform: uppercase; padding: 12px 16px;
          cursor: pointer; min-height: 48px; white-space: nowrap; flex-shrink: 0;
          transition: background .15s;
        }
        .ec-btn:hover { background: #e8941f; }
  
        /* Retake */
        .results-footer {
          padding: 0 var(--pad) 40px;
          display: flex; flex-direction: column; align-items: center; gap: 12px;
        }
        .retake-btn {
          background: none; border: 1px solid var(--border2); border-radius: 6px;
          color: var(--muted-l); font-family: var(--f-dis); font-size: 12px;
          font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
          padding: 12px 20px; cursor: pointer; min-height: 44px; transition: all .15s;
        }
        .retake-btn:hover { border-color: var(--off-white); color: var(--off-white); }
  
        /* ── BUTTONS ─────────────────────────────────────── */
        .btn-next {
          display: flex; align-items: center; justify-content: center; gap: 8px;
          width: 100%; padding: 16px; border-radius: 6px; border: none;
          background: var(--red); color: #fff;
          font-family: var(--f-dis); font-size: 14px; font-weight: 700;
          letter-spacing: .06em; text-transform: uppercase; cursor: pointer;
          transition: all .15s; min-height: 52px; margin-top: 16px;
          position: sticky; bottom: 0;
          box-shadow: 0 -8px 24px rgba(8,8,8,.8);
        }
        .btn-next:disabled { opacity: .35; cursor: not-allowed; }
        .btn-next:not(:disabled):hover { background: #f05236; }
        .btn-primary {
          display: flex; align-items: center; justify-content: center; gap: 8px;
          padding: 16px 28px; border-radius: 6px; border: none;
          background: var(--red); color: #fff;
          font-family: var(--f-dis); font-size: 14px; font-weight: 700;
          letter-spacing: .06em; text-transform: uppercase; cursor: pointer;
          transition: all .15s; min-height: 52px; width: 100%;
        }
        .btn-primary::before { content: '●'; font-size: 7px; }
        .btn-primary:hover { background: #f05236; }
        .btn-skip {
          background: none; border: none; color: var(--muted);
          font-family: var(--f-dis); font-size: 12px; font-weight: 600;
          letter-spacing: .08em; text-transform: uppercase; cursor: pointer;
          min-height: 44px; padding: 8px; text-decoration: underline;
          text-underline-offset: 3px;
        }
  
        /* ── TRANSITIONS ─────────────────────────────────── */
        .screen { animation: none; }
        .screen.entering { animation: slideIn .3s ease forwards; }
        @keyframes slideIn { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: translateX(0); } }
        @keyframes slideBack { from { opacity: 0; transform: translateX(-24px); } to { opacity: 1; transform: translateX(0); } }
        .screen.back { animation: slideBack .3s ease forwards; }
  
        @media(min-width: 768px) {
          :root { --pad: 40px; }
          .question-screen, .intake, .deep-prompt { max-width: 560px; padding-top: 48px; }
          .results { max-width: 600px; margin: 0 auto; }
          .results-header { padding: 48px 40px 32px; }

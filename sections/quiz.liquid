  function renderDeepDiveQuestion() {
    const domain = state.deepDiveDomain;
    const d = DOMAINS[domain];
    const dd = DEEP_DIVE[domain];
    const q = dd.questions[state.deepDiveQ];
    const total = dd.questions.length;
  
    updateProgress(29 + state.deepDiveQ, 35);
  
    const pill = document.getElementById('q-domain-pill');
    pill.textContent = '🔍 Deep Dive — ' + d.name;
    pill.style.background = d.bg;
    pill.style.borderColor = d.border;
    pill.style.color = d.color;
  
    document.getElementById('q-num').textContent = 'Deep Dive — ' + (state.deepDiveQ + 1) + ' of ' + total;
    document.getElementById('q-text').textContent = q.text;
  
    const optsEl = document.getElementById('q-opts');
    optsEl.innerHTML = '';
    q.opts.forEach((opt) => {
      const div = document.createElement('div');
      div.className = 'qopt';
      div.innerHTML = '<span>' + opt + '</span><span class="qopt-check"><span class="qopt-check-inner"></span></span>';
      (function(capturedIndex) {
        div.addEventListener('click', function() {
          optsEl.querySelectorAll('.qopt').forEach(o => {
            o.classList.remove('sel');
            o.style.borderColor = '';
            o.style.background = '';
            o.style.color = '';
          });
          div.classList.add('sel');
          div.style.borderColor = d.color;
          div.style.background = d.bg;
          div.style.color = d.color;
          document.getElementById('q-next').disabled = false;
          document.getElementById('q-next').dataset.score = 0;
          document.getElementById('q-next').dataset.domain = domain;
          document.getElementById('q-next').dataset.deepDiveAnswerIndex = capturedIndex;
        });
      })(optsEl.children.length); // capture current option index
      optsEl.appendChild(div);
    });
    document.getElementById('q-next').disabled = true;
    document.getElementById('q-next').onclick = nextDeepDiveQuestion;
  }
  
  function nextDeepDiveQuestion() {
    // Store the selected answer index before advancing
    var btn = document.getElementById('q-next');
    var answerIndex = parseInt(btn.dataset.deepDiveAnswerIndex || '0');
    var domain = state.deepDiveDomain;
    if (!state.deepDiveAnswers[domain]) state.deepDiveAnswers[domain] = [];
    state.deepDiveAnswers[domain][state.deepDiveQ] = answerIndex;
  
    state.deepDiveQ++;
    if (state.deepDiveQ < DEEP_DIVE[state.deepDiveDomain].questions.length) {
      renderDeepDiveQuestion();
      const qs = document.getElementById('screen-question');
      qs.classList.remove('entering');
      void qs.offsetWidth;
      qs.classList.add('entering');
    } else {
      showResults();
    }
  }
  

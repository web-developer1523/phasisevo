          (DOMAINS[secondDomain] ? DOMAINS[secondDomain].name : secondDomain) +
          ' protocol follows in 2 days.</span>'
        : '',
      '</div></div>'
    ].join('');
  
    // Scroll to protocol
    setTimeout(function() {
      var zone = document.getElementById('protocol-zone');
      if (zone) zone.scrollIntoView({ behavior: 'smooth' });

  // ── EMAIL CAPTURE ─────────────────────────────────────────────────────────────
  function captureEmail() {
    var email = document.getElementById('ec-email');
    if (!email || !email.value || !email.value.includes('@')) {
      email.style.borderColor = '#E8482A';
      return;
    }
  
    // ── Build ranked domain data ───────────────────────────────────────────
    var ranked = getRankedDomains();
    var topDomain    = state.deepDiveDomain || ranked[0];
    var secondDomain = ranked[1] || '';
  
    function domainPriority(d) {
      return getDomainPriority(d);
    }
    function domainRaw(d) { return state.scores[d] || 0; }
  
    var topScore    = domainPriority(topDomain);
    var secondScore = domainPriority(secondDomain);
  
    var sendSecondEmail = secondScore >= PRIORITY_THRESHOLDS.secondary_min;
    var klaviyoQuizProps = buildKlaviyoQuizProperties(
      ranked,
      topDomain,
      secondDomain,
      sendSecondEmail
    );
  
    // ── Klaviyo identify — sets profile properties ─────────────────────────
    if (typeof _learnq !== 'undefined') {
      var identifyPayload = {
        '$email': email.value,
  
        // Domain results
        'quiz_top_domain':          topDomain,
        'quiz_top_domain_score':    topScore,
        'quiz_second_domain':       secondDomain,
        'quiz_second_domain_score': secondScore,
        'quiz_send_second_email':   sendSecondEmail,
        'primary_domain':           topDomain,
        {% comment %} 'secondary_domain':         secondDomain || null, {% endcomment %}
  
        // Quiz inputs
        'quiz_age':         state.intake.age       || '',
        'quiz_training':    state.intake.training  || '',
        'quiz_goal':        state.intake.goal      || '',
        'quiz_supplements': state.intake.supplements || '',
        'quiz_gender':      state.intake.gender     || '',
        'quiz_diet':        state.intake.diet       || '',
  
        // All 6 domain scores (useful for segmentation later)
        'quiz_score_sleep':     domainRaw('sleep'),
        'quiz_score_stress':    domainRaw('stress'),
        'quiz_score_energy':    domainRaw('energy'),
        'quiz_score_physical':  domainRaw('physical'),
        'quiz_score_mood':      domainRaw('mood'),
        'quiz_score_digestion': domainRaw('digestion'),
      };
      Object.keys(klaviyoQuizProps).forEach(function(key) {
        identifyPayload[key] = klaviyoQuizProps[key];
      });
  
      _learnq.push(['identify', identifyPayload]);
  
      // ── Klaviyo track — fires the event that triggers the flow ─────────────
      // This is what Klaviyo listens for to start the email sequence.
      // All domain-specific flow filters check event properties below.
      _learnq.push(['track', 'Completed PHASIS Quiz', {
        'top_domain':              topDomain,
        'top_domain_score':        topScore,
        'second_domain':           secondDomain,
        'second_domain_score':     secondScore,
        'send_second_email':       sendSecondEmail,
        'supplement_preference':   state.intake.supplements || '',
        'age_bracket':             state.intake.age         || '',
        'training_level':          state.intake.training    || '',
      }]);
    }
  
    // ── GA4 event ──────────────────────────────────────────────────────────
    if (typeof gtag !== 'undefined') {
      gtag('event', 'phasis_quiz_completed', {
        quiz_top_domain:    topDomain,
        quiz_top_score:     topScore,
        quiz_second_domain: secondDomain,
        quiz_supplements:   state.intake.supplements || ''
      });
    }
  
    // ── Confirmation UI ────────────────────────────────────────────────────
    var container = document.getElementById('ec-email').parentElement.parentElement;
    container.innerHTML = [
      '<div style="text-align:center;padding:16px">',
      '<div style="font-family:var(--f-dis);font-size:16px;font-weight:700;',
      'color:var(--off-white);margin-bottom:8px">Protocol sent ✓</div>',
      '<div style="font-size:12px;color:var(--muted-l);line-height:1.7">',
      'Check your inbox — your full ',
      DOMAINS[topDomain] ? DOMAINS[topDomain].name : topDomain,
      ' protocol is on its way.',

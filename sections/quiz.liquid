  function buildFullProtocol(domain, domainData, isBeginner, isTested) {
    var html = '';
    var c = domainData.color;
    var isClean = state.intake.supplements === 'clean';
    var isOpen  = state.intake.supplements === 'open';
    var suppData = getSupplementProtocol(domain);
    var ageNotes = getAgeModifiers(domain);
  
    // Build full list with tier label
    var tiers = [
      { key: 'tier1', label: 'Tier 1 — Foundation', color: '#4A9E5C', items: suppData.tier1 || [] },
      { key: 'tier2', label: 'Tier 2 — Targeted',   color: c,         items: (!isClean && suppData.tier2) ? suppData.tier2 : [] },
      { key: 'tier3', label: 'Tier 3 — Advanced',   color: '#9B6FD4', items: (isOpen && suppData.tier3) ? suppData.tier3 : [] },
      { key: 'botanical', label: '🌿 Botanical Protocol', color: '#00BFA8', items: suppData.botanical || [] }
    ];
  
    var tierDescriptions = {
      tier1: 'Foundation compounds — address the most common deficiencies in this domain. Show to every user.',
      tier2: 'Targeted additions with specific mechanisms for this domain.',
      tier3: 'Advanced compounds — higher cost or specialised. Not a starting point.',
      botanical: 'Clinical herbal protocols sourced to Mills & Bone (Principles and Practice of Phytotherapy) and Hoffmann (Medical Herbalism).'
    };
  
    tiers.forEach(function(tier) {
      if (!tier.items || tier.items.length === 0) return;
  
      html += '<div style="margin-bottom:18px">';
      html += '<div style="font-family:var(--f-dis);font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:' + tier.color + ';margin-bottom:4px">' + tier.label + '</div>';
      html += '<div style="font-size:10px;color:var(--muted);margin-bottom:10px;line-height:1.5">' + tierDescriptions[tier.key] + '</div>';
  
      tier.items.forEach(function(s, si) {
        var isLast = si === tier.items.length - 1;
        html += '<div style="padding:10px 12px;background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:8px;' + (isLast ? '' : 'margin-bottom:6px') + '">';
  
        // Name + dose row
        html += '<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:7px">';
        html += '<div style="font-family:var(--f-dis);font-size:13px;font-weight:700;color:var(--off-white)">' + s.name + '</div>';
        html += '<div style="font-family:var(--f-dis);font-size:11px;font-weight:600;color:' + tier.color + ';white-space:nowrap;flex-shrink:0">' + s.dose + '</div>';
        html += '</div>';
        if (s.desc) html += '<div style="font-size:12px;color:var(--muted-l);line-height:1.6;margin-bottom:7px;padding:8px 10px;background:rgba(255,255,255,.03);border-radius:5px;border-left:2px solid ' + tier.color + '">' + s.desc + '</div>';
  
        // Timing + TTE row
        html += '<div style="display:flex;align-items:center;gap:12px;margin-bottom:6px">';
        html += '<div style="font-size:11px;color:var(--muted-l)">⏰ ' + s.timing + '</div>';
        if (s.tte) html += '<div style="font-size:11px;color:' + tier.color + '">↻ ' + s.tte + '</div>';
        html += '</div>';
  
        html += '</div>';
      });
  
      html += '</div>';
    });
  
    // Age modifier note
    if (ageNotes && ageNotes.length > 0) {
      html += '<div style="background:' + domainData.bg + ';border-left:3px solid ' + c + ';border-radius:0 6px 6px 0;padding:10px 12px;margin-top:4px">';
      html += '<div style="font-family:var(--f-dis);font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:' + c + ';margin-bottom:4px">At your age</div>';
      html += '<div style="font-size:11px;color:var(--muted-l);line-height:1.65">' + ageNotes[0] + '</div>';
      html += '</div>';
    }
  
    return html;
  }
  
  
  function toggleAccordion(el) {

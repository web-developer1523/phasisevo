      html += renderDomainSection(top, topD, true, isBeginner, isTested, showAdvanced);
    } else {
      html += '<div style="margin:0 20px 20px;border:1px solid var(--border);border-radius:10px;background:var(--surface);padding:18px">';
      html += '<div style="font-family:var(--f-dis);font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:10px">Foundation Routine</div>';
      html += '<div style="font-size:13px;color:var(--muted-l);line-height:1.7">You\'re well-balanced across all six areas. Keep momentum with consistent sleep timing, daily hydration and minerals, whole-food meals with protein and fiber, and 1-2 weekly recovery sessions.</div>';
      html += '</div>';
    }
    html += '</div>';
  
    // ── ZONE 6 — SECONDARY DOMAIN SECTION ────────────────────────────────
    if (hasSecondary && secondD) {
      html += renderDomainSection(second, secondD, false, isBeginner, isTested, showAdvanced);
    }
  
    // ── ZONE 7 — FOOTER ───────────────────────────────────────────────────
    html += '<div class="results-footer">';
    html += '<a href="/pages/phasis-shop" class="btn-primary" style="max-width:360px">EXPLORE PHASIS PRODUCTS</a>';
    html += '<button class="retake-btn" onclick="retakeQuiz()">↺ Retake Assessment</button>';
    html += '</div>';
  
    document.getElementById('results-container').innerHTML = html;
    state.history.push('screen-deep-prompt');
    showScreen('screen-results', 'forward');
    document.getElementById('back-btn').style.display = 'none';
    updateProgress(35, 35);
  
    setTimeout(function() {
      document.querySelectorAll('.ds-fill').forEach(function(el) {
        var w = el.style.width;
        el.style.width = '0%';
        setTimeout(function() { el.style.width = w; }, 50);
      });
    }, 100);
  }
  
  
  function skipEmail() {
    var zone = document.getElementById('protocol-zone');
    if (zone) zone.scrollIntoView({ behavior: 'smooth' });
  }
  
  
  function buildProtocol(domain, isPrimary, showAdvanced, isTested, isBeginner) {
    let html = '';
    const d = DOMAINS[domain];
  
    // Beginner banner — shown at top of first domain for newcomers
    if (isBeginner && isPrimary) {
      html += '<div style="background:rgba(74,158,92,.08);border:1px solid rgba(74,158,92,.25);border-radius:10px;padding:16px;margin-bottom:16px;display:flex;align-items:flex-start;gap:12px">';
      html += '<span style="font-size:22px;flex-shrink:0">🌱</span>';
      html += '<div>';
      html += '<div style="font-family:var(--f-dis);font-size:13px;font-weight:700;margin-bottom:6px">Starting from scratch — that\'s your advantage.</div>';
      html += '<p style="font-size:12px;color:var(--muted-l);line-height:1.65;margin:0">The protocol below is built for someone building from the ground up. Start with the foundation habits. Everything else comes after. You don\'t need to do it all at once — you just need to begin.</p>';
      html += '</div></div>';
    }
  
    // Holistic protocol
    const protocols = getHolisticProtocol(domain);
    html += '<div class="protocol-section">';
    html += '<div class="ps-header" style="background:' + d.bg + ';border-color:' + d.border + '">';
    html += '<span class="ps-icon">' + d.emoji + '</span><div>';
    html += '<div class="ps-label" style="color:' + d.color + '">' + (isPrimary ? 'Primary Focus' : 'Secondary Focus') + ' · ' + d.name + '</div>';
    html += '<div class="ps-title">Foundation Protocol — Start Here</div>';
    html += '</div></div>';
    html += '<div class="ps-body">';
    protocols.forEach(function(p) {
      html += '<div class="ps-point"><strong>' + p.title + '</strong> — ' + p.desc + '</div>';
    });
  
    // Age-specific modifier
    var ageNotes = getAgeModifiers(domain);
    if (ageNotes.length > 0) {
      var age = state.intake.age;
      html += '<div class="ps-point" style="border-left:3px solid ' + d.color + ';background:rgba(255,255,255,.03);margin-top:4px"><strong>At your stage (' + age + ')</strong> — ' + ageNotes[0] + '</div>';
    }
  
    html += '</div></div>';
  
    // Product recommendation — suppressed for beginners, shown when they are ready
    const product = getProductForDomain(domain);
    if (product && !isBeginner) {
      html += buildProductCard(product, d, isTested);
    } else if (product && isBeginner) {
      html += '<div style="background:rgba(255,255,255,.02);border:1px dashed var(--border2);border-radius:10px;padding:16px;margin-bottom:16px;display:flex;align-items:center;gap:14px">';
      html += '<span style="font-size:22px;flex-shrink:0">' + product.emoji + '</span>';
      html += '<div><div style="font-family:var(--f-dis);font-size:13px;font-weight:700;margin-bottom:4px">' + product.name + ' — when you\'re ready</div>';
      html += '<div style="font-size:12px;color:var(--muted);line-height:1.55">Get the foundation habits in place first. Once you\'re consistent, ' + product.name + ' is built exactly for this domain.</div>';
      html += '<a href="' + product.link + '" style="display:inline-flex;align-items:center;gap:5px;font-family:var(--f-dis);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-l);text-decoration:none;margin-top:8px">Learn more →</a>';
      html += '</div></div>';
    } else {
      // Coming soon for unmapped domains
      html += '<div class="coming-soon-domain">';
      html += '<span class="csd-icon">' + d.emoji + '</span>';
      html += '<div><div class="csd-title">' + d.name + ' — Targeted Support</div>';
      html += '<div class="csd-desc">We are developing targeted products for this area. The foundation protocol above is the right starting point.</div>';
      html += '<span class="csd-badge">Products Coming</span></div>';
      html += '</div>';
    }
  
    // Advanced tier — only for physical domain if user is open
    if (domain === 'physical' && showAdvanced) {
      html += buildAdvancedTier(isTested);
    }
  
    // Professional referral card — for domains where clinical support matters
    var referralDomains = ['stress', 'mood', 'sleep', 'digestion', 'physical'];
    if (referralDomains.indexOf(domain) > -1) {
      html += buildReferralCard(domain);
    }
  
    return html;
  }
  
  function buildProductCard(product, domainData, isTested) {
    var c = domainData.color;
    var bg = domainData.bg;
    var border = domainData.border;
    var supp = state.intake.supplements;
    var html = '';
  
    html += '<div style="margin-bottom:20px;border-radius:12px;overflow:hidden;border:1px solid ' + border + ';background:' + bg + ';position:relative">';
    html += '<div style="height:3px;background:' + c + ';width:100%"></div>';
  
    // Header row
    html += '<div style="padding:14px 16px 0;display:flex;align-items:center;justify-content:space-between">';
    html += '<div style="font-size:9px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:' + c + '">Your Protocol Recommends</div>';
    html += '<div style="font-size:9px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);background:rgba(255,255,255,.05);border-radius:4px;padding:3px 8px">From ' + product.price.split(' ')[1] + '</div>';
    html += '</div>';
  
    // Product name
    html += '<div style="padding:10px 16px 14px;border-bottom:1px solid ' + border + ';display:flex;align-items:center;gap:12px">';
    html += '<span style="font-size:32px">' + product.emoji + '</span>';
    html += '<div>';
    html += '<div style="font-family:var(--f-dis);font-size:22px;font-weight:800;letter-spacing:-.02em;line-height:1">' + product.name + '</div>';
    html += '<div style="font-size:11px;color:var(--muted-l);margin-top:4px">' + domainData.name + ' · PHASIS</div>';
    html += '</div>';
    html += '</div>';
  
    html += '<div style="padding:14px 16px">';
  
    // Clean user note — honest disclosure before the why copy
    if (product.cleanNote) {
      html += '<div style="display:flex;align-items:flex-start;gap:8px;background:rgba(255,255,255,.03);border:1px solid var(--border2);border-radius:6px;padding:10px 12px;margin-bottom:12px">';
      html += '<span style="font-size:14px;flex-shrink:0">🌿</span>';
      html += '<div style="font-size:11px;color:var(--muted-l);line-height:1.6">' + product.cleanNote + '</div>';
      html += '</div>';
    }
  
    html += '<p style="font-size:13px;color:var(--muted-l);line-height:1.7;margin-bottom:14px">' + product.why + '</p>';
  
    // Key facts
    html += '<div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px">';
    product.facts.forEach(function(f) {
      html += '<div style="background:rgba(255,255,255,.05);border:1px solid ' + border + ';border-radius:6px;padding:6px 10px;display:flex;flex-direction:column;align-items:center;min-width:70px">';
      html += '<div style="font-family:var(--f-dis);font-size:13px;font-weight:800;color:' + c + ';line-height:1">' + f.val + '</div>';
      html += '<div style="font-family:var(--f-dis);font-size:9px;font-weight:600;color:var(--muted);letter-spacing:.05em;text-transform:uppercase;margin-top:3px;text-align:center">' + f.lbl + '</div>';
      html += '</div>';
    });
    html += '</div>';
  
    // Drug-tested note
    if (isTested) {
      html += '<div style="background:rgba(0,191,168,.08);border:1px solid rgba(0,191,168,.2);border-radius:6px;padding:10px 12px;margin-bottom:14px;font-size:12px;color:#00BFA8"><strong style="color:#F4F3F0">Drug-tested athlete:</strong> ' + product.name + ' is verified sport-safe. 3rd party tested every batch. Not on the WADA prohibited list.</div>';
    }
  
    // Primary CTA
    html += '<a href="' + product.link + '" style="display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:17px;border-radius:8px;border:none;background:' + c + ';color:#fff;font-family:var(--f-dis);font-size:14px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;min-height:56px;box-shadow:0 4px 20px ' + c + '33;margin-bottom:10px">';
    html += '<span style="font-size:7px">●</span> GET ' + product.name.toUpperCase() + ' — ' + product.price;
    html += '</a>';
  
    // Trust row
    html += '<div style="display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap">';
    html += '<span style="font-size:11px;color:var(--muted);display:flex;align-items:center;gap:4px"><span style="color:' + c + ';font-weight:700;font-size:10px">✓</span>30-day guarantee</span>';
    html += '<span style="font-size:11px;color:var(--muted);display:flex;align-items:center;gap:4px"><span style="color:' + c + ';font-weight:700;font-size:10px">✓</span>3rd party tested</span>';
    html += '<span style="font-size:11px;color:var(--muted);display:flex;align-items:center;gap:4px"><span style="color:' + c + ';font-weight:700;font-size:10px">✓</span>Free shipping $75+</span>';
    html += '</div>';
  
    html += '</div></div>';
    return html;
  }function selectIntakeDiet(value, el) {
    document.getElementById('intake-diet-opts').querySelectorAll('.iopt').forEach(function(o) { o.classList.remove('sel'); });
    el.classList.add('sel');
    state.intake.diet = value;
    document.getElementById('intake-diet-next').disabled = false;
  }
  </script>
  

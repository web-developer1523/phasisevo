            ]
          }
        };
  
        // ══════════════════════════════════════════════════
        // STATE
        // ══════════════════════════════════════════════════
  
        let state = {
          intake: { goal: null, training: null, supplements: null, age: null },
          scores: { sleep: 0, stress: 0, energy: 0, digestion: 0, physical: 0, mood: 0 },
          maxScores: { sleep: 0, stress: 0, energy: 0, digestion: 0, physical: 0, mood: 0 },
          currentQ: 0,
          inDeepDive: false,
          deepDiveDomain: null,
          deepDiveQ: 0,
          history: [],
          questionHistory: [], // tracks {score, domain, selectedIndex} per question
          answered: false
        };
  
        // Count max scores per domain
        QUESTIONS.forEach(q => { if (state.maxScores[q.domain] !== undefined) state.maxScores[q.domain] += 2; });
  
        // ══════════════════════════════════════════════════
        // NAVIGATION
        // ══════════════════════════════════════════════════
  
        function showScreen(id, direction) {
          document.querySelectorAll('.screen').forEach(s => s.classList.remove('active', 'entering', 'back'));
          const target = document.getElementById(id);
          target.classList.add('active');
          if (direction === 'forward') target.classList.add('entering');
          if (direction === 'back') target.classList.add('back');
          window.scrollTo(0, 0);
        }
  
        function nextScreen(id) {
          state.history.push(getCurrentScreen());
          showScreen(id, 'forward');
          updateNav();
        }
  
        function getCurrentScreen() {
          return document.querySelector('.screen.active').id;
        }
  
        function goBack() {
          const currentScreen = getCurrentScreen();
  
          // If on question screen — go back one question
          if (currentScreen === 'screen-question') {
            if (state.inDeepDive) {
              // Deep dive back
              if (state.deepDiveQ > 0) {
                state.deepDiveQ--;
                renderDeepDiveQuestion();
                animateBack();
                updateNav();
                return;
              } else {
                // Back to deep dive prompt
                state.inDeepDive = false;
                showScreen('screen-deep-prompt', 'back');
                updateNav();
                return;
              }
            } else {
              // Core scan back
              if (state.currentQ > 0) {
                // Undo the last recorded score
                const last = state.questionHistory.pop();
                if (last) {
                  state.scores[last.domain] -= last.score;
                  state.lastSelectedIndex = last.selectedIndex;
                }
                state.currentQ--;
                renderQuestion(state.lastSelectedIndex);
                animateBack();
                updateNav();
                return;
              } else {
                // Back to intake screen 3
                if (state.history.length > 0) {
                  const prev = state.history.pop();
                  showScreen(prev, 'back');
                  updateNav();
                }
                return;
              }
            }
          }
  
          // All other screens — standard screen history pop
          if (state.history.length === 0) return;
          const prev = state.history.pop();
          showScreen(prev, 'back');
          updateNav();
        }
  
        function animateBack() {
          const qs = document.getElementById('screen-question');
          qs.classList.remove('entering', 'back');
          void qs.offsetWidth;
          qs.classList.add('back');
        }
  
        function updateNav() {
          const backBtn = document.getElementById('back-btn');
          const currentScreen = getCurrentScreen();
          // Show back button if there's screen history OR if we're mid-quiz
          const onQuestionScreen = currentScreen === 'screen-question';
          const canGoBack = state.history.length > 0 || onQuestionScreen;
          backBtn.style.display = canGoBack ? 'flex' : 'none';
        }
  
        function updateProgress(step, total) {
          const pct = Math.round((step / total) * 100);
          const fill = document.getElementById('progress-fill');
          fill.style.width = pct + '%';
        }
  
        // ══════════════════════════════════════════════════
        // INTAKE
        // ══════════════════════════════════════════════════
  
        function startQuiz() {
          state.history.push('screen-intro');
          showScreen('screen-intake-1', 'forward');
          updateNav();
          updateProgress(1, 30);
        }
  
        function selectIntake(step, value, el) {
          const container = document.getElementById('intake-' + step + '-opts');
          container.querySelectorAll('.iopt').forEach(o => o.classList.remove('sel'));
          el.classList.add('sel');
          const key = ['goal', 'training', 'supplements'][step - 1]; // age handled separately
          state.intake[key] = value;
          document.getElementById('intake-' + step + '-next').disabled = false;
        }
  
        function selectIntakeAge(value, el) {
          document.getElementById('intake-age-opts').querySelectorAll('.iopt').forEach(function(o) { o.classList.remove('sel'); });
          el.classList.add('sel');
          state.intake.age = value;
          document.getElementById('intake-age-next').disabled = false;
        }
  
        // ══════════════════════════════════════════════════
        // CORE SCAN
        // ══════════════════════════════════════════════════
  
        function startCoreScan() {
          state.history.push('screen-intake-age');
          state.currentQ = 0;
          renderQuestion();
          showScreen('screen-question', 'forward');
          updateNav();
        }
  
        function renderQuestion(restoredIndex) {
          const q = QUESTIONS[state.currentQ];
          const d = DOMAINS[q.domain];
          const total = QUESTIONS.length;
          const current = state.currentQ + 1;
  
          updateProgress(4 + state.currentQ, 4 + total + 5);
  
          // Domain pill
          const pill = document.getElementById('q-domain-pill');
          pill.textContent = d.icon + ' ' + d.name;
          pill.style.background = d.bg;
          pill.style.borderColor = d.border;
          pill.style.color = d.color;
  
          document.getElementById('q-num').textContent = 'Question ' + current + ' of ' + total;
          document.getElementById('q-text').textContent = q.text;
  
          const optsEl = document.getElementById('q-opts');
          optsEl.innerHTML = '';
          const nextBtn = document.getElementById('q-next');
          nextBtn.disabled = true;
          delete nextBtn.dataset.score;
          nextBtn.onclick = nextQuestion;
  
          q.opts.forEach((opt, i) => {
            const score = i;
            const div = document.createElement('div');
            div.className = 'qopt';
            div.innerHTML = '<span>' + opt + '</span><span class="qopt-check"><span class="qopt-check-inner"></span></span>';
  
            // Restore previously selected answer if going back
            if (restoredIndex === i) {
              div.classList.add('sel');
              div.style.borderColor = d.color;
              div.style.background = d.bg;
              div.style.color = d.color;
              nextBtn.disabled = false;
              nextBtn.dataset.score = score;
              nextBtn.dataset.domain = q.domain;
            }
  
            div.addEventListener('click', function() {
              optsEl.querySelectorAll('.qopt').forEach(o => {
                o.classList.remove('sel');
                o.style.borderColor = '';
                o.style.background = '';
                o.style.color = '';
              });
              div.classList.add('sel');
              div.style.borderColor = d.color;
              div.style.background = d.bg;
              div.style.color = d.color;
              nextBtn.disabled = false;
              nextBtn.dataset.score = score;
              nextBtn.dataset.domain = q.domain;
              nextBtn.dataset.selectedIndex = i;
            });
            optsEl.appendChild(div);
          });
  
          if (restoredIndex !== undefined) {
            nextBtn.dataset.selectedIndex = restoredIndex;
          }
        }
  
        function nextQuestion() {
          const btn = document.getElementById('q-next');
          const score = parseInt(btn.dataset.score);
          const domain = btn.dataset.domain;
          const selectedIndex = parseInt(btn.dataset.selectedIndex) || score;
  
          // Save this answer to history before advancing
          state.questionHistory.push({ score, domain, selectedIndex });
          state.scores[domain] += score;
          state.currentQ++;
  
          if (state.currentQ < QUESTIONS.length) {
            renderQuestion();
            const qs = document.getElementById('screen-question');
            qs.classList.remove('entering', 'back');
            void qs.offsetWidth;
            qs.classList.add('entering');
          } else {
            const topDomain = getTopDomain();
            state.deepDiveDomain = topDomain;
            showDeepDivePrompt(topDomain);
          }
        }
  
        function getTopDomain() {
          let top = null, topPct = 0;
          Object.keys(state.scores).forEach(d => {
            const max = state.maxScores[d];
            const pct = max > 0 ? state.scores[d] / max : 0;
            if (pct > topPct) { topPct = pct; top = d; }
          });
          return top;
        }
  
        function getRankedDomains() {
          return Object.keys(state.scores).sort((a, b) => {
            const pctA = state.maxScores[a] > 0 ? state.scores[a] / state.maxScores[a] : 0;
            const pctB = state.maxScores[b] > 0 ? state.scores[b] / state.maxScores[b] : 0;
            return pctB - pctA;
          });
        }
  
        // ══════════════════════════════════════════════════
        // DEEP DIVE
        // ══════════════════════════════════════════════════
  
        function showDeepDivePrompt(domain) {
          const d = DOMAINS[domain];
          const dd = DEEP_DIVE[domain];
          document.getElementById('dp-icon').textContent = d.emoji;
          document.getElementById('dp-title').textContent = dd.title;
          document.getElementById('dp-desc').textContent = dd.desc;
          const pillsEl = document.getElementById('dp-pills');
          pillsEl.innerHTML = '';
          dd.pills.forEach(p => {
            const el = document.createElement('div');
            el.className = 'dp-pill';
            el.style.borderColor = d.border;
            el.style.color = d.color;
            el.textContent = p;
            pillsEl.appendChild(el);
          });
          document.getElementById('dp-yes').style.background = 'var(--red)';
          state.history.push('screen-question');
          showScreen('screen-deep-prompt', 'forward');
          updateNav();
          updateProgress(28, 35);
        }
  
        function startDeepDive() {
          state.inDeepDive = true;
          state.deepDiveQ = 0;
          renderDeepDiveQuestion();
          showScreen('screen-question', 'forward');
          updateNav();
        }
  
        function skipDeepDive() {
          showResults();
        }
  
        function renderDeepDiveQuestion() {
          const domain = state.deepDiveDomain;
          const d = DOMAINS[domain];
          const dd = DEEP_DIVE[domain];
          const q = dd.questions[state.deepDiveQ];
          const total = dd.questions.length;
  
          updateProgress(29 + state.deepDiveQ, 35);
  
          const pill = document.getElementById('q-domain-pill');
          pill.textContent = '🔍 Deep Dive — ' + d.name;
          pill.style.background = d.bg;
          pill.style.borderColor = d.border;
          pill.style.color = d.color;
  
          document.getElementById('q-num').textContent = 'Deep Dive — ' + (state.deepDiveQ + 1) + ' of ' + total;
          document.getElementById('q-text').textContent = q.text;
  
          const optsEl = document.getElementById('q-opts');
          optsEl.innerHTML = '';
          q.opts.forEach((opt) => {
            const div = document.createElement('div');
            div.className = 'qopt';
            div.innerHTML = '<span>' + opt + '</span><span class="qopt-check"><span class="qopt-check-inner"></span></span>';
            div.addEventListener('click', function() {
              optsEl.querySelectorAll('.qopt').forEach(o => {
                o.classList.remove('sel');
                o.style.borderColor = '';
                o.style.background = '';
                o.style.color = '';
              });
              div.classList.add('sel');
              div.style.borderColor = d.color;
              div.style.background = d.bg;
              div.style.color = d.color;
              document.getElementById('q-next').disabled = false;
              document.getElementById('q-next').dataset.score = 0;
              document.getElementById('q-next').dataset.domain = domain;
            });
            optsEl.appendChild(div);
          });
          document.getElementById('q-next').disabled = true;
          document.getElementById('q-next').onclick = nextDeepDiveQuestion;
        }
  
        function nextDeepDiveQuestion() {
          state.deepDiveQ++;
          if (state.deepDiveQ < DEEP_DIVE[state.deepDiveDomain].questions.length) {
            renderDeepDiveQuestion();
            const qs = document.getElementById('screen-question');
            qs.classList.remove('entering');
            void qs.offsetWidth;
            qs.classList.add('entering');
          } else {
            showResults();
          }
        }
  

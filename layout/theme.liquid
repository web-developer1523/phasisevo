<!doctype html>
<html
  class="no-js"
  data-scheme="{{ settings.color_scheme }}"
  lang="{{ request.locale.iso_code }}"
  dir="{% render 'direction' %}"
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <meta name="facebook-domain-verification" content="oztcibvif0br4xnc787bxu2xvw5noh" />
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    <!-- Open Graph / Social Meta for Quiz Page -->
    {% if template == 'page' and page.handle == 'quiz' %}
      <meta property="og:title" content="What Supplements Should I Take? Free Quiz — PHASIS">
      <meta
        property="og:description"
        content="Answer a few questions about your goals and get a personalised wellness protocol. Free. Takes a few minutes."
      >
    {% endif %}
    <!-- collecton/all -->
    {% if template == 'collection' and collection.handle == 'all' %}
      <meta
        name="description"
        content="Shop PHASIS — CBD pain balm, mineral electrolyte drops, and ecdysterone capsules. Third-party tested. 30-day guarantee. Free shipping over $75."
      >
    {% endif %}

   {% if template.name == 'cart' or request.path == '/cart' %}
      <meta
        name="description"
        content="Review your PHASIS order - CBD topicals, mineral electrolytes, and ecdysterone capsules. Free shipping on orders $100+. 30-day guarantee. Secure checkout."
      >
    {% endif %}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- unless settings.type_header_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>{{ page_title }}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
   
     {% if template.name == 'cart' or template.name == 'search' or request.path == '/cart' or request.path == '/search' %}
    <meta name="robots" content="noindex, follow">
  {% endif %}

   
    {% render 'meta-tags' %}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    {%- if settings.quickview_show or settings.add_to_cart_enabled or settings.show_on_mobile -%}
      <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
    {% endif %}

    <script src="{{ 'custom-global.js' | asset_url }}" defer="defer"></script>

    <script>
      function calculateScrollbarWidth() {
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        document.documentElement.style.setProperty('--scrollbar-width', scrollbarWidth + 'px');
      }

      function calculateVh() {
        let vh = window.innerHeight * 0.01;
        document.documentElement.style.setProperty('--vh', `${vh}px`);
      }

      window.addEventListener('load', calculateScrollbarWidth);
      window.addEventListener('resize', calculateScrollbarWidth);

      window.addEventListener('load', calculateVh);
      window.addEventListener('resize', calculateVh);
    </script>
    <!-- Google Tag Manager -->
    <script>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-5J49RJML';
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-5J49RJML');
    </script>
    <!-- End Google Tag Manager -->


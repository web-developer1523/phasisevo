{% if  page.handle == 'faq' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I place an order?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Browse our products on the Shop page, select your size or quantity, and click Add to Cart. Proceed to checkout to enter your shipping information and payment details. You'll receive an order confirmation email immediately after purchase."
      }
    },
    {
      "@type": "Question",
      "name": "Will the CBD show up on a drug test?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Max Relief is a topical it doesn't enter the bloodstream in meaningful amounts. Full spectrum CBD in topical form does not produce a positive drug test under standard testing protocols. If you have specific concerns about testing for a competition or employer, consult your testing authority directly."
      }
    },
    {
      "@type": "Question",
      "name": "Does it taste like anything?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Does it taste like anything? +Barely. At the recommended dose you'll notice a very slight saltiness that's it. No sweetness, no bitterness, no chemical aftertaste. It won't change the taste of your coffee, water, or shake. This is the biggest feedback we get from people who've switched from LMNT or Liquid IV those products have a strong, sweet flavor that dominates your drink. Electro+ doesn't."
      }
    },
    {
      "@type": "Question",
      "name": "Will Perform+ get me banned from sport?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. β-Ecdysterone is not on the WADA prohibited list and is not banned by USADA, UFC, or any major sports organization. WADA added it to their monitoring list in 2021 but monitoring is distinct from prohibited. Athletes are only sanctioned for substances on the prohibited list. Every batch of Perform+ is 3rd party tested to confirm zero contamination with banned substances."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use all three products together?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes , they're designed to complement each other. Max Relief is a topical targeting pain and inflammation at the tissue level. Electro+ is an oral mineral supplement supporting cellular hydration and recovery. Perform+ is an oral ecdysterone capsule supporting muscle protein synthesis. Three different systems, zero overlap, no interaction between them."
      }
    },
    {
      "@type": "Question",
      "name": "How long does shipping take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Orders are processed within 1–3 business days. Standard shipping (free over $75) takes 3–7 business days. Expedited shipping (2–3 business days) is $12.99. Overnight shipping is $24.99 for orders placed before 12pm EST. You'll receive a tracking number via email once your order ships."
      }
    },
    {
      "@type": "Question",
      "name": "What's your return policy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "30-day satisfaction guarantee on all products. If you're not satisfied for any reason within 30 days of delivery, email with your order number and we'll issue a full refund to your original payment method. You don't need to return the product. No questions asked we mean that."
      }
    }
  ]
}
</script>

{%endif %}


{% if  page.handle == 'partner' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is there a minimum follower count for affiliate partners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. We care about authentic fit, not follower count. A BJJ coach with 2,000 highly engaged followers in the right community is worth more to us than 50,000 generic fitness followers. Apply and tell us about your audience we'll evaluate fit honestly."
      }
    },
    {
      "@type": "Question",
      "name": "What's the minimum wholesale order?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Opening orders start at 24 units minimum, mix and match products. Reorders can be smaller once an account is established. We'll discuss specific terms during the application process based on your location and expected volume."
      }
    },
    {
      "@type": "Question",
      "name": "How does affiliate tracking and payment work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You'll receive a unique tracking link and a personal discount code from day one. Commission tiers are calculated on your total monthly referred sales 15% up to $499, 20% from $500–$1,999, and 25% at $2,000 and above. Tiers reset monthly. You'll have access to a real-time dashboard showing clicks, conversions, and earnings. We pay monthly via direct bank transfer or PayPal with no minimum payout threshold."
      }
    },
    {
      "@type": "Question",
      "name": "How does athlete sponsorship work at this stage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We're honest about where we are as a brand. Right now sponsorship means product supply every month the full PHASIS stack plus a 20% affiliate commission that scales to 25% on top of that. No cash deals yet, but that changes as the brand grows and we'll reward the athletes who were with us early. What we ask for in return is authentic representation, use the product, post about it honestly, tag us at competitions. No scripts, no forced content. If you're someone who'd use this anyway, it's a natural fit."
      }
    },
    {
      "@type": "Question",
      "name": "How does Brand Collaboration work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Brand Collaboration isn't an open program, we take on a small number of partnerships each year with gyms, academies, and organizations that are a genuine fit for what PHASIS is building. If you think that's you, tell us who your community is, what you do, and why PHASIS belongs in it. We'll take it from there."
      }
    },
    {
      "@type": "Question",
      "name": "Can I stock only one product or do I need to carry all three?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can start with any single product. Many wholesale partners begin with Max Relief because it's the most universal, it works for everyone in pain regardless of training background. We don't require you to carry the full line, though most partners do once they see the sell-through rates."
      }
    }
  ]
}
</script>
{%endif %}



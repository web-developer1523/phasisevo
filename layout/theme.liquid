<!doctype html>
<html
  class="no-js"
  data-scheme="{{ settings.color_scheme }}"
  lang="{{ request.locale.iso_code }}"
  dir="{% render 'direction' %}"
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  
    <!-- Open Graph / Social Meta for Quiz Page -->
    {% if template == 'page' and page.handle == 'quiz' %}
      <meta property="og:title" content="What Supplements Should I Take? Free Quiz — PHASIS">
      <meta
        property="og:description"
        content="Answer a few questions about your goals and get a personalised wellness protocol. Free. Takes a few minutes."
      >

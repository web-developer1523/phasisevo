    {% if page.handle == 'faq' %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "How do I place an order?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Browse our products on the Shop page, select your size or quantity, and click Add to Cart. Proceed to checkout to enter your shipping information and payment details. You'll receive an order confirmation email immediately after purchase."
              }
            },
            {
              "@type": "Question",
              "name": "Will the CBD show up on a drug test?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. Max Relief is a topical it doesn't enter the bloodstream in meaningful amounts. Full spectrum CBD in topical form does not produce a positive drug test under standard testing protocols. If you have specific concerns about testing for a competition or employer, consult your testing authority directly."
              }
            },
            {
              "@type": "Question",
              "name": "Does it taste like anything?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Does it taste like anything? +Barely. At the recommended dose you'll notice a very slight saltiness that's it. No sweetness, no bitterness, no chemical aftertaste. It won't change the taste of your coffee, water, or shake. This is the biggest feedback we get from people who've switched from LMNT or Liquid IV those products have a strong, sweet flavor that dominates your drink. Electro+ doesn't."
              }
            },
            {
              "@type": "Question",
              "name": "Will Perform+ get me banned from sport?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. β-Ecdysterone is not on the WADA prohibited list and is not banned by USADA, UFC, or any major sports organization. WADA added it to their monitoring list in 2021 but monitoring is distinct from prohibited. Athletes are only sanctioned for substances on the prohibited list. Every batch of Perform+ is 3rd party tested to confirm zero contamination with banned substances."
              }
            },
            {
              "@type": "Question",
              "name": "Can I use all three products together?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes , they're designed to complement each other. Max Relief is a topical targeting pain and inflammation at the tissue level. Electro+ is an oral mineral supplement supporting cellular hydration and recovery. Perform+ is an oral ecdysterone capsule supporting muscle protein synthesis. Three different systems, zero overlap, no interaction between them."
              }
            },
            {
              "@type": "Question",
              "name": "How long does shipping take?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Orders are processed within 1–3 business days. Standard shipping (free over $75) takes 3–7 business days. Expedited shipping (2–3 business days) is $12.99. Overnight shipping is $24.99 for orders placed before 12pm EST. You'll receive a tracking number via email once your order ships."
              }
            },
            {
              "@type": "Question",
              "name": "What's your return policy?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "30-day satisfaction guarantee on all products. If you're not satisfied for any reason within 30 days of delivery, email with your order number and we'll issue a full refund to your original payment method. You don't need to return the product. No questions asked we mean that."
              }
            }
          ]
        }
      </script>

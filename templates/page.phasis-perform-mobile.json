      "type": "mobile-faq-section",
      "blocks": {
        "faq_AhLned": {
          "type": "faq",
          "settings": {
            "open_default": true,
            "question": "Will this get me banned from competition?",
            "answer": "No. β-Ecdysterone is not on the WADA prohibited list and is not banned by USADA, UFC, or any major sports organization. WADA added it to their monitoring list in 2021 — but that is distinct from the prohibited list. Every batch of Perform+ is 3rd party tested to confirm zero contamination with banned substances."
          }
        },
        "faq_iRJbch": {
          "type": "faq",
          "settings": {
            "open_default": false,
            "question": "How long before I see results?",
            "answer": "The primary study ran 10 weeks and found up to +2kg lean muscle and significant strength improvements. Most users report noticeably faster recovery within 2 weeks, and visible strength improvements by weeks 4–6. The full anabolic effect builds over the study timeline — which is why the 60-cap option is the recommended first order."
          }
        },
        "faq_wKUN3K": {
          "type": "faq",
          "settings": {
            "open_default": false,
            "question": "Do I need to cycle it or do PCT?",
            "answer": "No. Because β-Ecdysterone is non-hormonal — it doesn't suppress your body's natural testosterone production or affect your endocrine system — there's no hormonal rebound to manage. Take it continuously or stop whenever you choose without side effects."
          }
        },
        "faq_EdPFFa": {
          "type": "faq",
          "settings": {
            "open_default": false,
            "question": "Is it safe for women?",
            "answer": "Yes — and female athletes may benefit more from Perform+ than most supplements because it's completely non-hormonal. No testosterone increase, no masculinizing effects, no hair loss, no acne, no voice changes, no menstrual disruption. The muscle protein synthesis pathway it activates works identically regardless of biological sex. Zero gender-specific side effects."
          }
        },
        "faq_f8yRmt": {
          "type": "faq",
          "settings": {
            "open_default": false,
            "question": "How does this compare to peptides or SARMs?",
            "answer": "Completely different category. Peptides and SARMs require injections, grey-market sourcing, and carry legal risk in competitive sports. Most peptide research in humans is limited. Ecdysterone has more published human research than most peptides being discussed in performance communities. Our position: if you haven't maxed out what a legal, oral, clinically-studied compound can do — try that first."
          }
        },
        "faq_XyRJq9": {
          "type": "faq",
          "settings": {
            "open_default": false,
            "question": "Why 60 caps over 30?",
            "answer": "The WADA study ran 10 weeks. A 30-cap bottle gives you 30 days. The 60-cap option covers 60 days, aligns with the research timeline, and saves you $13 vs two separate purchases ($98 vs $85). If you want to match the study conditions where +2kg lean muscle was achieved — give it the time the research used."
          }
        }

    "faq": {
      "type": "phasis-electro-faq",
      "blocks": {
        "faq_item_tUErTY": {
          "type": "faq_item",
          "settings": {
            "question": "Does it taste like anything?",
            "answer": "Barely. At the recommended dose you will notice a very slight saltiness at the back of your palate. That is it. It will not change the taste of your coffee, water, or shake. No sweetness, no bitterness, no chemical aftertaste — just a trace of the natural mineral profile."
          }
        },
        "faq_item_Pqr8Tf": {
          "type": "faq_item",
          "settings": {
            "question": "How is this different from LMNT or Liquid IV?",
            "answer": "Three big differences. First, price — LMNT is about $1.50 per packet. Electro+ is $0.50 per serving on the 4oz — about 75% less. Second, format — LMNT and Liquid IV are powder packets. Electro+ is a liquid dropper — 20 drops into anything in seconds, no mess, adjustable dose. Third, mineral spectrum — LMNT has 4 electrolytes. Electro+ delivers 50+. More minerals, better format, fraction of the cost."
          }
        },
        "faq_item_xiK8AT": {
          "type": "faq_item",
          "settings": {
            "question": "How much should I take?",
            "answer": "It depends on your activity level. Daily hydration — 20 drops (1mL) into 16oz of water. Hard training — 40 to 60 drops (2 to 3mL) into a 2L bottle. Endurance or extreme sweat days — up to 100 drops (5mL) per gallon throughout the day. The 4oz bottle comes with a graduated dropper marked at 1mL so there is no counting required. Because there are no sweeteners, you can scale up freely without it tasting overwhelming."
          }
        },
        "faq_item_zcWHWd": {
          "type": "faq_item",
          "settings": {
            "question": "Is the 4oz worth it vs the 1oz?",
            "answer": "The math is straightforward. The 4oz is $45 for 120 servings — $0.38 per serving. LMNT is roughly $1.50 per packet. For 120 servings of LMNT you would pay $180. If you plan to use it daily, the 4oz is the obvious value. If you have never tried it, start with the 1oz. The 30-day guarantee means you risk nothing."
          }
        },
        "faq_item_QwAhjU": {
          "type": "faq_item",
          "settings": {
            "question": "Can I stack this with Max Relief?",
            "answer": "Yes — and we recommend it. Max Relief handles topical pain and inflammation at the tissue level. Electro+ handles internal mineral replenishment. They work on completely different systems with no interaction."
          }
        }
      },

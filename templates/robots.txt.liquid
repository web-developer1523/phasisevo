# ================================================================
# PHASIS-SPECIFIC RULES — GSC + Semrush error cleanup
# ================================================================

# ── JUNK URL PARAMETERS (GSC: Discovered/indexed junk URLs) ──
# ?kg= parameter is generating crawlable junk URLs.
# Source: likely a third-party widget/app. Block all forms.
Disallow: /*?kg=*
Disallow: /*?*&kg=*
Disallow: /*?*kg%3D*

# ── VARIANT PARAMETER URLS (Duplicate content) ──
# ?variant= creates thin duplicate pages per product variant.
# Canonical product content lives on /products/[slug] and /pages/[product].
Disallow: /*?*variant=*

# ── THEME / VIEW PARAMETER URLS ──
# ?view= switches templates and can expose unfinished pages.
Disallow: /*?*view=*

# ── EMPTY DEFAULT COLLECTION (Thin page, Semrush: Low word count) ──
# /collections/frontpage = Shopify auto-created default. No products, no content.
Disallow: /collections/frontpage
Disallow: /*/collections/frontpage

# ── SEARCH PAGE (Ghost page — Semrush: Duplicate title + meta) ──
# Title "Search" is Shopify default. Meta pulls homepage description.
# noindex,follow meta also added to theme for belt-and-suspenders.
Disallow: /search

# ── DUPLICATE PRIVACY POLICY (Semrush: Duplicate content) ──
# /pages/privacy-policy duplicates /pages/privacy-policy-1.
# Also in sitemap (error). Pending 301 redirect in Shopify admin.
# REMOVE this rule once redirect → /pages/privacy-policy-1 is live.
Disallow: /pages/privacy-policy

# ── KNOWN 404 ORPHAN PAGES (Semrush: 4xx errors, crawl waste) ──
# These return 404 and have no redirect yet. Temp block saves crawl budget.
# REMOVE each rule once the corresponding 301 is set in Shopify admin:
#   /products/max-relief-balm      → /products/max-relief
#   /products/relief-balm          → /products/relief
#   /pages/phasis-policies.html    → /pages/privacy-policy-1
#   /pages/phasis-shop-mobile.html → /pages/phasis-shop
Disallow: /products/max-relief-balm
Disallow: /products/relief-balm
Disallow: /pages/phasis-policies.html
Disallow: /pages/phasis-shop-mobile.html

# ── NOTE: /blogs/articles (Duplicate of /pages/journal) ──
# Cannot block /blogs/articles via robots.txt without also blocking
# all 4 article pages under it (/blogs/articles/[slug]). 
# Fix is meta-only: add noindex to the blog index template.


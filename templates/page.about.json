    "standards_section_QiKcjf": {
      "type": "standards-section",
      "blocks": {
        "standard_HcApyn": {
          "type": "standard",
          "settings": {
            "title": "Clinical Dose or Above",
            "desc": "<p>We don't pixie-dust. Every active ingredient is at or above the dose shown to produce results in published human research. Perform+ delivers 25% above the WADA study dose.</p>"
          }
        },
        "standard_c9QiVc": {
          "type": "standard",
          "settings": {
            "title": "Third-Party Tested",
            "desc": "<p>Every batch of every product is independently tested for purity, potency, and label accuracy before it ships. Certificate of Analysis available on request for every order.</p>"
          }
        },
        "standard_yFjqP8": {
          "type": "standard",
          "settings": {
            "title": "Transparent Labels",
            "desc": "<p>No proprietary blends. Every ingredient, every dose, visible on the label. If we can't tell you exactly what's in it and why, we don't put it in.</p>"
          }
        },
        "standard_7imKVt": {
          "type": "standard",
          "settings": {
            "title": "Peer-Reviewed Foundations",
            "desc": "<p>Every formula is built around human clinical research — not animal studies, not in-vitro data, not social media trends. We cite the studies. You can read them.</p>"
          }
        },
        "standard_qEfjHK": {
          "type": "standard",
          "settings": {
            "title": "No Banned Substances",
            "desc": "<p>Every product is safe for competitive athletes at every level — USADA-tested, UFC-competing, or amateur. Tested for contamination. Confirmed clean.</p>"
          }
        },
        "standard_bwfyLk": {
          "type": "standard",
          "settings": {
            "title": "Fair Pricing",
            "desc": "<p>Premium ingredients don't require premium gouging. We price for accessibility — because a formula this good should be something people can actually afford to use every day.</p>"
          }
        }
      },

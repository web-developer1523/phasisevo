    "about_hero_j4CGjp": {
      "type": "about-hero",
      "name": "About Hero",
      "settings": {
        "custom_css_class": "cst-about-sec",
        "eyebrow": "Our Story · Our Standards · Our Products",
        "heading_line1": "PHASIS is a simple",
        "heading_line2": "truth built into",
        "heading_em": "three products.",
        "subtext": "Humans are <strong>made to evolve.</strong> The supplements industry mostly makes products for people who want shortcuts. We built PHASIS for people who don't need shortcuts — they need better tools.",
        "tagline": "MADE TO EVOLVE.",
        "tagline_sub": "PHASIS brand mantra · est. 2025"
      }
    },
    "manifesto_section_FNHcfh": {
      "type": "manifesto-section",
      "blocks": {
        "paragraph_wxfFQQ": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Most supplement brands start with a margin target and work backwards to the formula. They find the cheapest version of an ingredient that lets them print a claim on the label. They dress it up in aggressive branding. They spend more on the ad than the product inside the bottle.</p>"
          }
        },
        "paragraph_MYEXUP": {
          "type": "paragraph",
          "settings": {
            "text": "<p>That's why Max Relief has <strong>pharmaceutical-grade Lidocaine HCl</strong> — not just menthol. That's why Electro+ has <strong>50+ trace minerals with zero sugar</strong> — not a powder packet with 34g of sugar and three electrolytes. That's why Perform+ delivers <strong>250mg of verified ecdysterone</strong> per capsule — 25% above the dose used in the WADA-funded study that made researchers recommend banning it.</p>"
          }
        },
        "paragraph_jPeKLM": {
          "type": "paragraph",
          "settings": {
            "text": "<p>We don't make products for everyone. We make them for people who train hard, think critically about what goes in their body, and are <em><strong>done being sold things that don't actually work.</strong></em></p>"
          }
        }
      },
      "block_order": [
        "paragraph_wxfFQQ",
        "paragraph_MYEXUP",
        "paragraph_jPeKLM"
      ],
      "name": "Manifesto Section",
      "settings": {
        "custom_css_class": "cst-manifest-sec",
        "eyebrow": "The PHASIS Manifesto",
        "heading_line1": "We Refuse to Make",
        "heading_em": "Products That Underperform.",
        "pull_quote": "PHASIS starts with the <em>science</em> — the peer-reviewed research, the mechanism, the dose that actually produced results. Then we build backwards to a product that delivers it."
      }
    },
    "problem_section_TCh9CU": {
      "type": "problem-section",
      "blocks": {
        "problem_LGtYCA": {
          "type": "problem",
          "settings": {
            "icon": "⚗️",
            "title": "Underdosing",
            "desc": "Independent testing found many ecdysterone supplements contain less than 0.1% of the dose claimed on the label. This isn't rare — it's the norm across most supplement categories."
          }
        },
        "problem_QLprwU": {
          "type": "problem",
          "settings": {
            "icon": "🧪",
            "title": "No Third-Party Testing",
            "desc": "Most brands test nothing. They trust their supplier's certificate and print whatever the COA says on the label. We test every batch independently — with results available to every customer."
          }
        },
        "problem_rXgzHQ": {
          "type": "problem",
          "settings": {
            "icon": "📊",
            "title": "Junk Science",
            "desc": "Ingredients go viral on social media. Brands rush to put them in products before the research is established. We only formulate around peer-reviewed, human clinical research — not trends."
          }
        },
        "problem_6XpbRT": {
          "type": "problem",
          "settings": {
            "icon": "💰",
            "title": "Price Gouging",
            "desc": "Brands overcharge for basic formulations. Quality doesn't have to mean expensive — it means honest."
          }

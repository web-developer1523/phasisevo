        "value_gM9Bdt": {
          "type": "value",
          "settings": {
            "title": "Refuse to Stay the Same",
            "description": "Evolution is the point. We're not building a supplement brand — we're building a performance system for people who take their physical development seriously. Every product we release moves that mission forward."
          }
        }
      },

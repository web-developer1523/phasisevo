          "settings": {
            "question": "How fast does it work?",
            "answer": "Most users feel the cooling and nerve block effect within 5–10 minutes. The anti-inflammatory benefits build over 20–30 minutes. With repeated use the capsaicin component desensitizes pain receptors — it becomes more effective over time."
          }
        },
        "faq_qJ83Pz": {
          "type": "faq",
          "settings": {
            "question": "What makes this different from Voltaren or IcyHot?",
            "answer": "Voltaren is anti-inflammatory only. IcyHot is counterirritant only. Neither has a nerve block, neither has CBD. Relief combines full spectrum CBD with 13 natural botanicals for gentle, plant-based relief."
          }
        },
        "faq_q9nqey": {
          "type": "faq",
          "settings": {
            "question": "Is it safe for daily use?",
            "answer": "Yes. Relief is specifically formulated for daily use. The natural plant oilsine HCl is at OTC-safe concentrations. The CBD is non-intoxicating and topical. We recommend applying to the affected area 2–3 times daily or as needed."

    "phasis_electro_faq_zTrMJ4": {
      "type": "phasis-electro-faq",
      "blocks": {
        "faq_item_BcVAnr": {
          "type": "faq_item",
          "settings": {
            "question": "Will the CBD show up on a drug test?",
            "answer": "No. Max Relief is a topical — it does not enter the bloodstream in meaningful amounts. Full spectrum CBD in topical form does not produce a positive drug test under standard testing protocols."
          }
        },
        "faq_item_LNGgqD": {
          "type": "faq_item",
          "settings": {
            "question": "How fast does it work?",
            "answer": "Most users feel the cooling and nerve block effect within 5–10 minutes. The anti-inflammatory benefits build over 20–30 minutes. With repeated use the capsaicin component desensitizes pain receptors — it becomes more effective over time."
          }
        },
        "faq_item_Gka37Y": {
          "type": "faq_item",
          "settings": {
            "question": "What makes this different from Voltaren or IcyHot?",
            "answer": "Voltaren is anti-inflammatory only. IcyHot is counterirritant only. Neither has a nerve block, neither has CBD. Max Relief combines all four mechanisms: nerve block (Lidocaine), counterirritant (Menthol + Capsaicin), anti-inflammatory (CBD + Arnica + Turmeric), and circulation (Clary Sage)."
          }
        },
        "faq_item_NVeTaW": {
          "type": "faq_item",
          "settings": {
            "question": "Is it safe for daily use?",
            "answer": "Yes. Max Relief is formulated for daily use. The Lidocaine HCl is at OTC-safe concentrations. The CBD is non-intoxicating and topical. We recommend applying to the affected area 2–3 times daily or as needed."
          }
        },
        "faq_item_WgabwB": {
          "type": "faq_item",
          "settings": {
            "question": "Jar or Stick — which should I get?",
            "answer": "The Stick is great for targeted application — precise, no mess, on-the-go. The Jar gives you more product for larger areas like lower back, quads, or shoulders. For daily use on a larger area, the Jar is the better value."
          }
        },
        "faq_item_PM8mQU": {
          "type": "faq_item",
          "settings": {
            "question": "What's your return policy?",
            "answer": "30-day satisfaction guarantee. If Max Relief doesn't work for you, contact us within 30 days for a full refund — no questions asked."
          }
        }
      },
